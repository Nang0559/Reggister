@using FVN_REGISTER.Shared.Services.Users
@using FVN_REGISTER.Core.Constants
@using FVN_REGISTER.Shared.Utils
@using MudBlazor
@inject ICurrentUserClientService CurrentUser

<MudNavMenu>
    <MudText Typo="Typo.subtitle2" Color="Color.Primary" Class="ml-4 my-3">DASHBOARD</MudText>
    <MudNavLink href="/" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Home">Trang chủ</MudNavLink>

    @if (CurrentUser.PermissionCode.IsApprover())
    {
        <MudNavGroup Title="Phê duyệt" Icon="@Icons.Material.Filled.CheckCircle" Expanded="false">
            <MudNavLink href="/approvals" Icon="@Icons.Material.Filled.List">Danh sách chờ duyệt</MudNavLink>
        </MudNavGroup>
    }

    @if (CurrentUser.PermissionCode.CanRequestLeave())
    {
        <MudNavGroup Title="Nghỉ phép" Icon="@Icons.Material.Filled.EventBusy" Expanded="true">
            <MudNavLink href="/leave/create" Icon="@Icons.Material.Filled.Add">Tạo đơn mới</MudNavLink>
            <MudNavLink href="/leave/history" Icon="@Icons.Material.Filled.History">Lịch sử nghỉ phép</MudNavLink>
        </MudNavGroup>
    }

    @if (CurrentUser.PermissionCode.CanRequestLeave())
    {
        <MudNavGroup Title="Làm thêm giờ (OT)" Icon="@Icons.Material.Filled.AccessTime" Expanded="false">
            <MudNavLink href="/ot/create" Icon="@Icons.Material.Filled.AddAlarm">Đăng ký OT</MudNavLink>
            <MudNavLink href="/ot/history" Icon="@Icons.Material.Filled.ManageHistory">Lịch sử OT</MudNavLink>
        </MudNavGroup>
    }

    @if (CurrentUser.PermissionCode.CanRequestLeave())
    {
        <MudNavGroup Title="Công tác" Icon="@Icons.Material.Filled.FlightTakeoff" Expanded="false">
            <MudNavLink href="/trip/create" Icon="@Icons.Material.Filled.Add">Đăng ký công tác</MudNavLink>
            <MudNavLink href="/trip/history" Icon="@Icons.Material.Filled.History">Lịch sử công tác</MudNavLink>
        </MudNavGroup>
    }

    @if (CurrentUser.PermissionCode.CanManageData())
    {
        <MudNavGroup Title="Dữ liệu" Icon="@Icons.Material.Filled.Storage" Expanded="false">
            <MudNavLink href="/admin/departments" Icon="@Icons.Material.Filled.Business">Bộ phận</MudNavLink>
            <MudNavLink href="/admin/employees" Icon="@Icons.Material.Filled.People">Nhân viên</MudNavLink>
            <MudNavLink href="/admin/approvers" Icon="@Icons.Material.Filled.VerifiedUser">Approver</MudNavLink>
            <MudNavLink href="/admin/leave-types" Icon="@Icons.Material.Filled.Category">Hình thức nghỉ</MudNavLink>
        </MudNavGroup>

        <MudNavGroup Title="Quản lý OT" Icon="@Icons.Material.Filled.Timelapse" Expanded="false">
            <MudNavLink href="/ot/list" Icon="@Icons.Material.Filled.FormatListBulleted">Danh sách đơn OT</MudNavLink>
            <MudNavLink href="/admin/ot-sync" Icon="@Icons.Material.Filled.Sync">Đồng bộ chấm công OT</MudNavLink>
        </MudNavGroup>
    }

    @if (CurrentUser.PermissionCode.IsApprover())
    {
        <MudNavGroup Title="Báo cáo" Icon="@Icons.Material.Filled.Assessment" Expanded="false">
            <MudNavLink href="/report/leave" Icon="@Icons.Material.Filled.BeachAccess">Báo cáo nghỉ phép</MudNavLink>
            <MudNavLink href="/report/ot" Icon="@Icons.Material.Filled.MoreTime">Báo cáo làm thêm giờ</MudNavLink>
        </MudNavGroup>
    }

    @if (CurrentUser.PermissionCode.IsSuperAdmin())
    {
        <MudNavGroup Title="Hệ thống" Icon="@Icons.Material.Filled.Settings" Expanded="false">
            <MudNavLink href="/admin/managers" Icon="@Icons.Material.Filled.AdminPanelSettings">Quản trị viên</MudNavLink>
            <MudNavLink href="/admin/email-templates" Icon="@Icons.Material.Filled.Email">Email mẫu</MudNavLink>
            <MudNavLink href="/admin/email-queue" Icon="@Icons.Material.Filled.MarkEmailRead">Email chờ gửi</MudNavLink>
        </MudNavGroup>
    }
</MudNavMenu>