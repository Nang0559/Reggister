@using FVN_REGISTER.Shared.Services.Users
@using FVN_REGISTER.Shared.Utils
@using FVN_REGISTER.Contract.Dtos.Security
@using FVN_REGISTER.Shared.Services.Security
@using FVN_REGISTER.Core.Constants
@inject ISecurityClientService SecurityService
@using MudBlazor
@inject ICurrentUserClientService CurrentUser

<MudNavMenu>
    <MudText Typo="Typo.subtitle2" Color="Color.Primary" Class="ml-4 my-3">DASHBOARD</MudText>
    <MudNavLink href="/" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Home">Trang chủ</MudNavLink>
    <MudNavLink href="/execution" Icon="@Icons.Material.Filled.FactCheck">Đối soát thực tế</MudNavLink>
    <MudNavLink href="/work/inbox" Icon="@Icons.Material.Filled.Inbox">Trung tâm công việc</MudNavLink>

    @if (CanAny(SecurityFunctionCodes.LeaveApprove, SecurityFunctionCodes.OTApprove, SecurityFunctionCodes.TripApprove, SecurityFunctionCodes.EquipmentApprove))
    {
        <MudNavGroup Title="Phê duyệt" Icon="@Icons.Material.Filled.CheckCircle" Expanded="false">
            <MudNavLink href="/approvals" Icon="@Icons.Material.Filled.List">Danh sách chờ duyệt</MudNavLink>
        </MudNavGroup>
    }

    @if (Can(SecurityFunctionCodes.LeaveCreate))
    {
        <MudNavGroup Title="Nghỉ phép" Icon="@Icons.Material.Filled.EventBusy" Expanded="true">
            <MudNavLink href="/leave/create" Icon="@Icons.Material.Filled.Add">Tạo đơn mới</MudNavLink>
            <MudNavLink href="/leave/history" Icon="@Icons.Material.Filled.History">Lịch sử nghỉ phép</MudNavLink>
        </MudNavGroup>
    }

    @if (Can(SecurityFunctionCodes.OTCreate))
    {
        <MudNavGroup Title="Làm thêm giờ (OT)" Icon="@Icons.Material.Filled.AccessTime" Expanded="false">
            <MudNavLink href="/ot/create" Icon="@Icons.Material.Filled.AddAlarm">Đăng ký OT</MudNavLink>
            <MudNavLink href="/ot/history" Icon="@Icons.Material.Filled.ManageHistory">Lịch sử OT</MudNavLink>
        </MudNavGroup>
    }

    @if (Can(SecurityFunctionCodes.TripCreate))
    {
        <MudNavGroup Title="Công tác" Icon="@Icons.Material.Filled.FlightTakeoff" Expanded="false">
            <MudNavLink href="/trip/create" Icon="@Icons.Material.Filled.Add">Đăng ký công tác</MudNavLink>
            <MudNavLink href="/trip/history" Icon="@Icons.Material.Filled.History">Lịch sử công tác</MudNavLink>
        </MudNavGroup>
    }

    @if (CanAny(SecurityFunctionCodes.HrmSyncViewStatus, SecurityFunctionCodes.UserManagementView))
    {
        <MudNavGroup Title="Dữ liệu" Icon="@Icons.Material.Filled.Storage" Expanded="false">
            <MudNavLink href="/admin/departments" Icon="@Icons.Material.Filled.Business">Bộ phận</MudNavLink>
            <MudNavLink href="/admin/employees" Icon="@Icons.Material.Filled.People">Nhân viên</MudNavLink>
            <MudNavLink href="/admin/approvers" Icon="@Icons.Material.Filled.VerifiedUser">Approver</MudNavLink>
            <MudNavLink href="/admin/leave-types" Icon="@Icons.Material.Filled.Category">Hình thức nghỉ</MudNavLink>
            <MudNavLink href="/admin/hrm-sync" Icon="@Icons.Material.Filled.Sync">Đồng bộ HRM</MudNavLink>
            <MudNavLink href="/admin/hrm-sync-review" Icon="@Icons.Material.Filled.WarningAmber">Conflict HRM</MudNavLink>
            <MudNavLink href="/admin/hrm-role-rules" Icon="@Icons.Material.Filled.Rule">Role HRM → User</MudNavLink>
            <MudNavLink href="/admin/approval-policies" Icon="@Icons.Material.Filled.Policy">Approval Policy</MudNavLink>
            @if (Can(SecurityFunctionCodes.AttendanceView))
            {
                <MudNavLink href="/hrm/attendance-calculation" Icon="@Icons.Material.Filled.AccessTime">Tính giờ theo HRM</MudNavLink>
            }
        </MudNavGroup>

        <MudNavGroup Title="Quản lý OT" Icon="@Icons.Material.Filled.Timelapse" Expanded="false">
            <MudNavLink href="/ot/list" Icon="@Icons.Material.Filled.FormatListBulleted">Danh sách đơn OT</MudNavLink>
            @if (Can(SecurityFunctionCodes.OTEdit))
            {
                <MudNavLink href="/admin/ot-limit-rules" Icon="@Icons.Material.Filled.Rule">Hạn mức OT</MudNavLink>
            }
        </MudNavGroup>
    }

    @if (Can(SecurityFunctionCodes.PayrollView))
    {
        <MudNavGroup Title="Tính lương" Icon="@Icons.Material.Filled.Payments" Expanded="false">
            <MudNavLink href="/payroll/table" Icon="@Icons.Material.Filled.TableView">Bảng công tính lương</MudNavLink>
        </MudNavGroup>
    }

    @if (CanAny(SecurityFunctionCodes.LeaveView, SecurityFunctionCodes.OTView, SecurityFunctionCodes.TripView, SecurityFunctionCodes.EquipmentView, SecurityFunctionCodes.AttendanceView))
    {
        <MudNavGroup Title="Báo cáo & thống kê" Icon="@Icons.Material.Filled.Assessment" Expanded="false">
            <MudNavLink href="/reports" Icon="@Icons.Material.Filled.Dashboard">Trung tâm báo cáo</MudNavLink>
            @if (Can(SecurityFunctionCodes.LeaveView))
            {
                <MudNavLink href="/report/leave" Icon="@Icons.Material.Filled.BeachAccess">Nghỉ phép</MudNavLink>
            }
            @if (Can(SecurityFunctionCodes.OTView))
            {
                <MudNavLink href="/report/ot" Icon="@Icons.Material.Filled.MoreTime">OT</MudNavLink>
            }
            @if (Can(SecurityFunctionCodes.TripView))
            {
                <MudNavLink href="/report/operations?module=trip" Icon="@Icons.Material.Filled.FlightTakeoff">Công tác</MudNavLink>
            }
            @if (Can(SecurityFunctionCodes.EquipmentView))
            {
                <MudNavLink href="/report/operations?module=equipment" Icon="@Icons.Material.Filled.Devices">Thiết bị</MudNavLink>
            }
            @if (Can(SecurityFunctionCodes.AttendanceView))
            {
                <MudNavLink href="/report/operations?module=attendance" Icon="@Icons.Material.Filled.AccessTime">Chấm công</MudNavLink>
            }
        </MudNavGroup>
    }

    @if (Can(SecurityFunctionCodes.UserManagementView))
    {
        <MudNavGroup Title="Hệ thống" Icon="@Icons.Material.Filled.Settings" Expanded="false">
            <MudNavLink href="/admin/managers" Icon="@Icons.Material.Filled.AdminPanelSettings">Quản trị viên</MudNavLink>
            @if (Can(SecurityFunctionCodes.SecurityView))
            {
                <MudNavLink href="/admin/security" Icon="@Icons.Material.Filled.Security">Security Center</MudNavLink>
                <MudNavLink href="/admin/sessions" Icon="@Icons.Material.Filled.Devices">Thiết bị & phiên đăng nhập</MudNavLink>
            }
            <MudNavLink href="/admin/email-templates" Icon="@Icons.Material.Filled.Email">Email mẫu</MudNavLink>
            <MudNavLink href="/admin/email-queue" Icon="@Icons.Material.Filled.MarkEmailRead">Email chờ gửi</MudNavLink>
            @if (Can(SecurityFunctionCodes.SecurityView))
            {
                <MudNavLink href="/admin/work-calendar" Icon="@Icons.Material.Filled.CalendarMonth">Năm & ngày nghỉ</MudNavLink>
            }
        </MudNavGroup>
    }
</MudNavMenu>

@code {
    private PermissionSnapshotDto? _permissions;

    protected override async Task OnInitializedAsync()
    {
        var result = await SecurityService.GetMyPermissionsAsync();
        if (result.IsSuccess)
            _permissions = result.Data;
    }

    private bool Can(int functionCode) => _permissions?.Has(functionCode) == true;

    private bool CanAny(params int[] functionCodes)
        => functionCodes.Any(Can);
}
