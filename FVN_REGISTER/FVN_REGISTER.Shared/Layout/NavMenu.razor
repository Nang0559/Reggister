@implements IDisposable
@using FVN_REGISTER.Shared.Services.Users
@using FVN_REGISTER.Shared.Utils
@using FVN_REGISTER.Contract.Dtos.Security
@using FVN_REGISTER.Shared.Services.Security
@using FVN_REGISTER.Core.Constants
@inject ISecurityClientService SecurityService
@inject ICurrentUserClientService CurrentUser

<MudNavMenu>
    <MudText Typo="Typo.subtitle2" Color="Color.Primary" Class="ml-4 my-3">@Language.T("app.name")</MudText>
    <MudNavLink href="/" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Home">@Language.T("nav.home")</MudNavLink>
    <MudNavLink href="/calendar" Icon="@Icons.Material.Filled.CalendarMonth">@Language.T("nav.calendar")</MudNavLink>

    @if (CanAny(SecurityFunctionCodes.LeaveApprove, SecurityFunctionCodes.OTApprove, SecurityFunctionCodes.TripApprove, SecurityFunctionCodes.EquipmentApprove))
    {
        <MudNavGroup Title="@Language.T("nav.approvals")" Icon="@Icons.Material.Filled.CheckCircle" Expanded="false">
            <MudNavLink href="/approvals" Icon="@Icons.Material.Filled.List">@Language.T("nav.pendingApproval")</MudNavLink>
        </MudNavGroup>
    }

    @if (Can(SecurityFunctionCodes.LeaveCreate))
    {
        <MudNavGroup Title="@Language.T("nav.leave")" Icon="@Icons.Material.Filled.EventBusy" Expanded="true">
            <MudNavLink href="/leave/create" Icon="@Icons.Material.Filled.Add">@Language.T("nav.create")</MudNavLink>
            <MudNavLink href="/leave/history" Icon="@Icons.Material.Filled.History">@Language.T("nav.history") @Language.T("nav.leave")</MudNavLink>
        </MudNavGroup>
    }

    @if (Can(SecurityFunctionCodes.OTCreate))
    {
        <MudNavGroup Title="@Language.T("nav.overtime")" Icon="@Icons.Material.Filled.AccessTime" Expanded="false">
            <MudNavLink href="/ot/create" Icon="@Icons.Material.Filled.AddAlarm">@Language.T("nav.create") @Language.T("nav.overtime")</MudNavLink>
            <MudNavLink href="/ot/history" Icon="@Icons.Material.Filled.ManageHistory">@Language.T("nav.history") @Language.T("nav.overtime")</MudNavLink>
        </MudNavGroup>
    }

    @if (Can(SecurityFunctionCodes.TripCreate))
    {
        <MudNavGroup Title="@Language.T("nav.trip")" Icon="@Icons.Material.Filled.FlightTakeoff" Expanded="false">
            <MudNavLink href="/trip/create" Icon="@Icons.Material.Filled.Add">@Language.T("nav.create") @Language.T("nav.trip")</MudNavLink>
            <MudNavLink href="/trip/history" Icon="@Icons.Material.Filled.History">@Language.T("nav.history") @Language.T("nav.trip")</MudNavLink>
        </MudNavGroup>
    }

    @if (CanAny(SecurityFunctionCodes.HrmSyncViewStatus, SecurityFunctionCodes.UserManagementView))
    {
        <MudNavGroup Title="@Language.T("nav.data")" Icon="@Icons.Material.Filled.Storage" Expanded="false">
            <MudNavLink href="/admin/departments" Icon="@Icons.Material.Filled.Business">@Language.T("nav.department")</MudNavLink>
            <MudNavLink href="/admin/employees" Icon="@Icons.Material.Filled.People">@Language.T("nav.employee")</MudNavLink>
            <MudNavLink href="/admin/approvers" Icon="@Icons.Material.Filled.VerifiedUser">@Language.T("nav.approver")</MudNavLink>
            <MudNavLink href="/admin/leave-types" Icon="@Icons.Material.Filled.Category">@Language.T("nav.leaveType")</MudNavLink>
            <MudNavLink href="/admin/hrm-sync" Icon="@Icons.Material.Filled.Sync">@Language.T("nav.hrmSync")</MudNavLink>
            <MudNavLink href="/admin/hrm-sync-review" Icon="@Icons.Material.Filled.WarningAmber">@Language.T("nav.hrmConflict")</MudNavLink>
            <MudNavLink href="/admin/hrm-role-rules" Icon="@Icons.Material.Filled.Rule">@Language.T("nav.hrmRoleRule")</MudNavLink>
            <MudNavLink href="/admin/approval-policies" Icon="@Icons.Material.Filled.Policy">@Language.T("nav.approvalPolicy")</MudNavLink>
            @if (Can(SecurityFunctionCodes.AttendanceView))
            {
                <MudNavLink href="/hrm/attendance-calculation" Icon="@Icons.Material.Filled.AccessTime">@Language.T("nav.attendanceCalculation")</MudNavLink>
            }
        </MudNavGroup>

        <MudNavGroup Title="@Language.T("nav.overtime")" Icon="@Icons.Material.Filled.Timelapse" Expanded="false">
            <MudNavLink href="/ot/list" Icon="@Icons.Material.Filled.FormatListBulleted">@Language.T("nav.otList")</MudNavLink>
            @if (Can(SecurityFunctionCodes.OTEdit))
            {
                <MudNavLink href="/admin/ot-limit-rules" Icon="@Icons.Material.Filled.Rule">@Language.T("nav.otLimit")</MudNavLink>
            }
        </MudNavGroup>
    }

    @if (CanAny(SecurityFunctionCodes.LeaveView, SecurityFunctionCodes.OTView, SecurityFunctionCodes.TripView, SecurityFunctionCodes.EquipmentView, SecurityFunctionCodes.AttendanceView))
    {
        <MudNavGroup Title="@Language.T("nav.reports")" Icon="@Icons.Material.Filled.Assessment" Expanded="false">
            <MudNavLink href="/reports" Icon="@Icons.Material.Filled.Dashboard">@Language.T("nav.reportCenter")</MudNavLink>
            @if (Can(SecurityFunctionCodes.LeaveView)) { <MudNavLink href="/report/leave" Icon="@Icons.Material.Filled.BeachAccess">@Language.T("nav.leave")</MudNavLink> }
            @if (Can(SecurityFunctionCodes.OTView)) { <MudNavLink href="/report/ot" Icon="@Icons.Material.Filled.MoreTime">@Language.T("nav.overtime")</MudNavLink> }
            @if (Can(SecurityFunctionCodes.TripView)) { <MudNavLink href="/report/operations?module=trip" Icon="@Icons.Material.Filled.FlightTakeoff">@Language.T("nav.trip")</MudNavLink> }
            @if (Can(SecurityFunctionCodes.EquipmentView)) { <MudNavLink href="/report/operations?module=equipment" Icon="@Icons.Material.Filled.Devices">@Language.T("nav.equipment")</MudNavLink> }
            @if (Can(SecurityFunctionCodes.AttendanceView)) { <MudNavLink href="/report/operations?module=attendance" Icon="@Icons.Material.Filled.AccessTime">@Language.T("nav.attendance")</MudNavLink> }
        </MudNavGroup>
    }

    @if (Can(SecurityFunctionCodes.UserManagementView))
    {
        <MudNavGroup Title="@Language.T("nav.system")" Icon="@Icons.Material.Filled.Settings" Expanded="false">
            <MudNavLink href="/admin/managers" Icon="@Icons.Material.Filled.AdminPanelSettings">@Language.T("nav.administrator")</MudNavLink>
            @if (Can(SecurityFunctionCodes.SecurityView))
            {
                <MudNavLink href="/admin/security" Icon="@Icons.Material.Filled.Security">@Language.T("nav.securityCenter")</MudNavLink>
                <MudNavLink href="/admin/sessions" Icon="@Icons.Material.Filled.Devices">@Language.T("nav.devices")</MudNavLink>
            }
            <MudNavLink href="/admin/email-templates" Icon="@Icons.Material.Filled.Email">@Language.T("nav.emailTemplates")</MudNavLink>
            <MudNavLink href="/admin/email-queue" Icon="@Icons.Material.Filled.MarkEmailRead">@Language.T("nav.emailQueue")</MudNavLink>
            @if (Can(SecurityFunctionCodes.SecurityView)) { <MudNavLink href="/admin/work-calendar" Icon="@Icons.Material.Filled.CalendarMonth">@Language.T("nav.workCalendar")</MudNavLink> }
        </MudNavGroup>
    }
</MudNavMenu>

@code {
    private PermissionSnapshotDto? _permissions;
    protected override async Task OnInitializedAsync()
    {
        Language.LanguageChanged += OnLanguageChanged;
        await Language.InitializeAsync();
        var result = await SecurityService.GetMyPermissionsAsync();
        if (result.IsSuccess) _permissions = result.Data;
    }
    private void OnLanguageChanged(object? sender, EventArgs e) => InvokeAsync(StateHasChanged);
    private bool Can(int functionCode) => _permissions?.Has(functionCode) == true;
    private bool CanAny(params int[] functionCodes) => functionCodes.Any(Can);
    public void Dispose() => Language.LanguageChanged -= OnLanguageChanged;
}
