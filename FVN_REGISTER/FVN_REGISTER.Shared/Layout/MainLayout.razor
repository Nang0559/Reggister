@using FVN_REGISTER.Shared.Services.Users
@using FVN_REGISTER.Shared.Utils
@using FVN_REGISTER.Shared.Utils.Helpers
@using FVN_REGISTER.Core.Logging
@inherits AppLayoutBase
@implements IDisposable

@inject IAuthClientService _authService
@inject ISnackbar _snackbar
@inject ICurrentUserClientService _user
@inject NavigationManager _nav
@inject CustomAuthStateProvider _authStateProvider
<MudLayout>
    <MudPopoverProvider />
    @if (_isLoading)
    {
        <div class="d-flex vh-100 align-center justify-center">
            <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large" />
        </div>
    }
    else
    {
        <MudAppBar Elevation="1" Color="Color.Primary">
            <MudIconButton Icon="@Icons.Material.Filled.Menu"
                           OnClick="DrawerToggle" />

            <MudText Typo="Typo.h6" Class="ml-3">
                FCC Smart Portal
            </MudText>
  
            <MudSpacer />

        <MudMenu Label="@(_user.User?.FullName ?? "Nhân viên FCC")"
         Variant="Variant.Text"
         Color="Color.Inherit"
         StartIcon="@Icons.Material.Filled.AccountCircle"
         EndIcon="@Icons.Material.Filled.ArrowDropDown"
         AnchorOrigin="Origin.BottomRight"
         TransformOrigin="Origin.TopRight"
         Dense="true"
         Class="ml-auto">
    <ChildContent>
        @* Phần Header hiển thị thông tin chi tiết bên trong Menu *@
        <div class="pa-4" style="min-width: 220px;">
            <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-2">
                <MudAvatar Color="Color.Secondary" Size="Size.Small">
                    @(_user.User?.FullName?.FirstOrDefault().ToString().ToUpper() ?? "U")
                </MudAvatar>
                <div>
                    <MudText Typo="Typo.subtitle2">@(_user.User?.FullName ?? "N/A")</MudText>
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">Mã NV: @(_user.User?.EmployeeCode ?? "N/A")</MudText>
                </div>
            </MudStack>
        </div>
        <MudDivider />
        
        <MudMenuItem Icon="@Icons.Material.Filled.PersonOutline" OnClick="@(() => _nav.NavigateTo("/profile"))">
            Hồ sơ của tôi
        </MudMenuItem>
        <MudMenuItem Icon="@Icons.Material.Filled.LockReset" OnClick="@(() => _nav.NavigateTo("/change-password"))">
            Đổi mật khẩu
        </MudMenuItem>
        <MudDivider />
        <MudMenuItem Icon="@Icons.Material.Filled.Logout" IconColor="Color.Error" OnClick="HandleLogout">
            <MudText Color="Color.Error">Đăng xuất</MudText>
        </MudMenuItem>
    </ChildContent>
</MudMenu>
      
        </MudAppBar>

        <MudDrawer @bind-Open="_drawerOpen">
            <NavMenu />
        </MudDrawer>

        <MudMainContent>
            <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="my-4">
                @Body
            </MudContainer>
        </MudMainContent>
    }
</MudLayout>

@code {
    private bool _drawerOpen = true;
    private bool _isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _isLoading = true;
            
            // Sử dụng Logger từ AppLayoutBase với Extension Method mới
            Logger.LogInfoIf(Debug, "[{Component}] Starting initialization...", ComponentName);

            // Kiểm tra Auth State trước khi init user để tránh lỗi redirect vòng lặp
            var authState = await _authStateProvider.GetAuthenticationStateAsync();
            if (authState.User.Identity is not { IsAuthenticated: true })
            {
                Logger.LogWarnIf(Debug, "[{Component}] User not authenticated, redirecting to login", ComponentName);
                _nav.NavigateTo("/login");
                return;
            }

            await _user.InitializeAsync();
            
            Logger.LogInfoIf(Debug, "[{Component}] Initialized successfully for User: {UserId}", ComponentName, _user.User?.UserId!);
        }
        catch (Exception ex)
        {
            // Log lỗi sử dụng hệ thống logging thay vì Console.WriteLine
            Logger.LogError(ex, "[{Component}] Initialization failed", ComponentName);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task HandleLogout()
    {
        Logger.LogInfoIf(Debug, "[{Component}] User requested logout", ComponentName);
        await _authService.Logout();
        _nav.NavigateTo("/login", forceLoad: false);
    }

    void DrawerToggle() => _drawerOpen = !_drawerOpen;

    public void Dispose()
    {
        // Thực hiện cleanup nếu cần
    }
}