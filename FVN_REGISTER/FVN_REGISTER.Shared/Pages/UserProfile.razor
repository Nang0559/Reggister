@page "/profile"
@using FVN_REGISTER.Contract.Interfaces.Repositores
@using FVN_REGISTER.Contract.ViewModels
@using FVN_REGISTER.Shared.Handlers
@using FVN_REGISTER.Shared.Services.Users
@inject IHttpClientWithAuth _http
@inject ISnackbar _snackbar
@inject ICurrentUserClientService _user

<MudText Typo="Typo.h5" Class="mb-4">Hồ sơ cá nhân</MudText>

<MudGrid>
    <MudItem xs="12" sm="4">
        <MudCard Elevation="2" Class="text-center pa-4">
            <MudAvatar Style="height:150px; width:150px; font-size:2rem;" Color="Color.Primary" Variant="Variant.Filled" Class="mx-auto mb-3">
                @if (string.IsNullOrEmpty(_model.Avatar))
                {
                    @_model.FullName?.Substring(0, 1).ToUpper()
                }
                else
                {
                    <MudImage Src="@_model.Avatar" />
                }
            </MudAvatar>
            <MudText Typo="Typo.h6">@_model.FullName</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">@_model.EmployeeCode</MudText>
        </MudCard>
    </MudItem>

    <MudItem xs="12" sm="8">
        <MudCard Elevation="2">
            <MudCardContent>
                <MudTextField Label="Tên đăng nhập" @bind-Value="_model.UserName" ReadOnly="true" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-4" />
                <MudTextField Label="Phòng ban" @bind-Value="_model.DeptCode" ReadOnly="true" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-4" />
                <MudTextField Label="Email liên lạc" @bind-Value="_model.Email" Variant="Variant.Outlined" Margin="Margin.Dense" HelperText="Dùng để nhận thông báo phê duyệt" Class="mb-4" />
                <MudTextField Label="Đường dẫn ảnh đại diện (URL)" @bind-Value="_model.Avatar" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-4" />
            </MudCardContent>
            <MudCardActions>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="OnSave" Disabled="_isSaving" StartIcon="@Icons.Material.Filled.Save">
                    @(_isSaving ? "Đang lưu..." : "Lưu thay đổi")
                </MudButton>
            </MudCardActions>
        </MudCard>
    </MudItem>
</MudGrid>

@code {
    private UserSessionDto _model = new();
    private bool _isSaving = false;

    protected override async Task OnInitializedAsync()
    {
        // 1. SỬA ĐƯỜNG DẪN: Phải có "auth" nếu Server đặt Route là api/auth
        // 2. NHẬN DỮ LIỆU: GetAsync đã trả về ApiResponse<UserSessionDto> rồi
        var response = await _http.GetAsync<UserSessionDto>("api/auth/profile");

        if (response.IsSuccess && response.Data != null)
        {
            _model = response.Data;
            _model.FullName = _model.FullName?.Trim() ?? "";
        }
        else if (response.IsUnauthorized)
        {
            _snackbar.Add("Phiên đăng nhập hết hạn!", Severity.Error);
        }
    }

    private async Task OnSave()
    {
        _isSaving = true;
        var request = new { Email = _model.Email, AvatarUrl = _model.Avatar };

        // 1. SỬA ĐƯỜNG DẪN: Thêm "auth"
        // 2. PutAsync đã trả về ApiResponse<object>, không cần đọc Content nữa
        var result = await _http.PutAsync<object>("api/auth/profile/update", request);

        if (result.IsSuccess)
        {
            _snackbar.Add("Đã cập nhật hồ sơ thành công!", Severity.Success);
            await _user.InitializeAsync();
        }
        else
        {
            _snackbar.Add(result.Message ?? "Có lỗi xảy ra!", Severity.Error);
        }
        _isSaving = false;
    }
}