@page "/login"
@using System.ComponentModel.DataAnnotations
@using FVN_REGISTER.Shared.Layout
@using FVN_REGISTER.Shared.Services.Users
@using FVN_REGISTER.Shared.Utils
@using FVN_REGISTER.Core.Logging
@using FVN_REGISTER.Shared.Utils.Helpers

@layout EmptyLayout
@inherits AppComponentBase
@inject ICurrentUserClientService _currentUserService
@inject CustomAuthStateProvider _authStateProvider
@inject IAuthClientService _authService
@inject NavigationManager _nav
@inject ISnackbar _snackbar
@inject ITokenStorage _tokenStorage

<MudContainer MaxWidth="MaxWidth.Small" Class="d-flex align-center justify-center" Style="height: 100vh;">
    <MudPaper Elevation="4" Class="pa-8" Width="100%" Style="max-width: 400px; border-radius: 12px;">
        <div class="d-flex flex-column align-center mb-6">
            <MudIcon Icon="@Icons.Material.Filled.PrecisionManufacturing" Color="Color.Primary" Size="Size.Large" />
            <MudText Typo="Typo.h5" Class="mt-2" Style="font-weight: bold; color: #1E88E5;">e-Approval System</MudText>
            <MudText Typo="Typo.caption" Color="Color.Secondary">Hệ thống FCC Việt Nam - Đăng nhập</MudText>
        </div>

        <EditForm Model="@_loginModel" OnValidSubmit="HandleLogin">
            <DataAnnotationsValidator />

            <MudTextField T="string" Label="Mã nhân viên / UserName"
                          @bind-Value="_loginModel.UserName"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Person"
                          For="@(() => _loginModel.UserName)"
                          Class="mb-4" />

            <MudTextField T="string" Label="Mật khẩu"
                          @bind-Value="_loginModel.Password"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          InputType="@_passwordInput"
                          Adornment="Adornment.End"
                          AdornmentIcon="@_passwordInputIcon"
                          OnAdornmentClick="TogglePasswordVisibility"
                          For="@(() => _loginModel.Password)"
                          Class="mb-6" />

            <MudButton ButtonType="ButtonType.Submit"
                       Variant="Variant.Filled"
                       Color="Color.Primary"
                       FullWidth="true"
                       Size="Size.Large"
                       Disabled="@_isProcessing">
                @if (_isProcessing)
                {
                    <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                    <MudText Class="ms-2">Đang xác thực...</MudText>
                }
                else
                {
                    <MudText>ĐĂNG NHẬP</MudText>
                }
            </MudButton>
        </EditForm>

        <div class="mt-6 d-flex justify-center">
            <MudText Typo="Typo.caption" Class="mud-text-secondary">Quên mật khẩu? Liên hệ phòng IT FCC</MudText>
        </div>
    </MudPaper>
</MudContainer>

@code {
    private LoginRequest _loginModel = new();
    private bool _isProcessing = false;
    private bool _passwordVisibility;
    private InputType _passwordInput = InputType.Password;
    private string _passwordInputIcon = Icons.Material.Filled.VisibilityOff;

    public class LoginRequest
    {
        [Required(ErrorMessage = "Mã nhân viên không được để trống")]
        public string UserName { get; set; } = string.Empty;

        [Required(ErrorMessage = "Mật khẩu không được để trống")]
        public string Password { get; set; } = string.Empty;
    }

    private void TogglePasswordVisibility()
    {
        if (_passwordVisibility)
        {
            _passwordVisibility = false;
            _passwordInputIcon = Icons.Material.Filled.VisibilityOff;
            _passwordInput = InputType.Password;
        }
        else
        {
            _passwordVisibility = true;
            _passwordInputIcon = Icons.Material.Filled.Visibility;
            _passwordInput = InputType.Text;
        }
    }

    private async Task HandleLogin()
    {
        _isProcessing = true;
        Logger.LogInfoIf(Debug, "[{Component}] Người dùng {User} đang thử đăng nhập...", ComponentName, _loginModel.UserName);

        try
        {
            var result = await _authService.Login(_loginModel.UserName, _loginModel.Password);

            if (result.IsSuccess && result.Data != null)
            {
                var token = result.Data.Token!;

                // THỨ TỰ CHUẨN:
                // 1. Lưu vào Storage & Static Cache trước (để API Handler lấy được ngay)
                await _tokenStorage.SetTokenAsync(token);
                Logger.LogDebugIf(Debug, "[{Component}] Đã lưu Token vào bộ nhớ.", ComponentName);

                // 2. Load Profile User
                await _currentUserService.InitializeAsync(token);

                // 3. Thông báo thay đổi trạng thái Auth (Sau khi đã có Profile và Token)
                if (_authStateProvider is CustomAuthStateProvider cp)
                {
                    cp.NotifyUserLogin(token);
                }

                _snackbar.Add("Xác thực thành công!", Severity.Success);
                Logger.LogInfoIf(Debug, "[{Component}] Đăng nhập thành công, điều hướng về Home.", ComponentName);

                // 4. Điều hướng (Nếu tắt Prerender thì không cần forceLoad)
                _nav.NavigateTo("/", forceLoad: false);
            }
            else
            {
                Logger.LogWarnIf(Debug, "[{Component}] Đăng nhập thất bại: {Msg}", ComponentName, result.Message);
                _snackbar.Add(result.Message ?? "Mã nhân viên hoặc mật khẩu không đúng", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "[{Component}] Lỗi kết nối API", ComponentName);
            _snackbar.Add("Không thể kết nối đến máy chủ FCC", Severity.Error);
        }
        finally
        {
            _isProcessing = false;
        }
    }

   
}