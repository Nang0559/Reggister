@page "/equipment"
@attribute [Authorize]
@using FVN_REGISTER.Contract.Dtos.Equipment
@using FVN_REGISTER.Shared.Services.Equipment
@using FVN_REGISTER.Shared.Services.Users
@using Microsoft.AspNetCore.Authorization
@inherits AppComponentBase
@inject IEquipmentClientService Equipment
@inject ICurrentUserClientService CurrentUser
@inject ISnackbar Snackbar
@inject NavigationManager Navigation

@if (!_ready) { <MudProgressCircular Indeterminate="true" /> }
else if (!_access) { <MudAlert Severity="Severity.Warning">Tài khoản chưa được cấp quyền Sổ quản lý thiết bị.</MudAlert> }
else
{
    <MudText Typo="Typo.h5" Class="mb-4">Sổ quản lý thiết bị</MudText>
    <MudTabs Elevation="2" Rounded="true">
        <MudTabPanel Text="Đăng ký thiết bị">
            <MudGrid Class="pa-4">
                <MudItem xs="12" md="6"><MudTextField @bind-Value="_form.EquipmentName" Label="Tên thiết bị" Required="true" /></MudItem>
                <MudItem xs="12" md="6"><MudTextField @bind-Value="_form.AssetCode" Label="Mã tài sản" /></MudItem>
                <MudItem xs="12"><MudTextField @bind-Value="_form.Specification" Label="Thông số / Model" /></MudItem>
                <MudItem xs="12" md="6"><MudTextField @bind-Value="_form.SerialNumber" Label="Serial Number" /></MudItem>
                <MudItem xs="12" md="6"><MudTextField @bind-Value="_form.Location" Label="Vị trí" /></MudItem>
                <MudItem xs="12" md="4"><MudNumericField @bind-Value="_form.PurchasePrice" Label="Giá thành" Min="0" /></MudItem>
                <MudItem xs="12" md="4"><MudDatePicker @bind-Date="_purchase" Label="Ngày mua" /></MudItem>
                <MudItem xs="12" md="4"><MudDatePicker @bind-Date="_depreciation" Label="Ngày khấu hao dự kiến" /></MudItem>
                <MudItem xs="12" md="6"><MudTextField @bind-Value="_form.DeptCode" Label="Bộ phận" Required="true" /></MudItem>
                <MudItem xs="12" md="6"><MudSelect T="string" @bind-Value="_form.SelectedApproverCode" Label="Người phê duyệt" Required="true">@foreach (var a in _approvers) { <MudSelectItem Value="@a.ApproverCode">@a.ApproverName — L@a.Level</MudSelectItem> }</MudSelect></MudItem>
                <MudItem xs="12"><MudTextField @bind-Value="_form.Note" Label="Ghi chú" Lines="3" /></MudItem>
                <MudItem xs="12"><MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="CreateAsync" Disabled="_busy">Tạo đăng ký & sinh QR</MudButton></MudItem>
            </MudGrid>
            @if (_created != null)
            {
                <MudCard Class="ma-4 pa-4"><MudText Typo="Typo.subtitle1">QR thiết bị</MudText><MudText Typo="Typo.caption">QR được sinh trước; chỉ có hiệu lực sau khi duyệt hoàn tất.</MudText><img src="@($"api/equipment/qr/{Uri.EscapeDataString(_created.QrToken)}/image")" style="width:220px;height:220px" /><MudText>Request #@_created.Id — @_created.RequestStatus</MudText><MudButton Color="Color.Success" OnClick="SubmitAsync" Disabled="_busy">Gửi duyệt</MudButton></MudCard>
            }
        </MudTabPanel>
        <MudTabPanel Text="Quét QR"><EquipmentQrScanner OnDetected="OnDetected" /><MudTextField @bind-Value="_token" Label="Hoặc nhập QR token" /><MudButton OnClick="ManualScan">Tra cứu</MudButton></MudTabPanel>
        <MudTabPanel Text="Yêu cầu của tôi"><MudTable Items="_mine" Dense="true"><HeaderContent><MudTh>Loại</MudTh><MudTh>Thiết bị</MudTh><MudTh>Trạng thái</MudTh></HeaderContent><RowTemplate><MudTd>@context.RequestKind</MudTd><MudTd>@context.EquipmentName</MudTd><MudTd>@context.RequestStatus</MudTd></RowTemplate></MudTable></MudTabPanel>
    </MudTabs>
}

@code {
    private bool _ready; private bool _access; private bool _busy; private string _token = string.Empty;
    private DateTime? _purchase = DateTime.Today; private DateTime? _depreciation = DateTime.Today.AddYears(3);
    private List<EquipmentApproverDto> _approvers = new(); private List<EquipmentRequestDto> _mine = new(); private EquipmentRequestDto? _created;
    private CreateEquipmentRegistrationDto _form = new();
    protected override async Task OnInitializedAsync() { var a = await Equipment.HasAccessAsync(); _access = a.IsSuccess && a.Data; if (_access) { _form.DeptCode = CurrentUser.User?.DeptCode ?? string.Empty; await LoadAsync(); } _ready = true; }
    private async Task LoadAsync() { var a = await Equipment.GetApproversAsync(_form.DeptCode); if (a.IsSuccess) _approvers = a.Data ?? new(); var m = await Equipment.GetMineAsync(); if (m.IsSuccess) _mine = m.Data ?? new(); }
    private async Task CreateAsync() { _form.PurchaseDate = _purchase ?? DateTime.Today; _form.ExpectedDepreciationDate = _depreciation ?? _form.PurchaseDate.AddYears(3); _busy = true; var r = await Equipment.CreateRegistrationAsync(_form); _busy = false; if (r.IsSuccess) { _created = r.Data; Snackbar.Add("Đã tạo Draft và sinh QR.", Severity.Success); await LoadAsync(); } else Snackbar.Add(r.Message ?? "Không thể tạo đăng ký.", Severity.Error); }
    private async Task SubmitAsync() { if (_created == null) return; _busy = true; var r = await Equipment.SubmitRegistrationAsync(_created.Id); _busy = false; if (r.IsSuccess) { _created = r.Data; Snackbar.Add("Đã gửi duyệt.", Severity.Success); await LoadAsync(); } else Snackbar.Add(r.Message ?? "Không thể gửi duyệt.", Severity.Error); }
    private Task OnDetected(string value) { _token = value; Navigation.NavigateTo($"/equipment/scan/{Uri.EscapeDataString(value)}"); return Task.CompletedTask; }
    private Task ManualScan() { if (!string.IsNullOrWhiteSpace(_token)) Navigation.NavigateTo($"/equipment/scan/{Uri.EscapeDataString(_token.Trim())}"); return Task.CompletedTask; }
}
