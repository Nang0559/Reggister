@* FVN_REGISTER.Shared/Pages/Admin/EmailQueueManager.razor *@
@page "/admin/email-queue"
@attribute [Authorize]
@using FVN_REGISTER.Contract.Dtos
@using FVN_REGISTER.Core.Constants
@using FVN_REGISTER.Contract.Dtos.EmailTemplates
@using FVN_REGISTER.Shared.Services.Emails
@using FVN_REGISTER.Shared.Services.Users
@using FVN_REGISTER.Shared.Utils
@using FVN_REGISTER.Shared.Utils.Helpers
@using Microsoft.AspNetCore.Authorization
@inherits AppComponentBase
@implements IDisposable

@inject IEmailQueueClientService QueueService
@inject ICurrentUserClientService CurrentUser
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<PageTitle>Quản lý Email Queue</PageTitle>

@if (!CurrentUser.PermissionCode.IsAdmin())
{
    <MudAlert Severity="Severity.Error">Bạn không có quyền truy cập.</MudAlert>
    return;
}

@* ── Header ── *@
<MudStack Row="true" AlignItems="AlignItems.Center"
          Justify="Justify.SpaceBetween" Class="mb-4">
    <div>
        <MudText Typo="Typo.h5">
            <MudIcon Icon="@Icons.Material.Filled.MarkEmailUnread" Class="mr-2" />
            Quản lý Email Queue
        </MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary">
            Theo dõi và xử lý hàng đợi email hệ thống
        </MudText>
    </div>
    <MudStack Row="true" Spacing="2">
        <MudButton Variant="Variant.Outlined" Color="Color.Warning"
                   StartIcon="@Icons.Material.Filled.Refresh"
                   OnClick="LoadData" Disabled="_isLoading">
            Làm mới
        </MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Send"
                   OnClick="TriggerQueue"
                   Disabled="_isProcessing">
            @(_isProcessing ? "Đang xử lý..." : "Xử lý ngay")
        </MudButton>
    </MudStack>
</MudStack>

@* ── Stats Cards ── *@
<MudGrid Class="mb-4">
    <MudItem xs="6" sm="3">
        <MudPaper Class="pa-3" Elevation="2">
            <MudText Typo="Typo.caption" Color="Color.Secondary">TỔNG</MudText>
            <MudText Typo="Typo.h5">@_items.Count</MudText>
        </MudPaper>
    </MudItem>
    <MudItem xs="6" sm="3">
        <MudPaper Class="pa-3" Elevation="2">
            <MudText Typo="Typo.caption" Color="Color.Warning">CHỜ GỬI</MudText>
            <MudText Typo="Typo.h5" Color="Color.Warning">
                @_items.Count(x => x.Status == "Pending" || x.Status == "Retry")
            </MudText>
        </MudPaper>
    </MudItem>
    <MudItem xs="6" sm="3">
        <MudPaper Class="pa-3" Elevation="2">
            <MudText Typo="Typo.caption" Color="Color.Error">THẤT BẠI</MudText>
            <MudText Typo="Typo.h5" Color="Color.Error">
                @_items.Count(x => x.Status == "Failed")
            </MudText>
        </MudPaper>
    </MudItem>
    <MudItem xs="6" sm="3">
        <MudPaper Class="pa-3" Elevation="2">
            <MudText Typo="Typo.caption" Color="Color.Success">ĐÃ GỬI</MudText>
            <MudText Typo="Typo.h5" Color="Color.Success">
                @_items.Count(x => x.Status == "Sent")
            </MudText>
        </MudPaper>
    </MudItem>
</MudGrid>

@* ── Filter ── *@
<MudPaper Elevation="1" Class="pa-3 mb-3">
    <MudStack Row="true" Spacing="3" AlignItems="AlignItems.Center">
        <MudSelect T="string" Label="Trạng thái" @bind-Value="_filterStatus"
                   Variant="Variant.Outlined" Margin="Margin.Dense"
                   Style="min-width: 160px;" Clearable="true">
            <MudSelectItem Value="@("Pending")">Chờ gửi</MudSelectItem>
            <MudSelectItem Value="@("Retry")">Đang retry</MudSelectItem>
            <MudSelectItem Value="@("Failed")">Thất bại</MudSelectItem>
            <MudSelectItem Value="@("Sent")">Đã gửi</MudSelectItem>
            <MudSelectItem Value="@("Cancelled")">Đã hủy</MudSelectItem>
        </MudSelect>
        <MudTextField @bind-Value="_searchText"
                      Placeholder="Tìm email, template..."
                      Adornment="Adornment.Start"
                      AdornmentIcon="@Icons.Material.Filled.Search"
                      Variant="Variant.Outlined" Margin="Margin.Dense"
                      Immediate="true" Style="min-width: 260px;" />
        @if (_selectedIds.Any())
        {
            <MudButton Variant="Variant.Filled" Color="Color.Success"
                       Size="Size.Small"
                       StartIcon="@Icons.Material.Filled.Replay"
                       OnClick="RetrySelected">
                Retry (@_selectedIds.Count)
            </MudButton>
            <MudButton Variant="Variant.Outlined" Color="Color.Error"
                       Size="Size.Small"
                       StartIcon="@Icons.Material.Filled.Cancel"
                       OnClick="CancelSelected">
                Hủy (@_selectedIds.Count)
            </MudButton>
        }
    </MudStack>
</MudPaper>

@* ── Table ── *@
<MudPaper Elevation="2">
    @if (_isLoading)
    {
        <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
    }
    <MudTable T="EmailQueueDto"
              Items="FilteredItems"
              Dense="true" Hover="true"
              MultiSelection="true"
              @bind-SelectedItems="_selectedSet">
        <HeaderContent>
            <MudTh>ID</MudTh>
            <MudTh>Người nhận</MudTh>
            <MudTh>Template</MudTh>
            <MudTh>Trạng thái</MudTh>
            <MudTh>Retry</MudTh>
            <MudTh>Ngày tạo</MudTh>
            <MudTh>Ngày gửi</MudTh>
            <MudTh>Lỗi</MudTh>
            <MudTh>Thao tác</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd>
                <MudText Typo="Typo.caption">@context.Id</MudText>
            </MudTd>
            <MudTd>
                <MudText Typo="Typo.body2">@context.ToEmail</MudText>
            </MudTd>
            <MudTd>
                <MudChip T="string" Size="Size.Small" Color="Color.Primary"
                         Label="true">
                    @context.TemplateCode
                </MudChip>
            </MudTd>
            <MudTd>
                <MudChip T="string" Size="Size.Small"
                         Color="@GetStatusColor(context.Status)"
                         Label="true">
                    @GetStatusText(context.Status)
                </MudChip>
            </MudTd>
            <MudTd>
                <MudText Typo="Typo.caption">
                    @context.RetryCount / @context.MaxRetry
                </MudText>
            </MudTd>
            <MudTd>
                <MudText Typo="Typo.caption">
                    @context.CreatedAt?.ToString("dd/MM HH:mm")
                </MudText>
            </MudTd>
            <MudTd>
                <MudText Typo="Typo.caption" Color="Color.Success">
                    @(context.SentAt?.ToString("dd/MM HH:mm") ?? "—")
                </MudText>
            </MudTd>
            <MudTd Style="max-width: 200px;">
                @if (!string.IsNullOrEmpty(context.ErrorMessage))
                {
                    <MudTooltip Text="@context.ErrorMessage" Placement="Placement.Left">
                        <MudText Typo="Typo.caption" Color="Color.Error"
                                 Style="overflow:hidden;text-overflow:ellipsis;white-space:nowrap;display:block;max-width:180px;">
                            @context.ErrorMessage
                        </MudText>
                    </MudTooltip>
                }
                else
                {
                    <MudText Typo="Typo.caption" Color="Color.Secondary">—</MudText>
                }
            </MudTd>
            <MudTd>
                <MudStack Row="true" Spacing="0">
                    <MudIconButton Icon="@Icons.Material.Filled.Visibility"
                                   Size="Size.Small" Color="Color.Info" title="Xem nội dung"
                                   OnClick="@(() => ViewPayload(context))" />
                    @if (context.Status is "Failed" or "Retry" or "Pending")
                    {
                        <MudIconButton Icon="@Icons.Material.Filled.Send"
                                       Size="Size.Small" Color="Color.Success" title="Gửi lại"
                                       OnClick="@(() => RetrySingle(context))" />
                    }
                    @if (context.Status is not "Sent" and not "Cancelled")
                    {
                        <MudIconButton Icon="@Icons.Material.Filled.Cancel"
                                       Size="Size.Small" Color="Color.Error" title="Hủy"
                                       OnClick="@(() => CancelSingle(context))" />
                    }
                </MudStack>
            </MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudText Color="Color.Secondary" Class="pa-4">Không có email nào.</MudText>
        </NoRecordsContent>
        <PagerContent>
            <MudTablePager PageSizeOptions="new int[]{20, 50, 100}" />
        </PagerContent>
    </MudTable>
</MudPaper>

@* ── Payload Dialog ── *@
<MudDialog @bind-Visible="_showPayload"
           Options="@(new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true })">
    <TitleContent>
        <MudText Typo="Typo.h6">
            Chi tiết Email #@_viewItem?.Id — @_viewItem?.TemplateCode
        </MudText>
    </TitleContent>
    <DialogContent>
        @if (_viewItem != null)
        {
            <MudGrid>
                <MudItem xs="6">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Người nhận</MudText>
                    <MudText>@_viewItem.ToEmail</MudText>
                </MudItem>
                <MudItem xs="6">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Trạng thái</MudText>
                    <MudChip T="string" Size="Size.Small"
                             Color="@GetStatusColor(_viewItem.Status)" Label="true">
                        @GetStatusText(_viewItem.Status)
                    </MudChip>
                </MudItem>
                @if (!string.IsNullOrEmpty(_viewItem.ErrorMessage))
                {
                    <MudItem xs="12">
                        <MudAlert Severity="Severity.Error" Dense="true">
                            @_viewItem.ErrorMessage
                        </MudAlert>
                    </MudItem>
                }
                <MudItem xs="12">
                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-1">
                        Payload (dữ liệu biến)
                    </MudText>
                    <MudPaper Elevation="0" Class="pa-3"
                              Style="background: var(--mud-palette-background-grey);
                                     font-family: monospace; font-size: 12px;
                                     white-space: pre-wrap; word-break: break-all;
                                     max-height: 300px; overflow-y: auto;">
                        @FormatJson(_viewItem.Payload)
                    </MudPaper>
                </MudItem>
            </MudGrid>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => _showPayload = false)">Đóng</MudButton>
        @if (_viewItem?.Status is "Failed" or "Retry")
        {
            <MudButton Color="Color.Success" Variant="Variant.Filled"
                       StartIcon="@Icons.Material.Filled.Send"
                       OnClick="@(() => RetrySingle(_viewItem!))">
                Gửi lại
            </MudButton>
        }
    </DialogActions>
</MudDialog>
@code {
    private List<EmailQueueDto> _items = new();
    private HashSet<EmailQueueDto> _selectedSet = new();
    private HashSet<int> _selectedIds = new();
    private EmailQueueDto? _viewItem;
    private bool _isLoading;
    private bool _isProcessing;
    private bool _showPayload;
    private string _searchText = "";
    private string? _filterStatus;
    private readonly CancellationTokenSource _cts = new();

    private IEnumerable<EmailQueueDto> FilteredItems => _items
        .Where(x =>
            (string.IsNullOrEmpty(_filterStatus) || x.Status == _filterStatus) &&
            (string.IsNullOrEmpty(_searchText) ||
             (x.ToEmail?.Contains(_searchText, StringComparison.OrdinalIgnoreCase) ?? false) ||
             (x.TemplateCode?.Contains(_searchText, StringComparison.OrdinalIgnoreCase) ?? false)));

    protected override async Task OnInitializedAsync() => await LoadData();

    private async Task LoadData()
    {
        _isLoading = true;
        try
        {
            var result = await QueueService.GetAllAsync(_cts.Token);
            if (result.IsSuccess && result.Data != null)
                _items = result.Data;
            else
                Snackbar.Add(result.Message ?? "Lỗi tải dữ liệu.", Severity.Error);
        }
        finally { _isLoading = false; }
    }

    private async Task TriggerQueue()
    {
        _isProcessing = true;
        try
        {
            var result = await QueueService.TriggerProcessAsync(_cts.Token);
            Snackbar.Add(result.IsSuccess
                ? "Đã xử lý queue thành công!"
                : result.Message ?? "Lỗi.", result.IsSuccess
                ? Severity.Success : Severity.Error);
            await LoadData();
        }
        finally { _isProcessing = false; }
    }

    private async Task RetrySingle(EmailQueueDto item)
    {
        var result = await QueueService.RetryAsync(item.Id, _cts.Token);
        Snackbar.Add(result.IsSuccess ? "Đã đặt lại để gửi." : result.Message ?? "Lỗi.",
            result.IsSuccess ? Severity.Success : Severity.Error);
        if (result.IsSuccess) { _showPayload = false; await LoadData(); }
    }

    private async Task CancelSingle(EmailQueueDto item)
    {
        var confirmed = await DialogService.ShowMessageBoxAsync(
            "Xác nhận hủy", $"Hủy email #{item.Id} đến {item.ToEmail}?",
            yesText: "Hủy email", cancelText: "Không");
        if (confirmed != true) return;

        var result = await QueueService.CancelAsync(item.Id, _cts.Token);
        Snackbar.Add(result.IsSuccess ? "Đã hủy." : result.Message ?? "Lỗi.",
            result.IsSuccess ? Severity.Info : Severity.Error);
        if (result.IsSuccess) await LoadData();
    }

    private async Task RetrySelected()
    {
        var result = await QueueService.RetryBatchAsync(_selectedIds.ToList(), _cts.Token);
        Snackbar.Add(result.IsSuccess
            ? $"Đã đặt lại {_selectedIds.Count} email."
            : result.Message ?? "Lỗi.", result.IsSuccess ? Severity.Success : Severity.Error);
        _selectedIds.Clear(); _selectedSet.Clear();
        await LoadData();
    }

    private async Task CancelSelected()
    {
        var confirmed = await DialogService.ShowMessageBoxAsync(
            "Xác nhận hủy", $"Hủy {_selectedIds.Count} email đã chọn?",
            yesText: "Hủy tất cả", cancelText: "Không");
        if (confirmed != true) return;

        var result = await QueueService.CancelBatchAsync(_selectedIds.ToList(), _cts.Token);
        Snackbar.Add(result.IsSuccess
            ? $"Đã hủy {_selectedIds.Count} email."
            : result.Message ?? "Lỗi.", result.IsSuccess ? Severity.Success : Severity.Error);
        _selectedIds.Clear(); _selectedSet.Clear();
        await LoadData();
    }

    private void OnSelectionChanged(HashSet<EmailQueueDto> selected)
    {
        _selectedSet = selected;
        _selectedIds = selected.Select(x => x.Id).ToHashSet();
    }

    private void ViewPayload(EmailQueueDto item) { _viewItem = item; _showPayload = true; }

    private static Color GetStatusColor(string? s) => s switch
    {
        "Sent" => Color.Success,
        "Failed" => Color.Error,
        "Retry" => Color.Warning,
        "Pending" => Color.Info,
        "Cancelled" => Color.Default,
        _ => Color.Default
    };

    private static string GetStatusText(string? s) => s switch
    {
        "Sent" => "Đã gửi",
        "Failed" => "Thất bại",
        "Retry" => "Đang retry",
        "Pending" => "Chờ gửi",
        "Cancelled" => "Đã hủy",
        _ => s ?? "—"
    };

    private static string FormatJson(string? json)
    {
        if (string.IsNullOrEmpty(json)) return "—";
        try
        {
            var obj = System.Text.Json.JsonSerializer.Deserialize<object>(json);
            return System.Text.Json.JsonSerializer.Serialize(obj,
                new System.Text.Json.JsonSerializerOptions { WriteIndented = true });
        }
        catch { return json; }
    }

    public void Dispose() { _cts.Cancel(); _cts.Dispose(); }
}