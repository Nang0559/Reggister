@* ============================================================
   FILE: FVN_REGISTER.Shared/Pages/OT/CreateOT.razor
   Bước 1-2: Tạo đơn OT → Chọn phạm vi → Nhập danh sách NV
   ============================================================ *@
@page "/ot/create"
@attribute [Authorize]
@using FVN_REGISTER.Contract.Utils
@using FVN_REGISTER.Contract.ViewModels
@using FVN_REGISTER.Contract.ViewModels.OT
@using FVN_REGISTER.Shared.Services.OT
@using FVN_REGISTER.Shared.Services.Users
@using FVN_REGISTER.Shared.Utils.Helpers
@using FVN_REGISTER.Core.Logging
@using Microsoft.AspNetCore.Authorization
@inherits AppComponentBase
@inject IOTClientService OTService
@inject ICurrentUserClientService CurrentUser
@inject NavigationManager Nav
@inject ISnackbar Snackbar

<PageTitle>Tạo Đơn OT - FCC Portal</PageTitle>

<MudText Typo="Typo.h5" Class="mb-1">
    <MudIcon Icon="@Icons.Material.Filled.AccessTimeFilled" Class="mr-2" Color="Color.Warning" />
    Đăng Ký Tăng Ca (OT)
</MudText>
<MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">
    1 đơn OT có thể áp dụng cho nhiều nhân viên cùng bộ phận
</MudText>

@* ── STEPPER ──────────────────────────────────────────────── *@
<MudStepper @ref="_stepper" Linear="true" Color="Color.Warning">

    @* BƯỚC 1: Thông tin OT *@
    <MudStep Title="Thông tin OT" Icon="@Icons.Material.Filled.Info">
        <MudGrid>
            <MudItem xs="12" sm="6">
                <MudDatePicker Label="Ngày OT (*)"
                               @bind-Date="_otDate"
                               Variant="Variant.Outlined"
                               Margin="Margin.Dense"
                               DateFormat="dd/MM/yyyy"
                               Required="true"
                               HelperText="Chọn ngày làm thêm" />
            </MudItem>

            <MudItem xs="12" sm="6">
                <MudSelect T="string" Label="Loại OT (*)"
                           @bind-Value="_model.OTType"
                           Variant="Variant.Outlined"
                           Margin="Margin.Dense">
                    <MudSelectItem Value="@OTTypeConst.Weekday">Ngày thường</MudSelectItem>
                    <MudSelectItem Value="@OTTypeConst.Weekend">Cuối tuần</MudSelectItem>
                    <MudSelectItem Value="@OTTypeConst.Holiday">Ngày lễ</MudSelectItem>
                </MudSelect>
            </MudItem>

            <MudItem xs="12" sm="3">
                <MudTimePicker Label="Giờ bắt đầu (*)"
                               @bind-Time="_startTime"
                               Variant="Variant.Outlined"
                               Margin="Margin.Dense"
                               AmPm="false"
                               Required="true" />
            </MudItem>

            <MudItem xs="12" sm="3">
                <MudTimePicker Label="Giờ kết thúc (*)"
                               @bind-Time="_endTime"
                               Variant="Variant.Outlined"
                               Margin="Margin.Dense"
                               AmPm="false"
                               Required="true" />
            </MudItem>

            <MudItem xs="12" sm="3">
                <MudNumericField T="decimal"
                                 Label="Số giờ OT"
                                 @bind-Value="_model.PlannedHours"
                                 Variant="Variant.Outlined"
                                 Margin="Margin.Dense"
                                 ReadOnly="true"
                                 HelperText="Tự tính từ giờ" />
            </MudItem>

            <MudItem xs="12" sm="3">
                <MudSelect T="string" Label="Phạm vi (*)"
                           @bind-Value="_model.ScopeType"
                           Variant="Variant.Outlined"
                           Margin="Margin.Dense">
                    <MudSelectItem Value="@("SELECTED")">Chọn từng người</MudSelectItem>
                    <MudSelectItem Value="@("DEPT")">Toàn bộ phận</MudSelectItem>
                </MudSelect>
            </MudItem>

            <MudItem xs="12">
                <MudTextField T="string" Label="Lý do OT (*)"
                              @bind-Value="_model.OTReason"
                              Variant="Variant.Outlined"
                              Lines="3"
                              Required="true"
                              MaxLength="500"
                              HelperText="@($"{_model.OTReason?.Length ?? 0}/500")" />
            </MudItem>
        </MudGrid>
    </MudStep>

    @* BƯỚC 2: Danh sách nhân viên *@
    <MudStep Title="Danh sách NV" Icon="@Icons.Material.Filled.People">

        @* Thanh tìm kiếm + thêm NV *@
        <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-3" Spacing="2">
            <MudTextField T="string" @bind-Value="_searchEmp"
                          Placeholder="Tìm mã / tên nhân viên..."
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Style="max-width:320px" />
            <MudButton Variant="Variant.Filled" Color="Color.Warning"
                       StartIcon="@Icons.Material.Filled.Add"
                       OnClick="OpenAddEmployeeDialog">
                Thêm nhân viên
            </MudButton>
            @if (_model.ScopeType == "DEPT")
            {
                <MudButton Variant="Variant.Outlined" Color="Color.Info"
                           StartIcon="@Icons.Material.Filled.GroupAdd"
                           OnClick="LoadAllDeptEmployees">
                    Thêm toàn bộ phận
                </MudButton>
            }
        </MudStack>

        @* Cảnh báo công nhân - hiện Bước 3 *@
        @if (_model.Employees.Any(e => e.CvCode == "0003"))
        {
            <MudAlert Severity="Severity.Info" Class="mb-3" Dense="true">
                <MudIcon Icon="@Icons.Material.Filled.Engineering" Class="mr-1" />
                Danh sách có <b>công nhân (CVCode 0003)</b> — Bước 3 (Sub-leader/Leader) là <b>bắt buộc</b>.
            </MudAlert>
        }

        @* Bảng nhân viên đã chọn *@
        <MudTable Items="@FilteredEmployees" Dense="true" Hover="true" Striped="true"
                  Elevation="0" FixedHeader="true" Height="280px">
            <HeaderContent>
                <MudTh>Mã NV</MudTh>
                <MudTh>Họ tên</MudTh>
                <MudTh>Bộ phận</MudTh>
                <MudTh>CV</MudTh>
                <MudTh>Ghi chú</MudTh>
                <MudTh></MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>@context.EmployeeCode</MudTd>
                <MudTd>@context.EmployeeName</MudTd>
                <MudTd>@context.DeptCode</MudTd>
                <MudTd>
                    @if (context.CvCode == "0003")
                    {
                        <MudChip Size="Size.Small" Color="Color.Warning" Icon="@Icons.Material.Filled.Engineering">
                            Công nhân
                        </MudChip>
                    }
                    else
                    {
                        <MudChip Size="Size.Small" Color="Color.Info" Icon="@Icons.Material.Filled.BusinessCenter">
                            Văn phòng
                        </MudChip>
                    }
                </MudTd>
                <MudTd>
                    <MudTextField T="string" @bind-Value="context.Note"
                                  Placeholder="Ghi chú..."
                                  Variant="Variant.Text" Margin="Margin.Dense" />
                </MudTd>
                <MudTd>
                    <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                   Size="Size.Small" Color="Color.Error"
                                   OnClick="@(() => RemoveEmployee(context))" />
                </MudTd>
            </RowTemplate>
            <NoRecordsContent>
                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="pa-4">
                    Chưa có nhân viên. Bấm "Thêm nhân viên" để chọn.
                </MudText>
            </NoRecordsContent>
        </MudTable>

        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-2">
            Tổng: <b>@_model.Employees.Count</b> nhân viên
            (@_model.Employees.Count(e => e.CvCode == "0003") công nhân /
             @_model.Employees.Count(e => e.CvCode != "0003") văn phòng)
        </MudText>
    </MudStep>

    @* BƯỚC 3 (Bước 3 Sub-leader - chỉ hiện khi có công nhân) + Các approver *@
    <MudStep Title="Người duyệt" Icon="@Icons.Material.Filled.VerifiedUser">
        <MudGrid>
            @* Flow giải thích *@
            <MudItem xs="12">
                <MudAlert Severity="Severity.Normal" Dense="true" Class="mb-2">
                    <b>Luồng duyệt:</b>
                    @if (_model.HasWorker)
                    {
                        <span> Bước 3 (Sub-leader) → </span>
                    }
                    <span>Bước 5 (Ast.Chief/Chief) → Bước 6 (A.MG/MG)</span>
                    @if (_needGM)
                    {
                        <span> → Bước 7 (GM)</span>
                    }
                </MudAlert>
            </MudItem>

            @* Level 1 - Sub-leader (chỉ khi có công nhân) *@
            @if (_model.HasWorker)
            {
                <MudItem xs="12">
                    <MudText Typo="Typo.subtitle2" Class="mb-1" Color="Color.Warning">
                        <MudIcon Icon="@Icons.Material.Filled.Engineering" Size="Size.Small" Class="mr-1" />
                        Bước 3 — Sub-leader / Leader <MudChip Size="Size.Small" Color="Color.Error">Bắt buộc (có công nhân)</MudChip>
                    </MudText>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudSelect T="string" Label="Chọn Sub-leader/Leader (*)"
                               @bind-Value="_model.Level1ApproveEmail"
                               Variant="Variant.Outlined" Margin="Margin.Dense"
                               ToStringFunc="@(e => _approverOptions.FirstOrDefault(a => a.ApproveLevelEmail == e)?.ApproveLevelName ?? e)">
                        @foreach (var a in _approverOptions.Where(x => x.ApproveLevel == 1))
                        {
                            <MudSelectItem Value="@a.ApproveLevelEmail">
                                @a.ApproveLevelName (@a.RoleName)
                            </MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
            }

            @* Level 2 - Ast.Chief / Chief *@
            <MudItem xs="12">
                <MudText Typo="Typo.subtitle2" Class="mb-1 mt-2">
                    <MudIcon Icon="@Icons.Material.Filled.SupervisorAccount" Size="Size.Small" Class="mr-1" />
                    Bước 5 — Ast. Chief / Chief <MudChip Size="Size.Small" Color="Color.Error">Bắt buộc</MudChip>
                </MudText>
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudSelect T="string" Label="Chọn Ast.Chief/Chief (*)"
                           @bind-Value="_model.Level2ApproveEmail"
                           Variant="Variant.Outlined" Margin="Margin.Dense">
                    @foreach (var a in _approverOptions.Where(x => x.ApproveLevel == 2))
                    {
                        <MudSelectItem Value="@a.ApproveLevelEmail">
                            @a.ApproveLevelName (@a.RoleName)
                        </MudSelectItem>
                    }
                </MudSelect>
            </MudItem>

            @* Level 3 - A.MG / MG *@
            <MudItem xs="12">
                <MudText Typo="Typo.subtitle2" Class="mb-1 mt-2">
                    <MudIcon Icon="@Icons.Material.Filled.ManageAccounts" Size="Size.Small" Class="mr-1" />
                    Bước 6 — A.MG / MG <MudChip Size="Size.Small" Color="Color.Error">Bắt buộc</MudChip>
                </MudText>
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudSelect T="string" Label="Chọn A.MG/MG (*)"
                           @bind-Value="_model.Level3ApproveEmail"
                           Variant="Variant.Outlined" Margin="Margin.Dense">
                    @foreach (var a in _approverOptions.Where(x => x.ApproveLevel == 3))
                    {
                        <MudSelectItem Value="@a.ApproveLevelEmail">
                            @a.ApproveLevelName (@a.RoleName)
                        </MudSelectItem>
                    }
                </MudSelect>
            </MudItem>

            @* Level 4 - GM (điều kiện) *@
            @if (_needGM)
            {
                <MudItem xs="12">
                    <MudText Typo="Typo.subtitle2" Class="mb-1 mt-2" Color="Color.Secondary">
                        <MudIcon Icon="@Icons.Material.Filled.Stars" Size="Size.Small" Class="mr-1" />
                        Bước 7 — GM
                        <MudTooltip Text="@_gmReason">
                            <MudChip Size="Size.Small" Color="Color.Warning">Bắt buộc (@_gmReason)</MudChip>
                        </MudTooltip>
                    </MudText>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudSelect T="string" Label="Chọn GM (*)"
                               @bind-Value="_model.Level4ApproveEmail"
                               Variant="Variant.Outlined" Margin="Margin.Dense">
                        @foreach (var a in _approverOptions.Where(x => x.ApproveLevel == 4))
                        {
                            <MudSelectItem Value="@a.ApproveLevelEmail">
                                @a.ApproveLevelName (@a.RoleName)
                            </MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
            }
        </MudGrid>
    </MudStep>

    @* BƯỚC 4: Xác nhận + Submit *@
    <MudStep Title="Xác nhận" Icon="@Icons.Material.Filled.CheckCircle">
        <MudGrid>
            <MudItem xs="12" sm="6">
                <MudPaper Elevation="0" Class="pa-4 mud-background-gray rounded">
                    <MudText Typo="Typo.subtitle2" Class="mb-2">📋 Thông tin OT</MudText>
                    <MudStack Spacing="1">
                        <MudText Typo="Typo.body2">
                            <b>Ngày:</b> @_model.OTDate.ToString("dd/MM/yyyy (dddd)")
                        </MudText>
                        <MudText Typo="Typo.body2">
                            <b>Giờ:</b> @_startTime?.ToString(@"hh\:mm") → @_endTime?.ToString(@"hh\:mm")
                            (@_model.PlannedHours h)
                        </MudText>
                        <MudText Typo="Typo.body2">
                            <b>Loại:</b> @OTTypeConst.GetDisplayName(_model.OTType)
                        </MudText>
                        <MudText Typo="Typo.body2">
                            <b>Lý do:</b> @_model.OTReason
                        </MudText>
                        <MudText Typo="Typo.body2">
                            <b>Nhân viên:</b> @_model.Employees.Count người
                        </MudText>
                    </MudStack>
                </MudPaper>
            </MudItem>

            <MudItem xs="12" sm="6">
                <MudPaper Elevation="0" Class="pa-4 mud-background-gray rounded">
                    <MudText Typo="Typo.subtitle2" Class="mb-2">✅ Luồng duyệt</MudText>
                    <MudTimeline TimelineAlign="TimelineAlign.Start" Dense="true">
                        @if (_model.HasWorker && !string.IsNullOrEmpty(_model.Level1ApproveName))
                        {
                            <MudTimelineItem Color="Color.Warning" Size="Size.Small">
                                <MudText Typo="Typo.body2">
                                    <b>Bước 3</b> - @_model.Level1ApproveName (Sub-leader)
                                </MudText>
                            </MudTimelineItem>
                        }
                        @if (!string.IsNullOrEmpty(_model.Level2ApproveName))
                        {
                            <MudTimelineItem Color="Color.Info" Size="Size.Small">
                                <MudText Typo="Typo.body2">
                                    <b>Bước 5</b> - @_model.Level2ApproveName (Ast.Chief)
                                </MudText>
                            </MudTimelineItem>
                        }
                        @if (!string.IsNullOrEmpty(_model.Level3ApproveName))
                        {
                            <MudTimelineItem Color="Color.Secondary" Size="Size.Small">
                                <MudText Typo="Typo.body2">
                                    <b>Bước 6</b> - @_model.Level3ApproveName (A.MG/MG)
                                </MudText>
                            </MudTimelineItem>
                        }
                        @if (_needGM && !string.IsNullOrEmpty(_model.Level4ApproveName))
                        {
                            <MudTimelineItem Color="Color.Success" Size="Size.Small">
                                <MudText Typo="Typo.body2">
                                    <b>Bước 7</b> - @_model.Level4ApproveName (GM)
                                </MudText>
                            </MudTimelineItem>
                        }
                    </MudTimeline>
                </MudPaper>
            </MudItem>

            <MudItem xs="12" Class="d-flex justify-center mt-4">
                <MudButton Variant="Variant.Filled" Color="Color.Warning"
                           Size="Size.Large"
                           StartIcon="@Icons.Material.Filled.Send"
                           Disabled="@_isSubmitting"
                           OnClick="SubmitOT">
                    @(_isSubmitting ? "Đang gửi..." : "GỬI ĐƠN OT")
                </MudButton>
            </MudItem>
        </MudGrid>
    </MudStep>

</MudStepper>

@code {
    private MudStepper? _stepper;
    private CreateOTRequestModel _model = new();

    private DateTime? _otDate = DateTime.Today;
    private TimeSpan? _startTime;
    private TimeSpan? _endTime;
    private bool _isSubmitting;
    private bool _needGM;
    private string _gmReason = string.Empty;
    private string _searchEmp = string.Empty;

    // Danh sách approver từ API
    private List<F03OTApproverOption> _approverOptions = new();

    private IEnumerable<OTEmployeeModel> FilteredEmployees =>
        string.IsNullOrWhiteSpace(_searchEmp)
            ? _model.Employees
            : _model.Employees.Where(e =>
                e.EmployeeCode.Contains(_searchEmp, StringComparison.OrdinalIgnoreCase) ||
                (e.EmployeeName?.Contains(_searchEmp, StringComparison.OrdinalIgnoreCase) ?? false));

    protected override async Task OnInitializedAsync()
    {
        _model.DeptCode = CurrentUser.User?.DeptCode ?? string.Empty;

        // Load approvers
        try
        {
            _approverOptions = await OTService.GetApproversAsync(_model.DeptCode);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "[OT-CREATE] Load approvers failed");
        }
    }

    private void RecalculateHours()
    {
        if (_startTime.HasValue && _endTime.HasValue && _endTime > _startTime)
        {
            _model.PlannedHours = (decimal)(_endTime.Value - _startTime.Value).TotalHours;
            _model.StartTime = _startTime.Value;
            _model.EndTime   = _endTime.Value;
        }

        if (_otDate.HasValue)
            _model.OTDate = _otDate.Value;
    }

    private void RecalculateGM()
    {
        var distinctDepts = _model.Employees.Select(e => e.DeptCode).Distinct().Count();

        if (_model.OTType is OTTypeConst.Weekend or OTTypeConst.Holiday)
        {
            _needGM   = true;
            _gmReason = "Cuối tuần / Ngày lễ";
        }
        else if (distinctDepts >= 3)
        {
            _needGM   = true;
            _gmReason = "Ngày thường 3 bộ phận trở lên";
        }
        else
        {
            _needGM   = false;
            _gmReason = string.Empty;
        }
    }

    private void RemoveEmployee(OTEmployeeModel emp)
    {
        _model.Employees.Remove(emp);
        RecalculateGM();
    }

    private async Task OpenAddEmployeeDialog()
    {
        // TODO: Mở Dialog chọn nhân viên từ danh sách
        // Sau khi chọn, gọi _model.Employees.Add(...)
        // RecalculateGM()
        Snackbar.Add("Mở dialog chọn nhân viên (cần implement SearchEmployeeDialog)", Severity.Info);
    }

    private async Task LoadAllDeptEmployees()
    {
        try
        {
            var result = await OTService.GetDeptEmployeesAsync(_model.DeptCode);
            foreach (var emp in result)
            {
                if (!_model.Employees.Any(e => e.EmployeeCode == emp.EmployeeCode))
                    _model.Employees.Add(emp);
            }
            RecalculateGM();
            Snackbar.Add($"Đã thêm {result.Count} nhân viên từ bộ phận.", Severity.Success);
        }
        catch
        {
            Snackbar.Add("Không thể tải danh sách nhân viên.", Severity.Error);
        }
    }

    private async Task SubmitOT()
    {
        RecalculateHours();

        if (_model.Employees.Count == 0)
        {
            Snackbar.Add("Vui lòng thêm ít nhất 1 nhân viên.", Severity.Warning);
            return;
        }

        _isSubmitting = true;
        try
        {
            var result = await OTService.CreateOTAsync(_model);
            if (result.IsSuccess)
            {
                Snackbar.Add($"✅ {result.Message}", Severity.Success);
                Nav.NavigateTo("/ot/history");
            }
            else
            {
                Snackbar.Add($"❌ {result.Message}", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "[OT-CREATE] Submit failed");
            Snackbar.Add("Lỗi kết nối máy chủ.", Severity.Error);
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    // Helper class để hiện trong select
    public class F03OTApproverOption
    {
        public int ApproveLevel { get; set; }
        public string? RoleName { get; set; }
        public string ApproveLevelCode { get; set; } = string.Empty;
        public string ApproveLevelName { get; set; } = string.Empty;
        public string ApproveLevelEmail { get; set; } = string.Empty;
    }
}
