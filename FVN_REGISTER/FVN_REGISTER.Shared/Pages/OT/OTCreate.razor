@page "/ot/create"
@attribute [Authorize]
@using FVN_REGISTER.Contract.Dtos.OT
@using FVN_REGISTER.Contract.Dtos.OTTypeDtos
@using FVN_REGISTER.Contract.Dtos.ApprovelSnapshotDto
@using FVN_REGISTER.Contract.Requests.OT
@using FVN_REGISTER.Core.Enums
@using FVN_REGISTER.Shared.Services.OTs
@using FVN_REGISTER.Shared.Services.Users
@using FVN_REGISTER.Shared.Utils.Helpers
@using Microsoft.AspNetCore.Authorization
@inherits AppComponentBase
@implements IDisposable

@inject IOTClientService OTService
@inject ICurrentUserClientService CurrentUser
@inject ISnackbar Snackbar
@inject NavigationManager Nav

<PageTitle>Tạo đơn OT</PageTitle>

<MudText Typo="Typo.h5" Class="mb-1"><MudIcon Icon="@Icons.Material.Filled.MoreTime" Class="mr-2" />Tạo đơn Tăng ca (OT)</MudText>
<MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">Đăng ký làm thêm giờ theo nhân viên.</MudText>

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Class="mb-4" />
}
else if (_form != null)
{
    <MudGrid>
        <MudItem xs="12" md="8">
            <MudCard Elevation="2" Class="pa-4">
                <MudText Typo="Typo.subtitle1" Class="mb-3">Thông tin đơn</MudText>
                <MudGrid>
                    <MudItem xs="12" sm="4"><MudDatePicker @bind-Date="_date" Label="Ngày OT (*)" Variant="Variant.Outlined" Required="true" /></MudItem>
                    <MudItem xs="6" sm="4"><MudTimePicker @bind-Time="_start" Label="Giờ bắt đầu" Variant="Variant.Outlined" AmPm="false" /></MudItem>
                    <MudItem xs="6" sm="4"><MudTimePicker @bind-Time="_end" Label="Giờ kết thúc" Variant="Variant.Outlined" AmPm="false" /></MudItem>
                    <MudItem xs="12" sm="6">
                        <MudSelect T="string" @bind-Value="_form.OTTypeCode" Label="Loại OT (*)" Variant="Variant.Outlined" Required="true">
                            @foreach (var type in _otTypes)
                            {
                                <MudSelectItem Value="@type.OTTypeCode">@type.OTTypeName (@type.OTTypeCode)</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" sm="6"><MudTextField @bind-Value="_form.OTReasonSummary" Label="Lý do tổng quát" Variant="Variant.Outlined" /></MudItem>
                </MudGrid>
            </MudCard>

            <MudCard Elevation="2" Class="mt-4 pa-4">
                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-3">
                    <MudText Typo="Typo.subtitle1">Nhân viên tham gia (@_employees.Count)</MudText>
                    <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.PersonAdd" OnClick="AddDepartmentEmployees">Thêm nhân viên phòng ban</MudButton>
                </MudStack>

                @if (!_employees.Any())
                {
                    <MudAlert Severity="Severity.Info">Chưa có nhân viên. Bấm “Thêm nhân viên phòng ban”.</MudAlert>
                }
                else
                {
                    <MudTable Items="_employees" Dense="true" Hover="true">
                        <HeaderContent><MudTh>Nhân viên</MudTh><MudTh>Nội dung</MudTh><MudTh>Giờ</MudTh><MudTh></MudTh></HeaderContent>
                        <RowTemplate>
                            <MudTd><b>@context.EmployeeName</b><MudText Typo="Typo.caption">@context.EmployeeCode</MudText></MudTd>
                            <MudTd><MudTextField T="string" @bind-Value="context.OTReasonDetail" Label="Nội dung" Variant="Variant.Text" Margin="Margin.Dense" /></MudTd>
                            <MudTd>@context.OTHours.ToString("N1") h</MudTd>
                            <MudTd><MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" OnClick="@(() => RemoveEmployee(context))" /></MudTd>
                        </RowTemplate>
                    </MudTable>
                }
            </MudCard>

            <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" Size="Size.Large" Class="mt-4" StartIcon="@Icons.Material.Filled.Send" OnClick="Submit" Disabled="@(_submitting || !_approvalSteps.Any())">
                @(_submitting ? "Đang gửi..." : "GỬI ĐƠN OT")
            </MudButton>
        </MudItem>

        <MudItem xs="12" md="4">
            @if (_balance != null)
            {
                <MudCard Elevation="2" Class="mb-4 pa-4">
                    <MudText Typo="Typo.subtitle1">Số dư giờ OT @DateTime.Now.Year</MudText>
                    <MudText Typo="Typo.body2">Năm: @_balance.UsedHoursThisYear / @_balance.YearlyLimit h</MudText>
                    <MudProgressLinear Value="@_balance.YearlyUsedPercent" Color="@(_balance.IsNearYearlyLimit ? Color.Warning : Color.Primary)" Class="my-2" />
                    <MudText Typo="Typo.body2">Tháng: @_balance.UsedHoursThisMonth / @_balance.MonthlyLimit h</MudText>
                    <MudText Typo="Typo.body2">Còn lại năm: @_balance.RemainingYearly h</MudText>
                </MudCard>
            }

            <MudCard Elevation="2">
                <MudCardHeader><CardHeaderContent><MudText Typo="Typo.subtitle1">Đơn OT gần đây</MudText></CardHeaderContent></MudCardHeader>
                <MudList T="OTSummaryDto" Dense="true">
                    @foreach (var request in _recent)
                    {
                        <MudListItem T="OTSummaryDto" OnClick="@(() => Nav.NavigateTo($"/ot/detail/{request.Id}"))">
                            <MudText Typo="Typo.body2">@request.OTDate.ToString("dd/MM/yyyy") — @request.TotalHours.ToString("N1") h</MudText>
                            <MudText Typo="Typo.caption">@request.Status</MudText>
                        </MudListItem>
                    }
                </MudList>
            </MudCard>
        </MudItem>
    </MudGrid>
}

@code {
    private OTRequestUpsertDto? _form;
    private List<OTEmployeeDto> _employees = new();
    private List<OTTypeDto> _otTypes = new();
    private List<ApprovalStepSnapshotDto> _approvalSteps = new();
    private List<OTSummaryDto> _recent = new();
    private OTBalanceDto? _balance;
    private DateTime? _date = DateTime.Today;
    private TimeSpan? _start = new(17, 30, 0);
    private TimeSpan? _end = new(20, 30, 0);
    private bool _loading = true;
    private bool _submitting;
    private readonly CancellationTokenSource _cts = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            if (!CurrentUser.IsLoggedIn) await CurrentUser.InitializeAsync();
            var combined = await OTService.GetCombinedDataAsync(_cts.Token);
            if (!combined.IsSuccess || combined.Data == null)
            {
                Snackbar.Add(combined.Message ?? "Không tải được dữ liệu OT.", Severity.Error);
                return;
            }

            _form = combined.Data.OTForm;
            _recent = combined.Data.RecentOTRequests;
            _balance = combined.Data.Balance;
            _approvalSteps = combined.Data.ApprovalSteps;

            var types = await OTService.GetActiveOTTypesAsync(_cts.Token);
            if (types.IsSuccess && types.Data != null)
                _otTypes = types.Data;
            else
                Snackbar.Add(types.Message ?? "Không tải được danh mục loại OT.", Severity.Warning);

            if (_date.HasValue) _form.OTDate = _date.Value;
            _form.EmployeeCode = CurrentUser.User?.EmployeeCode ?? _form.EmployeeCode;
            _form.DeptCode = CurrentUser.User?.DeptCode ?? _form.DeptCode;
            _form.PositionCode = CurrentUser.User?.PositionCode ?? _form.PositionCode;
            _form.StartTime = _start ?? TimeSpan.Zero;
            _form.EndTime = _end ?? TimeSpan.Zero;
            if (string.IsNullOrWhiteSpace(_form.OTTypeCode))
                _form.OTTypeCode = _otTypes.FirstOrDefault()?.OTTypeCode ?? string.Empty;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "[OT_CREATE] Init error");
            Snackbar.Add("Lỗi tải dữ liệu OT.", Severity.Error);
        }
        finally { _loading = false; }
    }

    private async Task AddDepartmentEmployees()
    {
        if (_form == null) return;
        var result = await OTService.GetDeptEmployeesAsync(_form.DeptCode, _cts.Token);
        if (!result.IsSuccess || result.Data == null) { Snackbar.Add(result.Message ?? "Không tải được nhân viên.", Severity.Warning); return; }
        foreach (var source in result.Data)
        {
            if (_employees.Any(x => x.EmployeeCode == source.EmployeeCode)) continue;
            _employees.Add(new OTEmployeeDto
            {
                EmployeeCode = source.EmployeeCode, EmployeeName = source.EmployeeName, DeptCode = source.DeptCode,
                DeptName = source.DeptName, CvCode = source.CvCode, OTTypeCode = _form.OTTypeCode,
                StartTime = _start ?? TimeSpan.Zero, EndTime = _end ?? TimeSpan.Zero,
                OTHours = CalculateHours(_start, _end)
            });
        }
        _approvalSteps.Clear();
    }

    private void RemoveEmployee(OTEmployeeDto employee)
    {
        _employees.Remove(employee);
        _approvalSteps.Clear();
    }

    private async Task Submit()
    {
        if (_form == null || !_date.HasValue || !_start.HasValue || !_end.HasValue || _end <= _start || !_employees.Any())
        {
            Snackbar.Add("Vui lòng kiểm tra ngày, giờ OT và danh sách nhân viên.", Severity.Warning);
            return;
        }
        _form.OTDate = _date.Value;
        _form.StartTime = _start.Value;
        _form.EndTime = _end.Value;
        foreach (var employee in _employees)
        {
            employee.OTTypeCode = _form.OTTypeCode;
            employee.StartTime = _start.Value;
            employee.EndTime = _end.Value;
            employee.OTHours = CalculateHours(_start, _end);
        }
        _form.Employees = _employees;

        // Controller hiện tại không có endpoint /preview. Validate từng nhân viên
        // qua POST /api/ot/validate trước khi gọi POST /api/ot/create.
        foreach (var employee in _employees)
        {
            var validation = await OTService.ValidateOTHoursAsync(
                employee.EmployeeCode,
                _form.OTDate,
                employee.OTHours,
                _form.OTTypeCode,
                _cts.Token);

            if (!validation.IsSuccess || validation.Data == null || !validation.Data.IsValid)
            {
                var message = validation.Data?.Message
                    ?? validation.Data?.Errors.FirstOrDefault()
                    ?? validation.Message
                    ?? $"Giờ OT của {employee.EmployeeCode} không hợp lệ.";

                Snackbar.Add(message, Severity.Warning);
                return;
            }
        }

        _submitting = true;
        try
        {
            var result = await OTService.CreateOTRequestAsync(_form, _cts.Token);
            Snackbar.Add(result.IsSuccess ? "Đã gửi đơn OT thành công." : result.Message ?? "Gửi đơn thất bại.", result.IsSuccess ? Severity.Success : Severity.Error);
            if (result.IsSuccess) Nav.NavigateTo("/history/ot");
        }
        finally { _submitting = false; }
    }

    private static decimal CalculateHours(TimeSpan? start, TimeSpan? end) =>
        start.HasValue && end.HasValue && end > start ? (decimal)(end.Value - start.Value).TotalHours : 0m;

    public void Dispose() { _cts.Cancel(); _cts.Dispose(); }
}