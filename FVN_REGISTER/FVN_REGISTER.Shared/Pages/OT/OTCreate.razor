@page "/ot/create"
@attribute [Authorize]
@using FVN_REGISTER.Contract.Dtos.OT
@using FVN_REGISTER.Contract.ViewModels
@using FVN_REGISTER.Contract.Utils
@using FVN_REGISTER.Contract.ViewModels.OT
@using FVN_REGISTER.Shared.Services.OT
@using FVN_REGISTER.Shared.Services.Users
@using FVN_REGISTER.Shared.Utils.Helpers
@using Microsoft.AspNetCore.Authorization
@inherits AppComponentBase

@inject IOTClientService OTService
@inject ICurrentUserClientService CurrentUser
@inject ISnackbar Snackbar
@inject NavigationManager Nav

<PageTitle>Tạo đơn OT</PageTitle>

<MudText Typo="Typo.h5" Class="mb-1">
    <MudIcon Icon="@Icons.Material.Filled.MoreTime" Class="mr-2" />
    Tạo đơn Tăng ca (OT)
</MudText>
<MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">
    1 đơn OT có thể áp dụng cho nhiều nhân viên cùng bộ phận
</MudText>

@if (_isLoading)
{
    <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="mb-4" />
}
else if (_model != null)
{
    <MudGrid>
        @* ===== LEFT: FORM =====  *@
        <MudItem xs="12" md="8">
            <MudStepper @ref="_stepper" NonLinear="false" Color="Color.Primary" Class="mb-4">

                @* STEP 1: Phạm vi áp dụng *@
                <MudStep Title="Phạm vi & Nhân viên" Icon="@Icons.Material.Filled.People">
                    <MudCard Elevation="2" Class="pa-4">
                        <MudCardContent>
                            <MudText Typo="Typo.subtitle1" Class="mb-3">
                                <MudIcon Icon="@Icons.Material.Filled.Groups" Class="mr-1" />
                                Chọn phạm vi áp dụng
                            </MudText>

                            <MudGrid>
                                <MudItem xs="12" sm="6">
                                    <MudDatePicker Label="Ngày OT (*)"
                                                   @bind-Date="_otDate"
                                                   Variant="Variant.Outlined"
                                                   Margin="Margin.Dense"
                                                   DateFormat="dd/MM/yyyy"
                                                   Required="true"
                                                   Class="mb-3" />
                                </MudItem>
                                <MudItem xs="6" sm="3">
                                    <MudTimePicker Label="Giờ bắt đầu (*)"
                                                   @bind-Time="_startTime"
                                                   Variant="Variant.Outlined"
                                                   Margin="Margin.Dense"
                                                   Class="mb-3" />
                                </MudItem>
                                <MudItem xs="6" sm="3">
                                    <MudTimePicker Label="Giờ kết thúc (*)"
                                                   @bind-Time="_endTime"
                                                   Variant="Variant.Outlined"
                                                   Margin="Margin.Dense"
                                                   Class="mb-3" />
                                </MudItem>
                            </MudGrid>

                            @if (_otDate.HasValue && _startTime.HasValue && _endTime.HasValue)
                            {
                                var hours = (_endTime.Value - _startTime.Value).TotalHours;
                                <MudAlert Severity="@(hours > 4 ? Severity.Warning : Severity.Info)"
                                          Class="mb-3" Dense="true">
                                    Tổng giờ OT: <strong>@hours.ToString("N1") giờ</strong>
                                    @if (hours > 4)
                                    {
                                        <span> — Vượt giới hạn 4h/ngày!</span>
                                    }
                                </MudAlert>
                            }

                            <MudSelect T="string" Label="Loại OT (*)"
                                       @bind-Value="_model.OTTypeCode"
                                       Variant="Variant.Outlined"
                                       Margin="Margin.Dense"
                                       Class="mb-3">
                                <MudSelectItem Value="@OTTypeConst.Weekday">Ngày thường</MudSelectItem>
                                <MudSelectItem Value="@OTTypeConst.Weekend">Cuối tuần</MudSelectItem>
                                <MudSelectItem Value="@OTTypeConst.Holiday">Ngày lễ</MudSelectItem>
                            </MudSelect>

                            <MudTextField T="string" Label="Lý do OT (*)"
                                          @bind-Value="_model.Reason"
                                          Variant="Variant.Outlined"
                                          Margin="Margin.Dense"
                                          Lines="3"
                                          Class="mb-3" />

                            @* Danh sách nhân viên *@
                            <MudDivider Class="my-3" />
                            <MudText Typo="Typo.subtitle2" Class="mb-2">Nhân viên tham gia OT</MudText>

                            @foreach (var emp in _selectedEmployees)
                            {
                                <MudPaper Elevation="0" Class="pa-2 mb-2" Style="border: 1px solid var(--mud-palette-divider); border-radius: 8px;">
                                    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                                        <MudStack Row="true" AlignItems="AlignItems.Center">
                                            <MudAvatar Color="Color.Primary" Size="Size.Small">
                                                @emp.EmployeeName?.FirstOrDefault()
                                            </MudAvatar>
                                            <div>
                                                <MudText Typo="Typo.body2"><strong>@emp.EmployeeName</strong></MudText>
                                                <MudText Typo="Typo.caption" Color="Color.Secondary">@emp.EmployeeCode — @emp.DeptName</MudText>
                                            </div>
                                        </MudStack>
                                        <MudStack Row="true" AlignItems="AlignItems.Center">
                                            <MudNumericField T="decimal"
                                                             @bind-Value="emp.OTHours"
                                                             Label="Giờ OT"
                                                             Variant="Variant.Outlined"
                                                             Margin="Margin.Dense"
                                                             Min="0.5m" Max="8m" Step="0.5m"
                                                             Style="width: 100px;" />
                                            <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                                           Color="Color.Error"
                                                           Size="Size.Small"
                                                           OnClick="@(() => RemoveEmployee(emp))" />
                                        </MudStack>
                                    </MudStack>
                                </MudPaper>
                            }

                            <MudButton Variant="Variant.Outlined"
                                       Color="Color.Primary"
                                       StartIcon="@Icons.Material.Filled.PersonAdd"
                                       OnClick="OpenEmployeePicker"
                                       Class="mt-2">
                                Thêm nhân viên
                            </MudButton>
                        </MudCardContent>
                    </MudCard>
                </MudStep>

                @* STEP 2: Chọn Approver *@
                <MudStep Title="Phân cấp duyệt" Icon="@Icons.Material.Filled.VerifiedUser">
                    <MudCard Elevation="2" Class="pa-4">
                        <MudCardContent>
                            <MudText Typo="Typo.subtitle1" Class="mb-3">Cấu hình luồng phê duyệt OT</MudText>

                            @foreach (var step in _model.ApprovalSteps)
                            {
                                <MudPaper Elevation="0" Class="pa-3 mb-3"
                                          Style="border-left: 4px solid var(--mud-palette-primary); border-radius: 4px; background: var(--mud-palette-background-grey);">
                                    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                                        <div>
                                            <MudChip T="string" Size="Size.Small" Color="Color.Primary" Label="true">
                                                Bước @step.Level
                                            </MudChip>
                                            <MudText Typo="Typo.body2" Class="mt-1"><strong>@step.LevelName</strong></MudText>
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">@step.ApproverName — @step.ApproverEmail</MudText>
                                        </div>
                                        <MudIcon Icon="@Icons.Material.Filled.CheckCircleOutline" Color="Color.Success" />
                                    </MudStack>
                                </MudPaper>
                            }

                            @if (!_model.ApprovalSteps.Any())
                            {
                                <MudAlert Severity="Severity.Warning">
                                    Không tìm thấy cấu hình approver cho bộ phận này. Vui lòng liên hệ HR.
                                </MudAlert>
                            }
                        </MudCardContent>
                    </MudCard>
                </MudStep>

                @* STEP 3: Xác nhận *@
                <MudStep Title="Xác nhận & Gửi" Icon="@Icons.Material.Filled.Send">
                    <MudCard Elevation="2" Class="pa-4">
                        <MudCardContent>
                            <MudText Typo="Typo.subtitle1" Class="mb-3">Xác nhận thông tin đơn OT</MudText>

                            <MudSimpleTable Dense="true" Hover="true" Class="mb-3">
                                <tbody>
                                    <tr><td><strong>Ngày OT</strong></td><td>@(_otDate?.ToString("dd/MM/yyyy"))</td></tr>
                                    <tr><td><strong>Giờ OT</strong></td><td>@(_startTime?.ToString(@"hh\:mm")) → @(_endTime?.ToString(@"hh\:mm"))</td></tr>
                                    <tr><td><strong>Loại OT</strong></td><td>@_model.OTTypeCode</td></tr>
                                    <tr><td><strong>Số nhân viên</strong></td><td>@_selectedEmployees.Count người</td></tr>
                                    <tr><td><strong>Lý do</strong></td><td>@_model.Reason</td></tr>
                                </tbody>
                            </MudSimpleTable>

                            @* Validate warnings *@
                            @if (_validationResult != null && !_validationResult.IsValid)
                            {
                                <MudAlert Severity="Severity.Error" Class="mb-3">
                                    <strong>Cảnh báo vượt giới hạn:</strong>
                                    @foreach (var v in _validationResult.EmployeeResults)
                                    {
                                        <div>• @v.ViolationType: @v.CurrentUsed/@v.Limit giờ</div>
                                    }
                                </MudAlert>
                            }

                            <MudButton Variant="Variant.Filled"
                                       Color="Color.Primary"
                                       StartIcon="@Icons.Material.Filled.Send"
                                       OnClick="SubmitOT"
                                       Disabled="_isSubmitting || (_validationResult != null && !_validationResult.IsValid)"
                                       FullWidth="true"
                                       Size="Size.Large">
                                @(_isSubmitting ? "Đang gửi..." : "GỬI ĐƠN OT")
                            </MudButton>
                        </MudCardContent>
                    </MudCard>
                </MudStep>

            </MudStepper>
        </MudItem>

        @* ===== RIGHT: BALANCE PANEL ===== *@
        <MudItem xs="12" md="4">
            <MudCard Elevation="2" Class="mb-3">
                <MudCardHeader>
                    <CardHeaderContent>
                        <MudText Typo="Typo.subtitle1">
                            <MudIcon Icon="@Icons.Material.Filled.BarChart" Class="mr-1" />
                            Số dư giờ OT năm @DateTime.Now.Year
                        </MudText>
                    </CardHeaderContent>
                </MudCardHeader>
                <MudCardContent>
                    @if (_model.Balance != null)
                    {
                        <MudStack Spacing="2">
                            <div>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">Tổng được phép (năm)</MudText>
                                <MudText Typo="Typo.h6">@_model.Balance.YearlyLimit giờ</MudText>
                            </div>
                            <MudProgressLinear Value="@((double)(_model.Balance.UsedHours / _model.Balance.YearlyLimit * 100))"
                                               Color="@(_model.Balance.RemainingYearly < 20 ? Color.Error : Color.Primary)"
                                               Rounded="true" Size="Size.Medium" />
                            <MudStack Row="true" Justify="Justify.SpaceBetween">
                                <div>
                                    <MudText Typo="Typo.caption">Đã dùng</MudText>
                                    <MudText Typo="Typo.body1" Color="Color.Error"><strong>@_model.Balance.UsedHours h</strong></MudText>
                                </div>
                                <div class="text-right">
                                    <MudText Typo="Typo.caption">Còn lại</MudText>
                                    <MudText Typo="Typo.body1" Color="Color.Success"><strong>@_model.Balance.RemainingYearly h</strong></MudText>
                                </div>
                            </MudStack>
                            <MudDivider />
                            <MudStack Row="true" Justify="Justify.SpaceBetween">
                                <MudText Typo="Typo.caption">Giới hạn ngày</MudText>
                                <MudChip T="string" Size="Size.Small" Color="Color.Info" Label="true">
                                    @_model.Balance.DailyLimit h/ngày
                                </MudChip>
                            </MudStack>
                        </MudStack>
                    }
                </MudCardContent>
            </MudCard>

            @* Lịch sử gần đây *@
            <MudCard Elevation="2">
                <MudCardHeader>
                    <CardHeaderContent>
                        <MudText Typo="Typo.subtitle1">
                            <MudIcon Icon="@Icons.Material.Filled.History" Class="mr-1" />
                            Đơn OT gần đây
                        </MudText>
                    </CardHeaderContent>
                </MudCardHeader>
                <MudCardContent Class="pa-0">
                    @if (_recentRequests.Any())
                    {
                        <MudList T="OTRequestViewModel" Dense="true">
                            @foreach (var req in _recentRequests)
                            {
                                <MudListItem T="OTRequestViewModel"
                                             OnClick="@(() => Nav.NavigateTo($"/ot/detail/{req.Id}"))">
                                    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                                        <div>
                                            <MudText Typo="Typo.body2">@req.OTDate.ToString("dd/MM/yyyy")</MudText>
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">@req.TotalOTHours h — @req.OTTypeName</MudText>
                                        </div>
                                        <MudChip T="string" Size="Size.Small"
                                                 Color="@GetStatusColor(req.RequestStatus)"
                                                 Label="true">
                                            @GetStatusText(req.RequestStatus)
                                        </MudChip>
                                    </MudStack>
                                </MudListItem>
                            }
                        </MudList>
                    }
                    else
                    {
                        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="pa-4">Chưa có đơn OT nào.</MudText>
                    }
                </MudCardContent>
            </MudCard>
        </MudItem>
    </MudGrid>
}

@code {
    private bool _isLoading = true;
    private bool _isSubmitting = false;
    private CreateOTRequestModel? _model;
    private MudStepper? _stepper;
    private List<OTEmployeeModel> _selectedEmployees = new();
    private List<OTRequestViewModel> _recentRequests = new();
    private OTValidationResultDto? _validationResult;

    private DateTime? _otDate = DateTime.Today;
    private TimeSpan? _startTime;
    private TimeSpan? _endTime;

    private CancellationTokenSource _cts = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _isLoading = true;

            var combinedTask = OTService.GetCombinedDataAsync(_cts.Token);
            var recentTask = OTService.GetRecentOTRequestsAsync(5, _cts.Token);

            await Task.WhenAll(combinedTask, recentTask);

            var combined = await combinedTask;
            if (combined.IsSuccess && combined.Data != null)
            {
                _model = combined.Data;
                // Thêm chính mình vào danh sách nhân viên
                if (CurrentUser.User != null)
                {
                    _selectedEmployees.Add(new OTEmployeeModel
                    {
                        EmployeeCode = CurrentUser.User.EmployeeCode ?? "",
                        EmployeeName = CurrentUser.User.FullName ?? "",
                        DeptCode = CurrentUser.User.DeptCode ?? "",
                        OTHours = 0
                    });
                }
            }

            var recent = await recentTask;
            if (recent.IsSuccess && recent.Data != null)
                _recentRequests = recent.Data;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "[OT_CREATE] Init error");
            Snackbar.Add("Lỗi tải dữ liệu", Severity.Error);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void RemoveEmployee(OTEmployeeModel emp)
    {
        _selectedEmployees.Remove(emp);
    }

    private void OpenEmployeePicker()
    {
        // TODO: Mở dialog chọn nhân viên
        Snackbar.Add("Tính năng đang phát triển", Severity.Info);
    }

    private async Task SubmitOT()
    {
        if (_model == null || !_otDate.HasValue || !_startTime.HasValue || !_endTime.HasValue)
        {
            Snackbar.Add("Vui lòng điền đầy đủ thông tin", Severity.Warning);
            return;
        }

        if (!_selectedEmployees.Any())
        {
            Snackbar.Add("Phải có ít nhất 1 nhân viên OT", Severity.Warning);
            return;
        }

        _isSubmitting = true;
        try
        {
            _model.OTDate = _otDate.Value;
            _model.StartTime = _startTime.Value;
            _model.EndTime = _endTime.Value;
            _model.Employees = _selectedEmployees;

            var result = await OTService.CreateOTRequestAsync(_model, _cts.Token);

            if (result.IsSuccess)
            {
                Snackbar.Add("Đã gửi đơn OT thành công!", Severity.Success);
                Nav.NavigateTo("/ot/history");
            }
            else
            {
                Snackbar.Add(result.Message ?? "Lỗi gửi đơn OT", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "[OT_CREATE] Submit error");
            Snackbar.Add("Lỗi hệ thống", Severity.Error);
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private static Color GetStatusColor(string status) => status switch
    {
        "Approved" => Color.Success,
        "Rejected" => Color.Error,
        "Cancelled" => Color.Default,
        _ => Color.Warning
    };

    private static string GetStatusText(string status) => status switch
    {
        "Approved" => "Đã duyệt",
        "Rejected" => "Từ chối",
        "Cancelled" => "Đã hủy",
        "ApprovedLv3" => "Lv3 duyệt",
        "ApprovedLv5" => "Lv5 duyệt",
        "ApprovedLv6" => "Lv6 duyệt",
        _ => "Chờ duyệt"
    };

    public void Dispose()
    {
        _cts.Cancel();
        _cts.Dispose();
    }
}
