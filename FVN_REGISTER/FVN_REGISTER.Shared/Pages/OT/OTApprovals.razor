@page "/ot/approvals"
@attribute [Authorize]
@using FVN_REGISTER.Contract.ViewModels
@using FVN_REGISTER.Contract.Utils
@using FVN_REGISTER.Shared.Services.OT
@using FVN_REGISTER.Shared.Services.Users
@using FVN_REGISTER.Shared.Utils
@using FVN_REGISTER.Shared.Utils.Helpers
@using Microsoft.AspNetCore.Authorization
@inherits AppComponentBase

@inject IOTClientService OTService
@inject ICurrentUserClientService CurrentUser
@inject ISnackbar Snackbar
@inject NavigationManager Nav

<PageTitle>Phê duyệt OT</PageTitle>

<MudText Typo="Typo.h5" Class="mb-1">
    <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Class="mr-2" />
    Phê duyệt đơn OT
</MudText>
<MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">
    Danh sách đơn OT đang chờ phê duyệt
</MudText>

@* Level tabs *@
<MudTabs Elevation="2" Rounded="true" ApplyEffectsToContainer="true" Class="mb-4"
         @bind-ActivePanelIndex="_activeLevel">
    <MudTabPanel Text="Tất cả" Icon="@Icons.Material.Filled.AllInclusive">
        <OTApprovalList Items="_allPending"
                        IsLoading="_isLoading"
                        OnApprove="HandleApprove"
                        OnReject="HandleReject"
                        OnViewDetail="ViewDetail" />
    </MudTabPanel>
    <MudTabPanel Text="Bước 3 - Sub-leader" Icon="@Icons.Material.Filled.SupervisorAccount">
        <OTApprovalList Items="@(_allPending.Where(x => NeedApproveLevel(x, 3)).ToList())"
                        Level="3"
                        IsLoading="_isLoading"
                        OnApprove="HandleApprove"
                        OnReject="HandleReject"
                        OnViewDetail="ViewDetail" />
    </MudTabPanel>
    <MudTabPanel Text="Bước 5 - Chief" Icon="@Icons.Material.Filled.ManageAccounts">
        <OTApprovalList Items="@(_allPending.Where(x => NeedApproveLevel(x, 5)).ToList())"
                        Level="5"
                        IsLoading="_isLoading"
                        OnApprove="HandleApprove"
                        OnReject="HandleReject"
                        OnViewDetail="ViewDetail" />
    </MudTabPanel>
    <MudTabPanel Text="Bước 6 - MG" Icon="@Icons.Material.Filled.AdminPanelSettings">
        <OTApprovalList Items="@(_allPending.Where(x => NeedApproveLevel(x, 6)).ToList())"
                        Level="6"
                        IsLoading="_isLoading"
                        OnApprove="HandleApprove"
                        OnReject="HandleReject"
                        OnViewDetail="ViewDetail" />
    </MudTabPanel>
    <MudTabPanel Text="Bước 7 - GM" Icon="@Icons.Material.Filled.Business">
        <OTApprovalList Items="@(_allPending.Where(x => NeedApproveLevel(x, 7)).ToList())"
                        Level="7"
                        IsLoading="_isLoading"
                        OnApprove="HandleApprove"
                        OnReject="HandleReject"
                        OnViewDetail="ViewDetail" />
    </MudTabPanel>
</MudTabs>

@* Approve Dialog *@
<MudDialog @bind-IsVisible="_showCommentDialog">
    <TitleContent>
        <MudText Typo="Typo.h6">
            @(_isApproving ? "Phê duyệt" : "Từ chối") đơn OT
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudTextField T="string"
                      Label="@(_isApproving ? "Ghi chú (tùy chọn)" : "Lý do từ chối (*)")"
                      @bind-Value="_comment"
                      Variant="Variant.Outlined"
                      Lines="3"
                      Required="@(!_isApproving)" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => _showCommentDialog = false)">Hủy</MudButton>
        <MudButton Variant="Variant.Filled"
                   Color="@(_isApproving ? Color.Success : Color.Error)"
                   OnClick="ConfirmAction"
                   Disabled="_isProcessing">
            @(_isProcessing ? "Đang xử lý..." : (_isApproving ? "Phê duyệt" : "Từ chối"))
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    private bool _isLoading = true;
    private int _activeLevel = 0;
    private List<OTRequestViewModel> _allPending = new();
    private List<int> _selectedIds = new();
    private bool _showCommentDialog = false;
    private bool _isApproving = true;
    private bool _isProcessing = false;
    private string _comment = string.Empty;
    private int _actionLevel = 0;
    private CancellationTokenSource _cts = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadPending();
    }

    private async Task LoadPending()
    {
        _isLoading = true;
        try
        {
            var result = await OTService.GetPendingApprovalsAsync(0, _cts.Token);
            if (result.IsSuccess && result.Data != null)
                _allPending = result.Data;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "[OT_APPROVE] Load error");
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void HandleApprove((int id, int level) args)
    {
        _selectedIds = new List<int> { args.id };
        _actionLevel = args.level;
        _isApproving = true;
        _comment = string.Empty;
        _showCommentDialog = true;
    }

    private void HandleReject((int id, int level) args)
    {
        _selectedIds = new List<int> { args.id };
        _actionLevel = args.level;
        _isApproving = false;
        _comment = string.Empty;
        _showCommentDialog = true;
    }

    private void ViewDetail(int id) => Nav.NavigateTo($"/ot/detail/{id}");

    private async Task ConfirmAction()
    {
        if (!_isApproving && string.IsNullOrWhiteSpace(_comment))
        {
            Snackbar.Add("Vui lòng nhập lý do từ chối", Severity.Warning);
            return;
        }

        _isProcessing = true;
        try
        {
            var request = new OTApproveRequest
            {
                Ids = _selectedIds,
                Level = _actionLevel,
                Comment = _comment
            };

            var result = _isApproving
                ? await OTService.ApproveAsync(request, _cts.Token)
                : await OTService.RejectAsync(request, _cts.Token);

            if (result.IsSuccess)
            {
                Snackbar.Add(_isApproving ? "Đã phê duyệt thành công!" : "Đã từ chối.", Severity.Success);
                _showCommentDialog = false;
                await LoadPending();
            }
            else
            {
                Snackbar.Add(result.Message ?? "Có lỗi xảy ra", Severity.Error);
            }
        }
        finally
        {
            _isProcessing = false;
        }
    }

    private static bool NeedApproveLevel(OTRequestViewModel x, int level) => level switch
    {
        3 => x.Level3IsApprove == null,
        5 => x.Level3IsApprove == true && x.Level5IsApprove == null,
        6 => x.Level5IsApprove == true && x.Level6IsApprove == null,
        7 => x.Level6IsApprove == true && x.Level7IsApprove == null,
        _ => false
    };

    public void Dispose()
    {
        _cts.Cancel();
        _cts.Dispose();
    }
}
