@page "/ot/list"
@attribute [Authorize]
@using FVN_REGISTER.Contract.Dtos.Depts
@using FVN_REGISTER.Contract.Utils
@using FVN_REGISTER.Contract.ViewModels
@using FVN_REGISTER.Contract.ViewModels.OT
@using FVN_REGISTER.Shared.Components.OT
@using FVN_REGISTER.Shared.Services.OTs
@using FVN_REGISTER.Shared.Services.Users
@using FVN_REGISTER.Shared.Utils

@using FVN_REGISTER.Shared.Utils.Helpers
@using Microsoft.AspNetCore.Authorization
@* Bỏ @using FVN_REGISTER.Contract.Utils để tránh nhập nhằng PaginationResult.
   OTStatus vẫn dùng được qua fully-qualified hoặc thêm alias bên dưới *@
@using static FVN_REGISTER.Contract.Utils.OTStatus
@implements IDisposable
@inherits AppComponentBase
@inject IOTClientService OTService
@inject ICurrentUserClientService CurrentUser
@inject IDeptClientService DeptService
@inject ISnackbar Snackbar
@inject NavigationManager Nav
@inject IDialogService DialogService

<PageTitle>Danh sách đơn OT</PageTitle>

@* ── HEADER ── *@
<MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-1">
    <MudStack Spacing="0">
        <MudText Typo="Typo.h5">
            <MudIcon Icon="@Icons.Material.Filled.Timelapse" Class="mr-2" />
            Danh sách đơn tăng ca (OT)
        </MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary">
            @if (_isAdminView)
            {
                <span>Xem toàn công ty — lọc theo phòng ban, trạng thái, thời gian</span>
            }
            else
            {
                <span>Phòng ban của bạn: <strong>@(_deptNameDisplay)</strong></span>
            }
        </MudText>
    </MudStack>

    <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">
        @if (_isAdminView)
        {
            <MudChip T="string" Color="Color.Primary" Icon="@Icons.Material.Filled.AdminPanelSettings"
                     Label="true" Size="Size.Small">HR / Admin</MudChip>
        }
        else
        {
            <MudChip T="string" Color="Color.Info" Icon="@Icons.Material.Filled.ManageAccounts"
                     Label="true" Size="Size.Small">Quản lý phòng ban</MudChip>
        }
        <MudIconButton Icon="@Icons.Material.Filled.Refresh"
                       Color="Color.Default"
                       Size="Size.Small"
                       OnClick="LoadData"
                       Disabled="_isLoading"
                       Title="Tải lại" />
    </MudStack>
</MudStack>

@* ── SUMMARY CHIPS ── *@
@if (_pagedResult != null)
{
    <MudStack Row="true" Spacing="2" Wrap="Wrap.Wrap" Class="mb-3">
        <MudChip T="string" Color="Color.Default" Label="true" Size="Size.Small"
                 Icon="@Icons.Material.Filled.FormatListNumbered">
            Tổng: <strong class="ml-1">@_pagedResult.TotalCount</strong>
        </MudChip>
        @foreach (var s in _statusCounts)
        {
            <MudChip T="string" Color="@s.Color" Label="true" Size="Size.Small"
                     Icon="@s.Icon">
                @s.Label: <strong class="ml-1">@s.Count</strong>
            </MudChip>
        }
    </MudStack>
}

@* ── FILTER CARD ── *@
<MudCard Elevation="2" Class="mb-4">
    <MudCardContent Class="pb-2 pt-3">
        <MudGrid AlignItems="AlignItems.Center" Spacing="2">

            @* Từ ngày *@
            <MudItem xs="6" sm="3" md="2">
                <MudDatePicker Label="Từ ngày"
                               Date="_fromDate"
                               DateChanged="d => _fromDate = d"
                               Variant="Variant.Outlined"
                               Margin="Margin.Dense"
                               DateFormat="dd/MM/yyyy"
                               Editable="true" />
            </MudItem>

            @* Đến ngày *@
            <MudItem xs="6" sm="3" md="2">
                <MudDatePicker Label="Đến ngày"
                               Date="_toDate"
                               DateChanged="d => _toDate = d"
                               Variant="Variant.Outlined"
                               Margin="Margin.Dense"
                               DateFormat="dd/MM/yyyy"
                               Editable="true" />
            </MudItem>

            @* Phòng ban — chỉ Admin/HR *@
            @if (_isAdminView)
            {
                <MudItem xs="12" sm="4" md="3">
                    @if (_loadingDepts)
                    {
                        <MudSkeleton Height="40px" Animation="Animation.Wave" />
                    }
                    else
                    {
                        <MudSelect T="string"
                                   MultiSelection="true"
                                   SelectedValues="_selectedDeptCodes"
                                   SelectedValuesChanged="OnDeptsChanged"
                                   Label="Phòng ban (để trống = tất cả)"
                                   Variant="Variant.Outlined"
                                   Margin="Margin.Dense"
                                   Clearable="true"
                                   MultiSelectionTextFunc="@(_ => SelectedDeptsLabel)"
                                   MaxHeight="300"
                                   AnchorOrigin="Origin.BottomCenter"
                                   AdornmentIcon="@Icons.Material.Filled.Business">
                            @foreach (var dept in _departments)
                            {
                                <MudSelectItem T="string" Value="@dept.DeptCode">
                                    @dept.DeptName
                                </MudSelectItem>
                            }
                        </MudSelect>
                    }

                    @* Chips hiển thị dept đã chọn *@
                    @if (_selectedDeptCodes.Any())
                    {
                        <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="1" Class="mt-1">
                            @foreach (var code in _selectedDeptCodes.ToList())
                            {
                                var name = _departments
                                .FirstOrDefault(d => d.DeptCode == code)?.DeptName ?? code;
                                <MudChip T="string"
                                         Size="Size.Small"
                                         Color="Color.Primary"
                                         OnClose="@(() => RemoveDept(code))"
                                         Text="@name" />
                            }
                        </MudStack>
                    }
                </MudItem>
            }

            @* Trạng thái *@
            <MudItem xs="6" sm="3" md="2">
                <MudSelect T="string"
                           @bind-Value="_statusFilter"
                           Label="Trạng thái"
                           Variant="Variant.Outlined"
                           Margin="Margin.Dense"
                           Clearable="true">
                    <MudSelectItem T="string" Value="@("")">Tất cả</MudSelectItem>
                    <MudSelectItem T="string" Value="@("Pending")">Chờ duyệt</MudSelectItem>
                    <MudSelectItem T="string" Value="@("ApprovedLv3")">Cấp 3 đã duyệt</MudSelectItem>
                    <MudSelectItem T="string" Value="@("ApprovedLv5")">Cấp 5 đã duyệt</MudSelectItem>
                    <MudSelectItem T="string" Value="@("ApprovedLv6")">Cấp 6 đã duyệt</MudSelectItem>
                    <MudSelectItem T="string" Value="@("Approved")">Hoàn tất</MudSelectItem>
                    <MudSelectItem T="string" Value="@("Rejected")">Từ chối</MudSelectItem>
                    <MudSelectItem T="string" Value="@("Cancelled")">Đã hủy</MudSelectItem>
                </MudSelect>
            </MudItem>

            @* Tìm kiếm *@
            <MudItem xs="12" sm="@(_isAdminView ? 3 : 6)" md="@(_isAdminView ? 2 : 3)">
                <MudTextField T="string"
                              @bind-Value="_searchText"
                              Label="Tìm nhanh"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Clearable="true"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Search"
                              OnKeyUp="OnSearchKeyUp" />
            </MudItem>

            @* Nút tìm *@
            <MudItem xs="6" sm="2" md="1">
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           FullWidth="true"
                           StartIcon="@Icons.Material.Filled.Search"
                           OnClick="@(() => { _currentPage = 1; _ = LoadData(); })"
                           Disabled="_isLoading">
                    Lọc
                </MudButton>
            </MudItem>

        </MudGrid>
    </MudCardContent>
</MudCard>

@* ── TABLE ── *@
@if (_isLoading)
{
    <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="mb-1" />
}

<MudPaper Elevation="2">
    <MudTable T="OTRequestViewModel"
              Items="_items"
              Dense="true"
              Hover="true"
              Striped="true"
              Loading="_isLoading"
              OnRowClick="OnRowClick"
              RowClass="cursor-pointer"
              Breakpoint="Breakpoint.Sm">

        <ToolBarContent>
            <MudText Typo="Typo.subtitle1" Class="mr-4">
                <MudIcon Icon="@Icons.Material.Filled.TableRows" Class="mr-1" Size="Size.Small" />
                Kết quả
            </MudText>
            <MudSpacer />
            @if (_pagedResult != null)
            {
                <MudText Typo="Typo.caption" Color="Color.Secondary">
                    Trang @_currentPage / @_pagedResult.TotalPages
                    &nbsp;·&nbsp; @_pagedResult.TotalCount bản ghi
                </MudText>
            }
        </ToolBarContent>

        <HeaderContent>
            @if (_isAdminView)
            {
                <MudTh>Phòng ban</MudTh>
            }
            <MudTh>Mã đơn / Ngày OT</MudTh>
            <MudTh>Nhân viên</MudTh>
            <MudTh>Khung giờ</MudTh>
            <MudTh>Số giờ KH</MudTh>
            <MudTh>SL NV</MudTh>
            <MudTh>Trạng thái</MudTh>
            <MudTh>Người duyệt hiện tại</MudTh>
            <MudTh Style="width:50px"></MudTh>
        </HeaderContent>

        <RowTemplate>
            @if (_isAdminView)
            {
                <MudTd DataLabel="Phòng ban">
                    <MudText Typo="Typo.body2">@context.DeptName</MudText>
                </MudTd>
            }
            <MudTd DataLabel="Mã đơn / Ngày OT">
                <MudStack Spacing="0">
                    <MudText Typo="Typo.body2"><strong>@context.OTCode</strong></MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                        @context.OTDate.ToString("dd/MM/yyyy")
                    </MudText>
                </MudStack>
            </MudTd>
            <MudTd DataLabel="Nhân viên">
                <MudStack Spacing="0">
                    <MudText Typo="Typo.body2">@context.EmployeeName</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">@context.EmployeeCode</MudText>
                </MudStack>
            </MudTd>
            <MudTd DataLabel="Khung giờ">
                @* Dùng computed property StartTimeText / EndTimeText *@
                <MudText Typo="Typo.body2">@context.StartTimeText — @context.EndTimeText</MudText>
            </MudTd>
            <MudTd DataLabel="Số giờ KH">
                <MudText Typo="Typo.body2">@context.TotalOTHours.ToString("N1") h</MudText>
            </MudTd>
            <MudTd DataLabel="SL NV">
                <MudChip T="string" Size="Size.Small" Color="Color.Default" Label="true">
                    @context.EmployeeCount NV
                </MudChip>
            </MudTd>
            <MudTd DataLabel="Trạng thái">
                @{
                    var (sc, si, st) = GetStatusChip(context.RequestStatus);
                }
                <MudChip T="string" Size="Size.Small" Color="@sc" Icon="@si" Label="true">@st</MudChip>
            </MudTd>
            <MudTd DataLabel="Người duyệt">
                @* Lấy từ ApprovalSteps thay vì Level1ApproveName trực tiếp *@
                <MudText Typo="Typo.caption">@(GetCurrentApproverName(context) ?? "—")</MudText>
            </MudTd>
            <MudTd>
                <MudIconButton Icon="@Icons.Material.Filled.OpenInNew"
                               Size="Size.Small"
                               Color="Color.Primary"
                               Title="Xem chi tiết"
                               OnClick="@(e => HandleOpenDetail(e, context.Id))" />
            </MudTd>
        </RowTemplate>

        <NoRecordsContent>
            <MudStack AlignItems="AlignItems.Center" Class="pa-10" Spacing="2">
                <MudIcon Icon="@Icons.Material.Filled.SearchOff" Size="Size.Large" Color="Color.Secondary" />
                <MudText Color="Color.Secondary">Không có đơn OT nào phù hợp với bộ lọc</MudText>
            </MudStack>
        </NoRecordsContent>

        <LoadingContent>
            <MudText Align="Align.Center" Class="pa-4" Color="Color.Secondary">Đang tải...</MudText>
        </LoadingContent>

    </MudTable>

    @* Phân trang thủ công — dùng _pagedResult.Page (không phải CurrentPage) *@
    @if (_pagedResult != null && _pagedResult.TotalPages > 1)
    {
        <MudStack Row="true" Justify="Justify.Center" AlignItems="AlignItems.Center"
                  Class="pa-3" Spacing="1">
            <MudIconButton Icon="@Icons.Material.Filled.FirstPage"
                           Size="Size.Small"
                           Disabled="@(_currentPage <= 1)"
                           OnClick="@(() => GotoPage(1))" />
            <MudIconButton Icon="@Icons.Material.Filled.ChevronLeft"
                           Size="Size.Small"
                           Disabled="@(_currentPage <= 1)"
                           OnClick="@(() => GotoPage(_currentPage - 1))" />

            @for (int p = Math.Max(1, _currentPage - 2);
                    p <= Math.Min(_pagedResult.TotalPages, _currentPage + 2); p++)
            {
                var pg = p;
                <MudButton Size="Size.Small"
                           Variant="@(pg == _currentPage ? Variant.Filled : Variant.Text)"
                           Color="@(pg == _currentPage ? Color.Primary : Color.Default)"
                           OnClick="@(() => GotoPage(pg))">@pg</MudButton>
            }

            <MudIconButton Icon="@Icons.Material.Filled.ChevronRight"
                           Size="Size.Small"
                           Disabled="@(_currentPage >= _pagedResult.TotalPages)"
                           OnClick="@(() => GotoPage(_currentPage + 1))" />
            <MudIconButton Icon="@Icons.Material.Filled.LastPage"
                           Size="Size.Small"
                           Disabled="@(_currentPage >= _pagedResult.TotalPages)"
                           OnClick="@(() => GotoPage(_pagedResult.TotalPages))" />

            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="ml-2">
                @_pageSize / trang
            </MudText>
        </MudStack>
    }
</MudPaper>

@code {
    // ── Role ─────────────────────────────────────────────
    private bool _isAdminView;
    private string? _deptCodeForManager;
    private string? _deptNameDisplay;

    // ── Filter ───────────────────────────────────────────
    private DateTime? _fromDate = new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1);
    private DateTime? _toDate = DateTime.Today;
    private HashSet<string> _selectedDeptCodes = new();
    private string _statusFilter = "";
    private string _searchText = "";

    // ── Paging ─────────────────────────────────────────
    private int _currentPage = 1;
    private int _pageSize = 20;

    // ── Data ─────────────────────────────────────────────
    private List<OTRequestViewModel> _items = new();
    private PaginationResult<OTRequestViewModel>? _pagedResult;
    private bool _isLoading;

    // ── Summary chips ─────────────────────────────────────
    private List<StatusChipData> _statusCounts = new();

    // ── Dialog options (Detail dialog đã tách riêng, dùng IMudDialogInstance) ──
    private static readonly DialogOptions _detailDialogOptions = new()
    {
        MaxWidth = MaxWidth.Medium,
        FullWidth = true,
        CloseOnEscapeKey = true
    };

    // ── Departments ───────────────────────────────────────
    private string SelectedDeptsLabel =>
        _selectedDeptCodes.Count == 0
            ? "Tất cả phòng ban"
            : string.Join(", ", _departments
                .Where(d => _selectedDeptCodes.Contains(d.DeptCode))
                .Select(d => d.DeptName));

    private string? SelectedDeptParam =>
        _selectedDeptCodes.Count == 0
            ? null
            : string.Join(",", _selectedDeptCodes);

    private List<DeptOption> _departments = new();
    private bool _loadingDepts;

    private readonly CancellationTokenSource _cts = new();

    // ── Lifecycle ─────────────────────────────────────────
    protected override async Task OnInitializedAsync()
    {
        _isAdminView = UserRoleHelper.IsAdmin(CurrentUser.PermissionCode);

        if (!_isAdminView)
        {
            _deptCodeForManager = CurrentUser.User?.DeptCode;
            _deptNameDisplay = CurrentUser.User?.DeptCode;
        }

        await Task.WhenAll(
            LoadDepartments(),
            LoadData());
    }

    // ── Load ─────────────────────────────────────────────
    private async Task LoadData()
    {
        _isLoading = true;
        _items = new();

        try
        {
            var deptParam = _isAdminView
                ? SelectedDeptParam
                : _deptCodeForManager;

            Logger.LogDebugIf(Debug,
                "[OT_LIST] Load page={Page} dept={Dept} status={Status}",
                _currentPage, deptParam ?? "ALL",
                _statusFilter.Length > 0 ? _statusFilter : "ALL");

            var result = await OTService.GetPagedOTRequestsAsync(
                deptCode: deptParam,
                status: string.IsNullOrEmpty(_statusFilter) ? null : _statusFilter,
                fromDate: _fromDate,
                toDate: _toDate,
                page: _currentPage,
                pageSize: _pageSize,
                ct: _cts.Token);

            if (result.IsSuccess && result.Data != null)
            {
                _pagedResult = result.Data;
                _items = result.Data.Data;

                if (!_isAdminView && _items.Any())
                    _deptNameDisplay = _items.First().DeptName ?? _deptCodeForManager;

                if (!string.IsNullOrWhiteSpace(_searchText))
                {
                    var kw = _searchText.Trim();
                    _items = _items.Where(x =>
                        (x.EmployeeName?.Contains(kw, StringComparison.OrdinalIgnoreCase) ?? false) ||
                        (x.EmployeeCode?.Contains(kw, StringComparison.OrdinalIgnoreCase) ?? false) ||
                        (x.OTCode?.Contains(kw, StringComparison.OrdinalIgnoreCase) ?? false) ||
                        (x.DeptName?.Contains(kw, StringComparison.OrdinalIgnoreCase) ?? false)
                    ).ToList();
                }

                BuildSummaryChips();
            }
            else
            {
                Snackbar.Add(result.Message ?? "Không tải được danh sách OT.", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "[OT_LIST] LoadData lỗi");
            Snackbar.Add("Lỗi hệ thống khi tải danh sách OT.", Severity.Error);
        }
        finally
        {
            _isLoading = false;
        }
    }

    // ── Departments ──────────────────────────────────────
    private Task OnDeptsChanged(IEnumerable<string> vals)
    {
        _selectedDeptCodes = vals.ToHashSet();
        StateHasChanged();
        return Task.CompletedTask;
    }

    private void RemoveDept(string code)
    {
        _selectedDeptCodes.Remove(code);
        StateHasChanged();
    }

    private async Task LoadDepartments()
    {
        if (!_isAdminView) return;

        _loadingDepts = true;
        try
        {
            _departments = await DeptService.GetDepartmentsCachedAsync(_cts.Token);

            Logger.LogInfoIf(Debug,
                "[OT_LIST] Loaded {Count} departments", _departments.Count);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "[OT_LIST] LoadDepartments lỗi");
            Snackbar.Add("Không thể tải danh sách phòng ban.", Severity.Warning);
        }
        finally
        {
            _loadingDepts = false;
            StateHasChanged();
        }
    }

    private async Task HandleOpenDetail(MouseEventArgs e, int id)
    {
        await OpenDetail(id);
    }

    private void BuildSummaryChips()
    {
        if (_pagedResult == null) return;

        _statusCounts = new List<StatusChipData>
        {
            new("Chờ duyệt",
                _items.Count(x => IsInProcess(x.RequestStatus)),
                Color.Warning,
                Icons.Material.Filled.HourglassEmpty),
            new("Đã duyệt",
                _items.Count(x => x.RequestStatus == OTStatus.Approved),
                Color.Success,
                Icons.Material.Filled.CheckCircle),
            new("Từ chối",
                _items.Count(x => x.RequestStatus == OTStatus.Rejected),
                Color.Error,
                Icons.Material.Filled.Cancel),
        };

        _statusCounts = _statusCounts.Where(x => x.Count > 0).ToList();
    }

    private static bool IsInProcess(string? s)
        => OTStatus.ActiveStatuses?.Contains(s ?? "") ?? false;

    // ── Detail dialog (đã tách riêng, dùng IMudDialogInstance trong OTDetailDialog.razor) ──
    private async Task OpenDetail(int id)
    {
        if (id <= 0) return;

        var parameters = new DialogParameters
        {
            [nameof(OTDetailDialog.OTRequestId)] = id
        };

        var dialog = await DialogService.ShowAsync<OTDetailDialog>(
            "", parameters, _detailDialogOptions);

        await dialog.Result;
        // Dialog hiện chỉ để xem (read-only). Nếu sau này thêm action duyệt/hủy ngay trong dialog,
        // có thể kiểm tra kết quả và LoadData() lại danh sách tại đây, ví dụ:
        // var result = await dialog.Result;
        // if (result is { Canceled: false }) await LoadData();
    }

    private void OnRowClick(TableRowClickEventArgs<OTRequestViewModel> args)
        => _ = OpenDetail(args.Item?.Id ?? 0);

    // ── Paging ───────────────────────────────────────────
    private async Task GotoPage(int page)
    {
        _currentPage = page;
        await LoadData();
    }

    // ── Search on Enter ──────────────────────────────────
    private async Task OnSearchKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            _currentPage = 1;
            await LoadData();
        }
    }

    // ── Helpers: lấy tên người duyệt hiện tại từ ApprovalSteps ──
    private static string? GetCurrentApproverName(OTRequestViewModel x)
    {
        if (x.ApprovalSteps == null || !x.ApprovalSteps.Any())
            return null;

        var pending = x.ApprovalSteps.FirstOrDefault(s => s.IsApproved == null);
        return pending?.ApproverCode;
    }

    // ── Helpers: Status chip (vẫn cần ở trang để hiện màu cho bảng) ──
    private static (Color color, string icon, string text) GetStatusChip(string? status)
        => status switch
        {
            OTStatus.Approved => (Color.Success, Icons.Material.Filled.CheckCircle, "Hoàn tất"),
            OTStatus.ApprovedLv3 => (Color.Info, Icons.Material.Filled.Looks3, "Cấp 3 duyệt"),
            OTStatus.ApprovedLv5 => (Color.Info, Icons.Material.Filled.Looks5, "Cấp 5 duyệt"),
            OTStatus.ApprovedLv6 => (Color.Info, Icons.Material.Filled.Looks6, "Cấp 6 duyệt"),
            OTStatus.Rejected => (Color.Error, Icons.Material.Filled.Cancel, "Từ chối"),
            OTStatus.Cancelled => (Color.Default, Icons.Material.Filled.Block, "Đã hủy"),
            _ => (Color.Warning, Icons.Material.Filled.HourglassEmpty, "Chờ duyệt")
        };

    // ── Cleanup ───────────────────────────────────────────
    public void Dispose()
    {
        _cts.Cancel();
        _cts.Dispose();
    }

    // ── Inner record ─────────────────────────────────────
    private record StatusChipData(string Label, int Count, Color Color, string Icon);
}