@* ============================================================
   ApproverStep.razor
   Hiển thị 1 bước phê duyệt trong luồng OT với số thứ tự,
   label, badge màu sắc và slot cho nội dung con (picker).
   ============================================================ *@

@* File: FVN_REGISTER.Shared/Components/OT/ApproverStep.razor *@

<div class="approver-step mb-3" style="@ContainerStyle">

    @* Dòng tiêu đề bước *@
    <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-1">

        @* Badge số bước *@
        <MudAvatar Color="@BadgeColor"
                   Size="Size.Small"
                   Style="width:26px;height:26px;font-size:0.78rem;font-weight:700">
            @Number
        </MudAvatar>

        <MudText Typo="Typo.body2" Style="font-weight:600">
            @Label
        </MudText>

        @if (IsRequired)
        {
            <MudChip T="string" Color="Color.Error" Size="Size.Small"
                     Style="height:18px;font-size:0.7rem">
                Bắt buộc
            </MudChip>
        }
        else if (IsConditional)
        {
            <MudChip T="string" Color="Color.Warning" Size="Size.Small"
                     Style="height:18px;font-size:0.7rem">
                Có điều kiện
            </MudChip>
        }
        else if (IsFixed)
        {
            <MudChip T="string" Color="Color.Success" Size="Size.Small"
                     Style="height:18px;font-size:0.7rem">
                Tự động
            </MudChip>
        }

    </MudStack>

    @* Nội dung — hiển thị email/tên nếu IsFixed, ngược lại render ChildContent *@
    <div class="ml-1 pl-4" style="border-left: 2px solid var(--step-color, #e0e0e0);">
        @if (IsFixed && !string.IsNullOrEmpty(Email))
        {
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                <MudIcon Icon="@Icons.Material.Filled.AccountCircle"
                         Size="Size.Small" Color="Color.Primary" />
                <MudText Typo="Typo.body2">@Name</MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary">(@Email)</MudText>
            </MudStack>
        }
        else
        {
            @ChildContent
        }
    </div>

</div>

<style>
    .approver-step {
        padding: 8px 10px;
        border-radius: 8px;
        transition: background 0.2s;
    }
</style>

@code {
    [Parameter] public int Number { get; set; }
    [Parameter] public string Label { get; set; } = string.Empty;
    [Parameter] public bool IsRequired { get; set; }
    [Parameter] public bool IsConditional { get; set; }
    [Parameter] public bool IsFixed { get; set; }
    [Parameter] public Color BadgeColor { get; set; } = Color.Primary;
    [Parameter] public string? Email { get; set; }
    [Parameter] public string? Name { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private string ContainerStyle =>
        IsRequired
            ? "background:#fafafa;border:1px solid #e0e0e0;"
            : IsConditional
                ? "background:#fffde7;border:1px solid #fff9c4;"
                : "background:#f5f5f5;border:1px dashed #e0e0e0;";
}
