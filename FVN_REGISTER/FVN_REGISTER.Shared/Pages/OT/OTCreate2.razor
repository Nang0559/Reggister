@page "/ot/create2"
@attribute [Authorize]
@using FVN_REGISTER.Contract.Dtos.OT
@using FVN_REGISTER.Core.Entities.Approvers
@using FVN_REGISTER.Shared.Services.OTs
@using FVN_REGISTER.Shared.Services.Users
@using FVN_REGISTER.Shared.Utils.Helpers
@using Microsoft.AspNetCore.Authorization
@inherits AppComponentBase
@implements IDisposable

@inject IOTClientService OTService
@inject ICurrentUserClientService CurrentUser
@inject ISnackbar Snackbar
@inject NavigationManager Nav

<PageTitle>Tạo đơn OT</PageTitle>

<MudText Typo="Typo.h5" Class="mb-1">
    <MudIcon Icon="@Icons.Material.Filled.MoreTime" Class="mr-2" />
    Tạo đơn Tăng ca (OT)
</MudText>
<MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">
    Bảng đăng ký làm thêm giờ · 残業申請書 — mỗi nhân viên có lý do và giờ OT riêng
</MudText>

@if (_isLoading)
{
    <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="mb-4" />
}
else if (_model != null)
{
    <MudGrid>
        @* ===== LEFT: FORM ===== *@
        <MudItem xs="12" md="8">
            <MudStepper @ref="_stepper" NonLinear="false" Color="Color.Primary" Class="mb-4">

                @* ══════════════════════════════════════════════════════════════
                   STEP 1: THÔNG TIN CHUNG + BẢNG NHÂN VIÊN
                   ══════════════════════════════════════════════════════════════ *@
                <MudStep Title="Đăng ký làm thêm giờ" Icon="@Icons.Material.Filled.People">
                    <MudCard Elevation="2" Class="pa-4">
                        <MudCardContent>

                            @* ── Header thông tin chung ── *@
                            <MudText Typo="Typo.subtitle1" Class="mb-3">Thông tin chung</MudText>
                            <MudGrid>
                                <MudItem xs="12" sm="4">
                                    <MudDatePicker Label="Ngày OT (*)"
                                                   Date="_otDate"
                                                   DateChanged="OnOTDateChanged"
                                                   Variant="Variant.Outlined"
                                                   Margin="Margin.Dense"
                                                   DateFormat="dd/MM/yyyy"
                                                   Required="true" />
                                </MudItem>

                                @* FIX: Bỏ @bind-Time, chỉ dùng Time + TimeChanged để tránh conflict *@
                                <MudItem xs="6" sm="2">
                                    <MudTimePicker Label="Giờ bắt đầu (mặc định)"
                                                   Time="_defaultStartTime"
                                                   TimeChanged="OnDefaultStartTimeChanged"
                                                   Variant="Variant.Outlined"
                                                   Margin="Margin.Dense"
                                                   AmPm="false" />
                                </MudItem>
                                <MudItem xs="6" sm="2">
                                    <MudTimePicker Label="Giờ kết thúc (mặc định)"
                                                   Time="_defaultEndTime"
                                                   TimeChanged="OnDefaultEndTimeChanged"
                                                   Variant="Variant.Outlined"
                                                   Margin="Margin.Dense"
                                                   AmPm="false" />
                                </MudItem>

                                <MudItem xs="12" sm="4">
                                    <MudSelect T="string" Label="Loại OT (*)"
                                               @bind-Value="_model!.OTTypeCode"
                                               Variant="Variant.Outlined"
                                               Margin="Margin.Dense">
                                        <MudSelectItem Value="@OTTypeConst.Weekday">Ngày thường · 平日 (×1.5)</MudSelectItem>
                                        <MudSelectItem Value="@OTTypeConst.Weekend">Cuối tuần · 休日 (×2.0)</MudSelectItem>
                                        <MudSelectItem Value="@OTTypeConst.Holiday">Ngày lễ · 例日 (×3.0)</MudSelectItem>
                                    </MudSelect>
                                </MudItem>
                            </MudGrid>

                            @if (_defaultStartTime.HasValue && _defaultEndTime.HasValue && _defaultEndTime > _defaultStartTime)
                            {
                                var totalH = (_defaultEndTime.Value - _defaultStartTime.Value).TotalHours;
                                <MudAlert Severity="@(totalH > 4 ? Severity.Warning : Severity.Info)"
                                          Dense="true" Class="mt-2 mb-1">
                                    Giờ chung dự kiến: <strong>@totalH.ToString("N1") giờ</strong>
                                    (mỗi nhân viên có thể đặt giờ riêng bên dưới)
                                    @if (totalH > 4)
                                    {
                                        <span> ⚠ Vượt 4h/ngày thường — cần xem xét</span>
                                    }
                                </MudAlert>
                            }

                            @* ── Toolbar bảng ── *@
                            <MudDivider Class="my-3" />
                            <MudStack Row="true" AlignItems="AlignItems.Center"
                                      Justify="Justify.SpaceBetween" Class="mb-2">
                                <MudText Typo="Typo.subtitle1">
                                    Bảng đăng ký làm thêm giờ · 残業登録表
                                    <MudChip T="string" Size="Size.Small" Color="Color.Primary"
                                             Label="true" Class="ml-1">
                                        @_selectedEmployees.Count người
                                    </MudChip>
                                </MudText>
                                <MudButton Variant="Variant.Outlined" Color="Color.Primary"
                                           Size="Size.Small"
                                           StartIcon="@Icons.Material.Filled.PersonAdd"
                                           OnClick="OpenEmployeePicker">
                                    Thêm nhân viên
                                </MudButton>
                            </MudStack>

                            @if (!_selectedEmployees.Any())
                            {
                                <MudAlert Severity="Severity.Warning">
                                    Chưa có nhân viên. Bấm "Thêm nhân viên" để chọn từ danh sách phòng ban.
                                </MudAlert>
                            }
                            else
                            {
                                @* ══ BẢNG ĐĂNG KÝ — cấu trúc theo form giấy ══ *@
                                <MudPaper Elevation="1" Class="pa-0" Style="overflow-x: auto;">
                                    <table style="width:100%; border-collapse: collapse; font-size: 12px; min-width: 900px;">
                                        <thead>
                                            @* Hàng 1: nhóm cột *@
                                            <tr style="background: var(--mud-palette-primary); color: white; text-align: center;">
                                                <th style="@ThStyle(40)" rowspan="2">No.</th>
                                                <th style="@ThStyle(130)" rowspan="2">Họ tên · 名前</th>

                                                @* ── Lý do làm thêm ngày (2 cột) ── *@
                                                <th style="@ThStyle(200)" colspan="2">
                                                    残業理由 · Lý do làm thêm ngày
                                                </th>

                                                @* ── Tích lũy giờ ── *@
                                                <th style="@ThStyle(80)" rowspan="2">
                                                    <div>Năm</div>
                                                    <div style="font-size:10px; font-weight:normal;">(≥300h check)</div>
                                                </th>
                                                <th style="@ThStyle(80)" rowspan="2">
                                                    <div>Tháng</div>
                                                    <div style="font-size:10px; font-weight:normal;">(≤40h check)</div>
                                                </th>

                                                @* ── Giờ OT dự kiến (Từ/Đến) ── *@
                                                <th style="@ThStyle(160)" colspan="2">
                                                    残業時間予定 · Giờ OT dự kiến
                                                </th>

                                                @* ── Giờ OT thực tế (chấm công sau) ── *@
                                                <th style="@ThStyle(160)" colspan="2">
                                                    実際の残業時間 · Giờ OT thực tế
                                                    <div style="font-size:10px; font-weight:normal;">(chấm công xác nhận)</div>
                                                </th>

                                                <th style="@ThStyle(70)" rowspan="2">Trạng thái</th>
                                                <th style="@ThStyle(50)" rowspan="2"></th>
                                            </tr>

                                            @* Hàng 2: sub-header *@
                                            <tr style="background: var(--mud-palette-primary-darken); color: white; text-align: center;">
                                                <th style="@ThStyle(80)">Hạng mục · 項目</th>
                                                <th style="@ThStyle(150)">Nội dung cụ thể · 具体的な内容</th>
                                                <th style="@ThStyle(70)">Từ · から</th>
                                                <th style="@ThStyle(70)">Đến · まで</th>
                                                <th style="@ThStyle(70)">Từ · から</th>
                                                <th style="@ThStyle(70)">Đến · まで</th>
                                            </tr>
                                        </thead>

                                        <tbody>
                                            @for (int i = 0; i < _selectedEmployees.Count; i++)
                                            {
                                                var emp = _selectedEmployees[i];
                                                var rowBg = i % 2 == 0
                                                ? "background: var(--mud-palette-background);"
                                                : "background: var(--mud-palette-background-grey);";

                                                <tr style="@rowBg border-bottom: 1px solid var(--mud-palette-divider);">

                                                    @* ── No. ── *@
                                                    <td style="@TdStyle() text-align:center; font-weight:bold; font-size:13px;">
                                                        @(i + 1)
                                                    </td>

                                                    @* ── Họ tên ── *@
                                                    <td style="@TdStyle(130)">
                                                        <MudText Typo="Typo.body2"><strong>@emp.EmployeeName</strong></MudText>
                                                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                                                            @emp.EmployeeCode
                                                            @if (emp.CvCode == "0003")
                                                            {
                                                                <MudChip T="string" Size="Size.Small"
                                                                         Color="Color.Warning" Label="true" Class="ml-1">CN</MudChip>
                                                            }
                                                        </MudText>
                                                    </td>

                                                    @* ── Hạng mục lý do (A-J) ── *@
                                                    <td style="@TdStyle(80)">
                                                        <MudSelect T="string"
                                                                   Value="@emp.OTReasonCategoryCode"
                                                                   ValueChanged="@(v => emp.OTReasonCategoryCode = v)"
                                                                   Variant="Variant.Text"
                                                                   Margin="Margin.Dense"
                                                                   Dense="true">
                                                            @foreach (var cat in OTReasonCategory.AllItems)
                                                            {
                                                                <MudSelectItem Value="@cat.Code">@cat.Code</MudSelectItem>
                                                            }
                                                        </MudSelect>
                                                        <MudText Typo="Typo.caption" Color="Color.Secondary"
                                                                 Style="font-size:10px; line-height:1.2;">
                                                            @OTReasonCategory.GetDisplayName(emp.OTReasonCategoryCode)?
                                                            .Split(':').FirstOrDefault()
                                                        </MudText>
                                                    </td>

                                                    @* ── Nội dung cụ thể ── *@
                                                    <td style="@TdStyle(150)">
                                                        <MudTextField T="string"
                                                                      Value="@emp.OTReasonDetail"
                                                                      ValueChanged="@(v => emp.OTReasonDetail = v)"
                                                                      Placeholder="Nhập nội dung cụ thể..."
                                                                      Variant="Variant.Text"
                                                                      Margin="Margin.Dense"
                                                                      Lines="2" />
                                                    </td>

                                                    @* ── Năm tích lũy ── *@
                                                    <td style="@TdStyle(80) text-align:center;">
                                                        @if (emp.IsLoadingBalance)
                                                        {
                                                            <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                                                        }
                                                        else if (emp.Balance != null)
                                                        {
                                                            <MudText Typo="Typo.body2"
                                                                     Color="@(emp.WillExceedYearlyLimit ? Color.Error : Color.Default)">
                                                                @emp.Balance.UsedHoursThisYear.ToString("N0")h
                                                            </MudText>
                                                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                                                / @emp.Balance.YearlyLimit.ToString("N0")h
                                                            </MudText>
                                                        }
                                                        else
                                                        {
                                                            <MudText Typo="Typo.caption" Color="Color.Secondary">—</MudText>
                                                        }
                                                    </td>

                                                    @* ── Tháng tích lũy ── *@
                                                    <td style="@TdStyle(80) text-align:center;">
                                                        @if (emp.Balance != null)
                                                        {
                                                            <MudText Typo="Typo.body2"
                                                                     Color="@(emp.WillExceedMonthlyLimit ? Color.Error : Color.Default)">
                                                                @emp.Balance.UsedHoursThisMonth.ToString("N0")h
                                                            </MudText>
                                                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                                                / @emp.Balance.MonthlyLimit.ToString("N0")h
                                                            </MudText>
                                                        }
                                                        else
                                                        {
                                                            <MudText Typo="Typo.caption" Color="Color.Secondary">—</MudText>
                                                        }
                                                    </td>

                                                    @* ── Giờ OT DỰ KIẾN: Từ ── *@
                                                    <td style="@TdStyle(75)">
                                                        <MudTimePicker Time="@(emp.StartTime ?? _defaultStartTime)"
                                                                       TimeChanged="@(v => { emp.StartTime = v; RecalcHours(emp); })"
                                                                       Variant="Variant.Text"
                                                                       Margin="Margin.Dense"
                                                                       AmPm="false"
                                                                       Placeholder="--:--" />
                                                    </td>

                                                    @* ── Giờ OT DỰ KIẾN: Đến ── *@
                                                    <td style="@TdStyle(75)">
                                                        <MudTimePicker Time="@(emp.EndTime ?? _defaultEndTime)"
                                                                       TimeChanged="@(v => { emp.EndTime = v; RecalcHours(emp); })"
                                                                       Variant="Variant.Text"
                                                                       Margin="Margin.Dense"
                                                                       AmPm="false"
                                                                       Placeholder="--:--" />
                                                        @{
                                                            var empStart = emp.StartTime ?? _defaultStartTime;
                                                            var empEnd = emp.EndTime ?? _defaultEndTime;
                                                        }
                                                        @if (empStart.HasValue && empEnd.HasValue && empEnd > empStart)
                                                        {
                                                            <MudText Typo="Typo.caption" Color="Color.Info"
                                                                     Style="font-size:10px;">
                                                                @((empEnd.Value - empStart.Value).TotalHours.ToString("N1"))h
                                                            </MudText>
                                                        }
                                                    </td>

                                                    @* ── Giờ OT THỰC TẾ: Từ (chấm công) ── *@
                                                    <td style="@TdStyle(75)">
                                                        @if (emp.ActualHours.HasValue)
                                                        {
                                                            <MudText Typo="Typo.body2" Color="Color.Success">
                                                                @(emp.ActualStartTime?.ToString(@"hh\:mm") ?? "—")
                                                            </MudText>
                                                        }
                                                        else
                                                        {
                                                            <MudText Typo="Typo.caption" Color="Color.Secondary"
                                                                     Style="font-style:italic;">chờ CC</MudText>
                                                        }
                                                    </td>

                                                    @* ── Giờ OT THỰC TẾ: Đến (chấm công) ── *@
                                                    <td style="@TdStyle(75)">
                                                        @if (emp.ActualHours.HasValue)
                                                        {
                                                            <MudText Typo="Typo.body2" Color="Color.Success">
                                                                @(emp.ActualEndTime?.ToString(@"hh\:mm") ?? "—")
                                                            </MudText>
                                                        }
                                                        else
                                                        {
                                                            <MudText Typo="Typo.caption" Color="Color.Secondary"
                                                                     Style="font-style:italic;">chờ CC</MudText>
                                                        }
                                                    </td>

                                                    @* ── Trạng thái validate ── *@
                                                    <td style="@TdStyle(70) text-align:center;">
                                                        @if (emp.HasAnyWarning)
                                                        {
                                                            <MudTooltip Text="@GetWarningText(emp)">
                                                                <MudIcon Icon="@Icons.Material.Filled.Warning"
                                                                         Color="Color.Warning" Size="Size.Small" />
                                                            </MudTooltip>
                                                        }
                                                        else if (emp.Balance != null)
                                                        {
                                                            <MudIcon Icon="@Icons.Material.Filled.CheckCircle"
                                                                     Color="Color.Success" Size="Size.Small" />
                                                        }
                                                        <MudText Typo="Typo.caption" Style="font-size:10px; display:block;">
                                                            @(emp.OTHours.ToString("N1"))h
                                                        </MudText>
                                                    </td>

                                                    @* ── Xóa ── *@
                                                    <td style="@TdStyle() text-align:center;">
                                                        <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                                                       Color="Color.Error"
                                                                       Size="Size.Small"
                                                                       Disabled="@IsCurrentUser(emp.EmployeeCode)"
                                                                       OnClick="@(() => RemoveEmployee(emp))" />
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>

                                        <tfoot>
                                            <tr style="background: var(--mud-palette-primary-lighten); font-weight: bold;">
                                                <td colspan="7" style="@TdStyle() text-align:right; padding-right:12px;">
                                                    Tổng số giờ làm thêm · 残業時間合計:
                                                </td>
                                                <td colspan="2" style="@TdStyle() text-align:center; font-size:14px;">
                                                    <strong>@_selectedEmployees.Sum(e => e.OTHours).ToString("N1") h</strong>
                                                </td>
                                                <td colspan="3" style="@TdStyle()"></td>
                                            </tr>
                                        </tfoot>
                                    </table>
                                </MudPaper>

                                @* Ghi chú: Hạng mục lý do A-J *@
                                <MudExpansionPanels Class="mt-3" Elevation="0">
                                    <MudExpansionPanel Text="Chú thích hạng mục lý do (A-J)" Dense="true">
                                        <MudGrid Spacing="1">
                                            @foreach (var cat in OTReasonCategory.AllItems)
                                            {
                                                <MudItem xs="12" sm="6">
                                                    <MudText Typo="Typo.caption">
                                                        <strong>@cat.Code:</strong> @cat.DisplayName
                                                    </MudText>
                                                </MudItem>
                                            }
                                        </MudGrid>
                                    </MudExpansionPanel>
                                </MudExpansionPanels>

                                @* FIX: warnings phải nằm trong cùng 1 block @if, không tách ra *@
                                @if (_selectedEmployees.Any(e => e.HasAnyWarning))
                                {
                                    var warnings = _selectedEmployees.Where(e => e.HasAnyWarning).ToList();
                                    <MudAlert Severity="Severity.Warning" Class="mt-3" Dense="true">
                                        <strong>@warnings.Count nhân viên</strong> có cảnh báo vượt giới hạn giờ OT.
                                        Kiểm tra lại trước khi gửi.
                                    </MudAlert>
                                }
                            }
                        </MudCardContent>
                    </MudCard>
                </MudStep>

                @* ══════════════════════════════════════════════════════════════
                   STEP 2: PHÂN CẤP DUYỆT
                   ══════════════════════════════════════════════════════════════ *@
                <MudStep Title="Phân cấp duyệt" Icon="@Icons.Material.Filled.VerifiedUser">
                    <MudCard Elevation="2" Class="pa-4">
                        <MudCardContent>
                            <MudText Typo="Typo.subtitle1" Class="mb-1">Cấu hình luồng phê duyệt OT</MudText>
                            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">
                                @if (_model.HasWorker)
                                {
                                    <span>Có công nhân → cần đủ 4 bước (Lv3 → Lv5 → Lv6 → Lv7)</span>
                                }
                                else
                                {
                                    <span>Nhân viên văn phòng → từ Bước 5 trở lên</span>
                                }
                            </MudText>

                            @if (_model.HasWorker)
                            {
                                <MudSelect T="F03OTApprover?"
                                           Label="Bước 3 — Sub-leader / Leader (*)"
                                           Value="_selectedApprovers.GetValueOrDefault(3)"
                                           ValueChanged="@(v => OnApproverChanged(3, v))"
                                           Variant="Variant.Outlined"
                                           Margin="Margin.Dense"
                                           ToStringFunc="@(a => a == null ? "" : $"{a.ApproverName} ({a.ApproverEmail})")"
                                           Class="mb-3">
                                    @foreach (var a in GetApproversForLevel(3))
                                    {
                                        <MudSelectItem T="F03OTApprover?" Value="@((F03OTApprover?)a)">
                                            @a.ApproverName — @a.RoleName (@a.ApproverEmail)
                                        </MudSelectItem>
                                    }
                                </MudSelect>
                            }

                            <MudSelect T="F03OTApprover?"
                                       Label="Bước 5 — Ast. Chief / Chief (*)"
                                       Value="_selectedApprovers.GetValueOrDefault(5)"
                                       ValueChanged="@(v => OnApproverChanged(5, v))"
                                       Variant="Variant.Outlined"
                                       Margin="Margin.Dense"
                                       ToStringFunc="@(a => a == null ? "" : $"{a.ApproverName} ({a.ApproverEmail})")"
                                       Class="mb-3">
                                @foreach (var a in GetApproversForLevel(5))
                                {
                                    <MudSelectItem T="F03OTApprover?" Value="@((F03OTApprover?)a)">
                                        @a.ApproverName — @a.RoleName (@a.ApproverEmail)
                                    </MudSelectItem>
                                }
                            </MudSelect>

                            <MudSelect T="F03OTApprover?"
                                       Label="Bước 6 — A.MG / MG (*)"
                                       Value="_selectedApprovers.GetValueOrDefault(6)"
                                       ValueChanged="@(v => OnApproverChanged(6, v))"
                                       Variant="Variant.Outlined"
                                       Margin="Margin.Dense"
                                       ToStringFunc="@(a => a == null ? "" : $"{a.ApproverName} ({a.ApproverEmail})")"
                                       Class="mb-3">
                                @foreach (var a in GetApproversForLevel(6))
                                {
                                    <MudSelectItem T="F03OTApprover?" Value="@((F03OTApprover?)a)">
                                        @a.ApproverName — @a.RoleName (@a.ApproverEmail)
                                    </MudSelectItem>
                                }
                            </MudSelect>

                            @{
                                bool requiresGM = _model.OTTypeCode != OTTypeConst.Weekday || _model.HasWorker;
                            }
                            <MudSelect T="F03OTApprover?"
                                       Label="@($"Bước 7 — GM {(requiresGM ? "(*)" : "(tùy chọn)")}")"
                                       Value="_selectedApprovers.GetValueOrDefault(7)"
                                       ValueChanged="@(v => OnApproverChanged(7, v))"
                                       Variant="Variant.Outlined"
                                       Margin="Margin.Dense"
                                       ToStringFunc="@(a => a == null ? "" : $"{a.ApproverName} ({a.ApproverEmail})")"
                                       Clearable="@(!requiresGM)"
                                       Class="mb-3">
                                @foreach (var a in GetApproversForLevel(7))
                                {
                                    <MudSelectItem T="F03OTApprover?" Value="@((F03OTApprover?)a)">
                                        @a.ApproverName — @a.RoleName (@a.ApproverEmail)
                                    </MudSelectItem>
                                }
                            </MudSelect>

                            <MudDivider Class="my-3" />
                            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-2">Luồng duyệt đã chọn:</MudText>
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                @foreach (var kv in _selectedApprovers.Where(x => x.Value != null).OrderBy(x => x.Key))
                                {
                                    <MudChip T="string" Size="Size.Small" Color="Color.Primary" Label="true">
                                        Lv@(kv.Key): @kv.Value!.ApproverName
                                    </MudChip>
                                    <MudIcon Icon="@Icons.Material.Filled.ArrowForward"
                                             Size="Size.Small" Color="Color.Secondary" />
                                }
                                <MudText Typo="Typo.caption" Color="Color.Secondary">Hoàn tất</MudText>
                            </MudStack>
                        </MudCardContent>
                    </MudCard>
                </MudStep>

                @* ══════════════════════════════════════════════════════════════
                   STEP 3: XÁC NHẬN & GỬI
                   ══════════════════════════════════════════════════════════════ *@
                <MudStep Title="Xác nhận & Gửi" Icon="@Icons.Material.Filled.Send">
                    <MudCard Elevation="2" Class="pa-4">
                        <MudCardContent>
                            <MudText Typo="Typo.subtitle1" Class="mb-3">Xác nhận thông tin đơn OT</MudText>

                            <MudSimpleTable Dense="true" Hover="true" Class="mb-3">
                                <tbody>
                                    <tr>
                                        <td><strong>Ngày OT</strong></td>
                                        <td>@(_otDate?.ToString("dd/MM/yyyy"))</td>
                                    </tr>
                                    <tr>
                                        <td><strong>Giờ OT (mặc định)</strong></td>
                                        <td>
                                            @(_defaultStartTime?.ToString(@"hh\:mm")) →
                                            @(_defaultEndTime?.ToString(@"hh\:mm"))
                                            @if (_defaultStartTime.HasValue && _defaultEndTime.HasValue)
                                            {
                                                <span>(@((_defaultEndTime.Value - _defaultStartTime.Value).TotalHours.ToString("N1")) giờ)</span>
                                            }
                                        </td>
                                    </tr>
                                    <tr>
                                        <td><strong>Loại OT</strong></td>
                                        <td>@OTTypeConst.GetDisplayName(_model.OTTypeCode)</td>
                                    </tr>
                                    <tr>
                                        <td><strong>Số nhân viên</strong></td>
                                        <td>@_selectedEmployees.Count người</td>
                                    </tr>
                                    <tr>
                                        <td><strong>Tổng giờ OT</strong></td>
                                        <td>@_selectedEmployees.Sum(e => e.OTHours).ToString("N1") giờ</td>
                                    </tr>
                                </tbody>
                            </MudSimpleTable>

                            @* Tóm tắt từng nhân viên *@
                            <MudText Typo="Typo.subtitle2" Class="mb-2">Chi tiết từng nhân viên:</MudText>
                            <MudSimpleTable Dense="true" Class="mb-3">
                                <thead>
                                    <tr>
                                        <th>Họ tên</th>
                                        <th>Hạng mục</th>
                                        <th>Giờ OT (Từ → Đến)</th>
                                        <th>Số giờ</th>
                                        <th>Trạng thái</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var emp in _selectedEmployees)
                                    {
                                        var empStart = emp.StartTime ?? _defaultStartTime;
                                        var empEnd = emp.EndTime ?? _defaultEndTime;
                                        <tr>
                                            <td>@emp.EmployeeName</td>
                                            <td>
                                                <MudChip T="string" Size="Size.Small" Label="true">
                                                    @emp.OTReasonCategoryCode
                                                </MudChip>
                                            </td>
                                            <td>
                                                @(empStart?.ToString(@"hh\:mm") ?? "—") →
                                                @(empEnd?.ToString(@"hh\:mm") ?? "—")
                                            </td>
                                            <td>@emp.OTHours.ToString("N1")h</td>
                                            <td>
                                                @if (emp.HasAnyWarning)
                                                {
                                                    <MudChip T="string" Size="Size.Small" Color="Color.Warning" Label="true">⚠ Cảnh báo</MudChip>
                                                }
                                                else
                                                {
                                                    <MudChip T="string" Size="Size.Small" Color="Color.Success" Label="true">✓ Hợp lệ</MudChip>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </MudSimpleTable>

                            @if (_validationResult != null && _validationResult.Warnings.Any())
                            {
                                <MudAlert Severity="Severity.Warning" Class="mb-3">
                                    <strong>Cảnh báo:</strong>
                                    @foreach (var w in _validationResult.Warnings)
                                    {
                                        <div>• @w</div>
                                    }
                                </MudAlert>
                            }

                            @if (_validationResult != null && !_validationResult.IsValid)
                            {
                                <MudAlert Severity="Severity.Error" Class="mb-3">
                                    <strong>Vượt giới hạn giờ OT:</strong>
                                    @foreach (var e in _validationResult.Errors)
                                    {
                                        <div>• @e</div>
                                    }
                                </MudAlert>
                            }

                            <MudButton Variant="Variant.Filled"
                                       Color="Color.Primary"
                                       StartIcon="@Icons.Material.Filled.Send"
                                       OnClick="SubmitOT"
                                       Disabled="@(_isSubmitting || (_validationResult != null && !_validationResult.IsValid))"
                                       FullWidth="true"
                                       Size="Size.Large">
                                @(_isSubmitting ? "Đang gửi..." : "GỬI ĐƠN OT")
                            </MudButton>
                        </MudCardContent>
                    </MudCard>
                </MudStep>
            </MudStepper>
        </MudItem>

        @* ===== RIGHT: BALANCE + RECENT ===== *@
        <MudItem xs="12" md="4">
            <MudCard Elevation="2" Class="mb-3">
                <MudCardHeader>
                    <CardHeaderContent>
                        <MudText Typo="Typo.subtitle1">
                            <MudIcon Icon="@Icons.Material.Filled.BarChart" Class="mr-1" />
                            Số dư giờ OT năm @DateTime.Now.Year
                        </MudText>
                    </CardHeaderContent>
                </MudCardHeader>
                <MudCardContent>
                    @if (_model.Balance != null)
                    {
                        <MudStack Spacing="2">
                            <div>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">Đã dùng trong năm</MudText>
                                <MudText Typo="Typo.h6">
                                    @_model.Balance.UsedHoursThisYear / @_model.Balance.YearlyLimit giờ
                                </MudText>
                            </div>
                            <MudProgressLinear Value="@_model.Balance.YearlyUsedPercent"
                                               Color="@(_model.Balance.IsNearYearlyLimit ? Color.Error : Color.Primary)"
                                               Rounded="true" Size="Size.Medium" />
                            <MudStack Row="true" Justify="Justify.SpaceBetween">
                                <div>
                                    <MudText Typo="Typo.caption">Tháng này</MudText>
                                    <MudText Typo="Typo.body1" Color="Color.Warning">
                                        <strong>@_model.Balance.UsedHoursThisMonth h</strong>
                                    </MudText>
                                </div>
                                <div class="text-right">
                                    <MudText Typo="Typo.caption">Còn lại (năm)</MudText>
                                    <MudText Typo="Typo.body1" Color="Color.Success">
                                        <strong>@_model.Balance.RemainingYearly h</strong>
                                    </MudText>
                                </div>
                            </MudStack>
                            <MudDivider />
                            <MudStack Row="true" Justify="Justify.SpaceBetween">
                                <MudText Typo="Typo.caption">Giới hạn ngày</MudText>
                                <MudChip T="string" Size="Size.Small" Color="Color.Info" Label="true">
                                    @_model.Balance.DailyLimit h/ngày
                                </MudChip>
                            </MudStack>
                        </MudStack>
                    }
                </MudCardContent>
            </MudCard>

            <MudCard Elevation="2">
                <MudCardHeader>
                    <CardHeaderContent>
                        <MudText Typo="Typo.subtitle1">
                            <MudIcon Icon="@Icons.Material.Filled.History" Class="mr-1" />
                            Đơn OT gần đây
                        </MudText>
                    </CardHeaderContent>
                </MudCardHeader>
                <MudCardContent Class="pa-0">
                    @if (_recentRequests.Any())
                    {
                        <MudList T="OTRequestViewModel" Dense="true">
                            @foreach (var req in _recentRequests)
                            {
                                <MudListItem T="OTRequestViewModel"
                                             OnClick="@(() => Nav.NavigateTo($"/ot/detail/{req.Id}"))">
                                    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                                        <div>
                                            <MudText Typo="Typo.body2">@req.OTDate.ToString("dd/MM/yyyy")</MudText>
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                                @req.TotalOTHours h — @req.OTTypeName
                                            </MudText>
                                        </div>
                                        <MudChip T="string" Size="Size.Small"
                                                 Color="@GetStatusColor(req.RequestStatus)"
                                                 Label="true">
                                            @req.StatusText
                                        </MudChip>
                                    </MudStack>
                                </MudListItem>
                            }
                        </MudList>
                    }
                    else
                    {
                        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="pa-4">Chưa có đơn OT nào.</MudText>
                    }
                </MudCardContent>
            </MudCard>
        </MudItem>
    </MudGrid>
}
@* ════ DIALOG: Đơn OT cùng ngày trong phòng ban ════ *@
<MudDialog @bind-IsVisible="_showTodayOTDialog"
           Options="@(new DialogOptions { MaxWidth = MaxWidth.Large, FullWidth = true })">
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@Icons.Material.Filled.EventNote" Class="mr-2" />
            Đơn OT phòng ban ngày @(_otDate?.ToString("dd/MM/yyyy"))
        </MudText>
    </TitleContent>
    <DialogContent>
        @if (_todayOTRequests.Any())
        {
            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">
                Có @_todayOTRequests.Count đơn OT trong ngày này.
                Bạn có thể tự thêm mình vào đơn đã có hoặc tạo đơn mới.
            </MudText>

            @foreach (var ot in _todayOTRequests)
            {
                <MudCard Elevation="1" Class="mb-2"
                         Style="@($"border-left: 4px solid {OTStatus.GetColor(ot.RequestStatus)};")">
                    <MudCardContent Class="pb-1">
                        <MudGrid AlignItems="AlignItems.Center">
                            <MudItem xs="12" sm="5">
                                <MudText Typo="Typo.body2">
                                    <strong>@ot.OTCode</strong> — @ot.EmployeeName
                                </MudText>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">
                                    @ot.StartTimeText – @ot.EndTimeText
                                    (@ot.TotalOTHours.ToString("N1")h) ·
                                    @ot.EmployeeCount người
                                </MudText>
                            </MudItem>
                            <MudItem xs="6" sm="3">
                                <MudChip T="string" Size="Size.Small" Label="true"
                                         Style="@($"background:{OTStatus.GetColor(ot.RequestStatus)};color:#fff;")">
                                    @ot.StatusText
                                </MudChip>
                            </MudItem>
                            <MudItem xs="6" sm="4" Class="d-flex justify-end">
                                <MudButton Variant="Variant.Outlined"
                                           Color="Color.Primary"
                                           Size="Size.Small"
                                           StartIcon="@Icons.Material.Filled.PersonAdd"
                                           OnClick="@(() => JoinExistingOT(ot))"
                                           Disabled="@IsAlreadyInOT(ot)">
                                    @(IsAlreadyInOT(ot) ? "Đã có trong đơn" : "Tham gia đơn này")
                                </MudButton>
                            </MudItem>
                        </MudGrid>
                    </MudCardContent>
                </MudCard>
            }

            <MudDivider Class="my-3" />
            <MudButton Variant="Variant.Filled" Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Add"
                       OnClick="@(() => _showTodayOTDialog = false)">
                Tạo đơn OT mới trong ngày này
            </MudButton>
        }
        else
        {
            <MudAlert Severity="Severity.Info">
                Chưa có đơn OT nào của phòng ban trong ngày @(_otDate?.ToString("dd/MM/yyyy")).
                Bạn sẽ tạo đơn mới.
            </MudAlert>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => _showTodayOTDialog = false)">Đóng</MudButton>
    </DialogActions>
</MudDialog>
@* ════════════════════════════════════════════════════════════
   DIALOG: Chọn nhân viên từ danh sách phòng ban
   ════════════════════════════════════════════════════════════ *@
<MudDialog @bind-IsVisible="_showEmployeePicker"
           Options="@(new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true })">
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@Icons.Material.Filled.People" Class="mr-2" />
            Chọn nhân viên OT — @(_model?.DeptCode)
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudTextField @bind-Value="_empSearchText"
                      Label="Tìm tên hoặc mã nhân viên"
                      Adornment="Adornment.Start"
                      AdornmentIcon="@Icons.Material.Filled.Search"
                      Variant="Variant.Outlined"
                      Margin="Margin.Dense"
                      Class="mb-3"
                      Immediate="true" />

        <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-2">
            <MudCheckBox T="bool"
                         Value="@IsAllDeptSelected"
                         ValueChanged="@ToggleSelectAll"
                         Label="Chọn tất cả phòng ban" />
            <MudText Typo="Typo.caption" Color="Color.Secondary">
                (@_tempSelected.Count / @FilteredDeptEmployees.Count() đã chọn)
            </MudText>
        </MudStack>

        <MudDivider Class="mb-2" />

        <div style="max-height: 400px; overflow-y: auto;">
            @foreach (var emp in FilteredDeptEmployees)
            {
                var isAlreadyAdded = _selectedEmployees.Any(s => s.EmployeeCode == emp.EmployeeCode);
                var isCurrentUser = IsCurrentUser(emp.EmployeeCode);

                <MudPaper Elevation="0" Class="pa-2 mb-1"
                          Style="border: 1px solid var(--mud-palette-divider); border-radius: 6px;">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                        <MudStack Row="true" AlignItems="AlignItems.Center">
                            <MudCheckBox T="bool"
                                         Value="@(_tempSelected.Contains(emp.EmployeeCode))"
                                         ValueChanged="@(v => ToggleEmpTemp(emp.EmployeeCode, v))"
                                         Disabled="@isCurrentUser" />
                            <MudAvatar Color="Color.Primary" Size="Size.Small">
                                @(emp.EmployeeName?.FirstOrDefault().ToString() ?? "?")
                            </MudAvatar>
                            <div>
                                <MudText Typo="Typo.body2">
                                    <strong>@emp.EmployeeName</strong>
                                    @if (isCurrentUser)
                                    {
                                        <MudChip T="string" Size="Size.Small" Color="Color.Info" Label="true" Class="ml-1">Bạn</MudChip>
                                    }
                                </MudText>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">
                                    @emp.EmployeeCode
                                    @if (emp.CvCode == "0003")
                                    {
                                        <MudChip T="string" Size="Size.Small" Color="Color.Warning" Label="true" Class="ml-1">Công nhân</MudChip>
                                    }
                                </MudText>
                            </div>
                        </MudStack>
                        @if (isAlreadyAdded && !isCurrentUser)
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Success" Label="true">Đã thêm</MudChip>
                        }
                    </MudStack>
                </MudPaper>
            }

            @if (!FilteredDeptEmployees.Any())
            {
                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="pa-4 text-center">
                    Không tìm thấy nhân viên phù hợp.
                </MudText>
            }
        </div>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => { _showEmployeePicker = false; _empSearchText = ""; })">Hủy</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                   OnClick="ConfirmEmployeeSelection"
                   Disabled="@(!_tempSelected.Any())">
            Thêm @_tempSelected.Count nhân viên
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    // ── State ─────────────────────────────────────────────────────────────────
    private bool _isLoading = true;
    private bool _isSubmitting;
    private CreateOTRequestModel? _model;
    private MudStepper? _stepper;
    private bool _showTodayOTDialog;
    private List<OTRequestViewModel> _todayOTRequests = new();
    private bool _isLoadingTodayOT;
    private List<OTEmployeeModel> _selectedEmployees = new();
    private List<OTRequestViewModel> _recentRequests = new();
    private OTValidationResultDto? _validationResult;

    private List<OTEmployeeModel> _deptEmployees = new();
    private Dictionary<int, List<F03OTApprover>> _approversByLevel = new();
    private Dictionary<int, F03OTApprover?> _selectedApprovers = new();

    // Dialog
    private bool _showEmployeePicker;
    private string _empSearchText = "";
    private HashSet<string> _tempSelected = new();


    // Giờ MẶC ĐỊNH cho cả đơn (mỗi nhân viên có thể override)
    // FIX: Dùng backing field + property để trigger recalc khi @bind không dùng được cùng TimeChanged
    private DateTime? _otDate = DateTime.Today;

    private TimeSpan? _defaultStartTimeBacking;
    private TimeSpan? _defaultStartTime
    {
        get => _defaultStartTimeBacking;
        set => _defaultStartTimeBacking = value;
    }

    private TimeSpan? _defaultEndTimeBacking;
    private TimeSpan? _defaultEndTime
    {
        get => _defaultEndTimeBacking;
        set => _defaultEndTimeBacking = value;
    }

    private readonly CancellationTokenSource _cts = new();
    // Khi user chọn ngày OT — gọi load đơn OT cùng ngày
    private async Task OnOTDateChanged(DateTime? date)
    {
        _otDate = date;
        if (!date.HasValue) return;

        _isLoadingTodayOT = true;
        StateHasChanged();

        try
        {
            var result = await OTService.GetDeptOTByDateAsync(date.Value, _cts.Token);
            if (result.IsSuccess && result.Data != null)
            {
                _todayOTRequests = result.Data;

                // Nếu có đơn OT trong ngày → hỏi user có muốn tham gia không
                if (_todayOTRequests.Any())
                    _showTodayOTDialog = true;
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "[OT_CREATE] Load today OT error");
        }
        finally
        {
            _isLoadingTodayOT = false;
            StateHasChanged();
        }
    }
    // Kiểm tra user đã có trong đơn OT chưa
    private bool IsAlreadyInOT(OTRequestViewModel ot) =>
        ot.Employees.Any(e => e.EmployeeCode == CurrentUser.User?.EmployeeCode);

    // Tham gia đơn OT đã có → điều hướng sang trang chi tiết để thêm mình vào
    private void JoinExistingOT(OTRequestViewModel ot)
    {
        _showTodayOTDialog = false;
        Nav.NavigateTo($"/ot/detail/{ot.Id}?addMe=true");
    }

    // Sửa OpenEmployeePicker — thêm StateHasChanged
    // THAY THẾ hoàn toàn method hiện tại:
    private void OpenEmployeePicker()
    {
        // 1. Reset search trước
        _empSearchText = "";

        // 2. Clear temp selection
        _tempSelected.Clear();

        // 3. Pre-tick những người đã trong danh sách (trừ bản thân)
        foreach (var e in _selectedEmployees.Where(e => !IsCurrentUser(e.EmployeeCode)))
            _tempSelected.Add(e.EmployeeCode);

        // 4. Log để debug
        Logger.LogInformation(
            "[OT_CREATE] OpenEmployeePicker: deptEmployees={Count}, filtered={F}",
            _deptEmployees.Count,
            FilteredDeptEmployees.Count());

        // 5. Mở dialog
        _showEmployeePicker = true;

        // StateHasChanged KHÔNG cần ở đây vì Blazor tự re-render sau event handler
    }
    // ── Style helpers ─────────────────────────────────────────────────────────
    private static string ThStyle(int w = 0) =>
        $"padding: 5px 6px; border: 1px solid rgba(255,255,255,0.3); text-align:center; white-space:nowrap;"
        + (w > 0 ? $" min-width:{w}px;" : "");

    // FIX: TdStyle phải là method (có thể gọi với hoặc không có tham số)
    private static string TdStyle(int w = 0) =>
        $"padding: 4px 5px; border: 1px solid var(--mud-palette-divider); vertical-align: middle;"
        + (w > 0 ? $" min-width:{w}px;" : "");

    // ── Recalc helpers ────────────────────────────────────────────────────────

    private void RecalcHours(OTEmployeeModel emp)
    {
        var start = emp.StartTime ?? _defaultStartTime;
        var end = emp.EndTime ?? _defaultEndTime;
        emp.OTHours = (start.HasValue && end.HasValue && end > start)
            ? (decimal)(end.Value - start.Value).TotalHours
            : 0;
    }

    // FIX: Tách thành 2 handler riêng để tránh conflict với @bind-Time
    private void OnDefaultStartTimeChanged(TimeSpan? value)
    {
        _defaultStartTime = value;
        RecalcAllWithoutOverride();
    }

    private void OnDefaultEndTimeChanged(TimeSpan? value)
    {
        _defaultEndTime = value;
        RecalcAllWithoutOverride();
    }

    private void RecalcAllWithoutOverride()
    {
        foreach (var emp in _selectedEmployees)
        {
            if (!emp.StartTime.HasValue || !emp.EndTime.HasValue)
                RecalcHours(emp);
        }
    }



    // ── Load balance sau khi thêm nhân viên ──────────────────────────────────
    private async Task LoadBalanceForEmployee(OTEmployeeModel emp)
    {
        emp.IsLoadingBalance = true;
        StateHasChanged();
        try
        {
            var result = await OTService.GetEmployeeBalanceAsync(
                emp.EmployeeCode,
                DateTime.Now.Year,
                _cts.Token);

            if (result.IsSuccess && result.Data != null)
                emp.Balance = result.Data;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "[OT_CREATE] LoadBalance error for {Code}", emp.EmployeeCode);
        }
        finally
        {
            emp.IsLoadingBalance = false;
            StateHasChanged();
        }
    }

    // ── Confirm chọn nhân viên từ dialog ─────────────────────────────────────
    private async Task ConfirmEmployeeSelection()
    {
        var added = new List<OTEmployeeModel>();

        foreach (var code in _tempSelected)
        {
            // Bỏ qua nếu đã có trong danh sách
            if (_selectedEmployees.Any(e => e.EmployeeCode == code)) continue;

            // Tìm trong _deptEmployees (đã load sẵn — không cần gọi API)
            var deptEmp = _deptEmployees.FirstOrDefault(e => e.EmployeeCode == code);
            if (deptEmp == null) continue;

            var newEmp = new OTEmployeeModel
            {
                EmployeeCode = deptEmp.EmployeeCode,
                EmployeeName = deptEmp.EmployeeName,
                DeptCode = deptEmp.DeptCode,
                DeptName = deptEmp.DeptName,
                CvCode = deptEmp.CvCode,
                OTTypeCode = _model?.OTTypeCode,
                OTReasonCategoryCode = OTReasonCategory.Other,
                StartTime = null,   // dùng giờ chung
                EndTime = null,
                OTHours = 0
            };

            _selectedEmployees.Add(newEmp);
            added.Add(newEmp);
        }

        _tempSelected.Clear();
        _empSearchText = "";
        _showEmployeePicker = false;

        // Load balance song song cho tất cả nhân viên vừa thêm
        if (added.Any())
            await Task.WhenAll(added.Select(LoadBalanceForEmployee));
    }

    private void RemoveEmployee(OTEmployeeModel emp) => _selectedEmployees.Remove(emp);

    private string GetWarningText(OTEmployeeModel emp)
    {
        var msgs = new List<string>();
        if (emp.WillExceedDailyLimit) msgs.Add($"Vượt giới hạn ngày ({emp.Balance?.DailyLimit}h)");
        if (emp.WillExceedMonthlyLimit) msgs.Add($"Vượt giới hạn tháng ({emp.Balance?.MonthlyLimit}h)");
        if (emp.WillExceedYearlyLimit) msgs.Add($"Vượt giới hạn năm ({emp.Balance?.YearlyLimit}h)");
        return string.Join(" | ", msgs);
    }

    // ── Computed ──────────────────────────────────────────────────────────────
    // THAY THẾ:
    private IEnumerable<OTEmployeeModel> FilteredDeptEmployees =>
        string.IsNullOrWhiteSpace(_empSearchText)
            ? _deptEmployees
            : _deptEmployees.Where(e =>
                (e.EmployeeName?.Contains(_empSearchText, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (e.EmployeeCode?.Contains(_empSearchText, StringComparison.OrdinalIgnoreCase) ?? false));

    private bool IsAllDeptSelected =>
        FilteredDeptEmployees.Any() &&
        FilteredDeptEmployees
            .Where(e => !IsCurrentUser(e.EmployeeCode))
            .All(e => _tempSelected.Contains(e.EmployeeCode));

    private bool IsCurrentUser(string code) => code == (CurrentUser.User?.EmployeeCode ?? "");

    private List<F03Approver> GetApproversForLevel(int level) =>
        _approversByLevel.TryGetValue(level, out var list) ? list : new();

    // ── Init ──────────────────────────────────────────────────────────────────
    protected override async Task OnInitializedAsync()
    {
        try
        {
            _isLoading = true;

            // Đảm bảo user đã load
            if (!CurrentUser.IsLoggedIn || string.IsNullOrEmpty(CurrentUser.User?.DeptCode))
                await CurrentUser.InitializeAsync();

            if (CurrentUser.User == null)
            {
                Nav.NavigateTo("/login");
                return;
            }

            // Lấy từ CurrentUser — nguồn tin cậy nhất ở client
            var myDeptCode = CurrentUser.User.DeptCode ?? "";
            var myEmpCode = CurrentUser.User.EmployeeCode ?? "";

            Logger.LogInformation(
                "[OT_CREATE] CurrentUser: Code={C} Dept={D} CV={V}",
                myEmpCode, myDeptCode, CurrentUser.User.CVCode);

            var combinedResult = await OTService.GetCombinedDataAsync(_cts.Token);

            if (combinedResult.IsSuccess && combinedResult.Data != null)
            {
                var combined = combinedResult.Data;
                _model = combined.OTForm;

                // 🔥 KEY: Luôn dùng CurrentUser làm nguồn chính
                _model.EmployeeCode = myEmpCode;
                _model.DeptCode = myDeptCode;
                _model.CvCode = CurrentUser.User.CVCode ?? "";
                _model.Balance = combined.Balance;
                _model.LimitRules = combined.LimitRules;
                _model.ApprovalSteps = combined.ApprovalSteps;

                _deptEmployees = combined.DeptEmployees;
                _approversByLevel = combined.ApproversByLevel;
                _recentRequests = combined.RecentOTRequests;
                _todayOTRequests = combined.TodayOTRequests ?? new();

                Logger.LogInformation(
                    "[OT_CREATE] After map: dept={D} employees={E} levels={L}",
                    _model.DeptCode,
                    _deptEmployees.Count,
                    string.Join(",", _approversByLevel.Keys));

                // Fallback: nếu server trả về DeptEmployees rỗng
                // (do server không có DeptCode khi build combined)
                if (!_deptEmployees.Any() && !string.IsNullOrEmpty(myDeptCode))
                {
                    Logger.LogWarning(
                        "[OT_CREATE] DeptEmployees rỗng, gọi fallback dept={D}",
                        myDeptCode);

                    var empResult = await OTService.GetDeptEmployeesAsync(
                        myDeptCode, _cts.Token);

                    if (empResult.IsSuccess && empResult.Data != null)
                    {
                        _deptEmployees = empResult.Data;
                        Logger.LogInformation(
                            "[OT_CREATE] Fallback OK: {Count} nhân viên",
                            _deptEmployees.Count);
                        StateHasChanged();
                    }
                    else
                    {
                        Logger.LogError(
                            "[OT_CREATE] Fallback FAILED: {Msg}",
                            empResult.Message);
                        Snackbar.Add(
                            $"Không tải được danh sách nhân viên phòng {myDeptCode}",
                            Severity.Warning);
                    }
                }

                // Thêm bản thân vào danh sách
                var me = new OTEmployeeModel
                {
                    EmployeeCode = myEmpCode,
                    EmployeeName = CurrentUser.User.FullName ?? "",
                    DeptCode = myDeptCode,
                    CvCode = CurrentUser.User.CVCode ?? "",
                    OTReasonCategoryCode = OTReasonCategory.Other,
                    OTHours = 0
                };
                _selectedEmployees.Add(me);
                _ = LoadBalanceForEmployee(me);

                // Auto-select approver
                foreach (var kv in _approversByLevel)
                {
                    _selectedApprovers[kv.Key] = kv.Value.Count == 1
                        ? kv.Value[0] : null;
                    if (_selectedApprovers[kv.Key] != null)
                        OnApproverChanged(kv.Key, _selectedApprovers[kv.Key]);
                }

                if (_todayOTRequests.Any())
                    _showTodayOTDialog = true;
            }
            else
            {
                Snackbar.Add(
                    combinedResult.Message ?? "Lỗi tải dữ liệu.",
                    Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "[OT_CREATE] Init error");
            Snackbar.Add("Lỗi hệ thống.", Severity.Error);
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }

    // ── Approver selection ────────────────────────────────────────────────────
    private void OnApproverChanged(int level, F03OTApprover? approver)
    {
        _selectedApprovers[level] = approver;
        if (_model == null) return;

        switch (level)
        {
            case 3:
                _model.Level3ApproveEmail = approver?.ApproverEmail;
                _model.Level3ApproveCode = approver?.ApproverCode;
                _model.Level3ApproveName = approver?.ApproverName;
                break;
            case 5:
                _model.Level5ApproveEmail = approver?.ApproverEmail;
                _model.Level5ApproveCode = approver?.ApproverCode;
                _model.Level5ApproveName = approver?.ApproverName;
                break;
            case 6:
                _model.Level6ApproveEmail = approver?.ApproverEmail;
                _model.Level6ApproveCode = approver?.ApproverCode;
                _model.Level6ApproveName = approver?.ApproverName;
                break;
            case 7:
                _model.Level7ApproveEmail = approver?.ApproverEmail;
                _model.Level7ApproveCode = approver?.ApproverCode;
                _model.Level7ApproveName = approver?.ApproverName;
                break;
        }
    }

    // ── Employee picker helpers ───────────────────────────────────────────────
    private void ToggleEmpTemp(string code, bool selected)
    {
        if (selected) _tempSelected.Add(code);
        else _tempSelected.Remove(code);
    }

    private void ToggleSelectAll(bool selectAll)
    {
        if (selectAll)
            foreach (var e in FilteredDeptEmployees.Where(e => !IsCurrentUser(e.EmployeeCode)))
                _tempSelected.Add(e.EmployeeCode);
        else
            _tempSelected.Clear();
    }

    // ── Submit ────────────────────────────────────────────────────────────────
    private async Task SubmitOT()
    {
        if (_model == null || !_otDate.HasValue)
        {
            Snackbar.Add("Vui lòng chọn ngày OT.", Severity.Warning);
            return;
        }

        if (!_selectedEmployees.Any())
        {
            Snackbar.Add("Phải có ít nhất 1 nhân viên OT.", Severity.Warning);
            return;
        }

        var invalidEmps = _selectedEmployees.Where(e =>
        {
            var s = e.StartTime ?? _defaultStartTime;
            var t = e.EndTime ?? _defaultEndTime;
            return !s.HasValue || !t.HasValue || t <= s;
        }).ToList();

        if (invalidEmps.Any())
        {
            Snackbar.Add($"{invalidEmps.Count} nhân viên chưa có giờ OT hợp lệ.", Severity.Warning);
            return;
        }

        _model.OTDate = _otDate.Value;
        _model.StartTime = _defaultStartTime ?? TimeSpan.Zero;
        _model.EndTime = _defaultEndTime ?? TimeSpan.Zero;

        foreach (var emp in _selectedEmployees)
        {
            if (!emp.StartTime.HasValue) emp.StartTime = _defaultStartTime;
            if (!emp.EndTime.HasValue) emp.EndTime = _defaultEndTime;
            RecalcHours(emp);
        }

        _model.Employees = _selectedEmployees;

        _isSubmitting = true;
        try
        {
            var result = await OTService.CreateOTRequestAsync(_model, _cts.Token);

            if (result.IsSuccess)
            {
                Snackbar.Add("Đã gửi đơn OT thành công!", Severity.Success);
                Nav.NavigateTo("/ot/history");
            }
            else
            {
                Snackbar.Add(result.Message ?? "Lỗi gửi đơn OT.", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "[OT_CREATE] Submit error");
            Snackbar.Add("Lỗi hệ thống.", Severity.Error);
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    // ── Helpers ───────────────────────────────────────────────────────────────
    private static Color GetStatusColor(string status) => status switch
    {
        OTStatus.Approved => Color.Success,
        OTStatus.Rejected => Color.Error,
        OTStatus.Cancelled => Color.Default,
        _ => Color.Warning
    };

    public void Dispose()
    {
        _cts.Cancel();
        _cts.Dispose();
    }
}
