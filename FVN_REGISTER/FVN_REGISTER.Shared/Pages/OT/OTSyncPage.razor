@page "/admin/ot-sync"
@attribute [Authorize]
@using FVN_REGISTER.Contract.Dtos.Depts
@using FVN_REGISTER.Contract.Dtos.OT
@using FVN_REGISTER.Core.Enums
@using FVN_REGISTER.Shared.Services.OTs
@using Microsoft.AspNetCore.Authorization
@inherits AppComponentBase
@implements IDisposable

@inject IOTSyncClientService SyncService
@inject ISnackbar Snackbar

<PageTitle>Đồng bộ chấm công OT</PageTitle>

<MudText Typo="Typo.h5" Class="mb-1"><MudIcon Icon="@Icons.Material.Filled.Sync" Class="mr-2" />Đồng bộ giờ OT thực tế</MudText>
<MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">Đồng bộ HRM và đối chiếu giờ OT theo ngày/phòng ban</MudText>

<MudCard Elevation="2" Class="mb-4">
    <MudCardHeader><CardHeaderContent><MudText Typo="Typo.subtitle1"><MudIcon Icon="@Icons.Material.Filled.MonitorHeart" Class="mr-1" /> Trạng thái Background Worker</MudText></CardHeaderContent><CardHeaderActions><MudIconButton Icon="@Icons.Material.Filled.Refresh" OnClick="CheckWorkerStatus" Disabled="_checkingStatus" /></CardHeaderActions></MudCardHeader>
    <MudCardContent>
        @if (_workerStatus == null) { <MudText Typo="Typo.body2" Color="Color.Secondary">Chưa tải trạng thái.</MudText> }
        else
        {
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Wrap="Wrap.Wrap">
                <MudChip T="string" Color="@GetWorkerColor(_workerStatus.State)">@_workerStatus.StateText</MudChip>
                <MudText Typo="Typo.caption">Server: @_workerStatus.ServerTime</MudText>
                @if (_workerStatus.LastRunAt.HasValue) { <MudText Typo="Typo.caption">Lần chạy: @_workerStatus.LastRunAt.Value.ToString("dd/MM HH:mm:ss")</MudText> }
                @if (_workerStatus.LastRunResult != null) { <MudText Typo="Typo.caption">Kết quả: @_workerStatus.LastRunResult</MudText> }
            </MudStack>
        }
    </MudCardContent>
</MudCard>

<MudCard Elevation="2" Class="mb-4">
    <MudCardContent>
        <MudGrid AlignItems="AlignItems.Center">
            <MudItem xs="12" sm="3"><MudDatePicker Label="Ngày cần đồng bộ" @bind-Date="_selectedDate" Variant="Variant.Outlined" Margin="Margin.Dense" DateFormat="dd/MM/yyyy" /></MudItem>
            <MudItem xs="12" sm="4"><MudSelect T="string" @bind-Value="_selectedDept" Label="Phòng ban" Clearable="true" Variant="Variant.Outlined" Margin="Margin.Dense">@foreach (var dept in _departments) { <MudSelectItem Value="@dept.DeptCode">@dept.DeptName</MudSelectItem> }</MudSelect></MudItem>
            <MudItem xs="12" sm="5"><MudStack Row="true" Spacing="2" Wrap="Wrap.Wrap">
                <MudButton Variant="Variant.Filled" Color="Color.Warning" StartIcon="@Icons.Material.Filled.Sync" OnClick="TriggerSync" Disabled="_isSyncing">@(_isSyncing ? "Đang sync..." : "Sync ngay")</MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.PlayArrow" OnClick="TriggerWorker" Disabled="_isReconciling">@(_isReconciling ? "Đang đối chiếu..." : "Đối chiếu ngay")</MudButton>
                <MudButton Variant="Variant.Outlined" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.BugReport" OnClick="TestWorkerRun" Disabled="_isTesting">@(_isTesting ? "Đang test..." : "Test worker")</MudButton>
            </MudStack></MudItem>
        </MudGrid>
    </MudCardContent>
</MudCard>

@if (_syncResult != null)
{
    <MudAlert Severity="Severity.Success" Dense="true" Class="mb-4">Đã đồng bộ ngày @_syncResult.WorkDate.ToString("dd/MM/yyyy"): <strong>@_syncResult.SyncedCount</strong> bản ghi.</MudAlert>
}
@if (_testResult != null)
{
    <MudAlert Severity="Severity.Info" Dense="true" Class="mb-4"><strong>Test worker:</strong> @_testResult.Reconciliation.Summary</MudAlert>
}
@if (_reconciliation != null)
{
    <MudCard Elevation="2" Class="mb-4">
        <MudCardHeader><CardHeaderContent><MudText Typo="Typo.subtitle1">Kết quả đối chiếu — @_reconciliation.WorkDate.ToString("dd/MM/yyyy")</MudText></CardHeaderContent></MudCardHeader>
        <MudCardContent>
            <MudStack Row="true" Spacing="2" Wrap="Wrap.Wrap" Class="mb-3">
                <MudChip T="string">Tổng @_reconciliation.TotalRows</MudChip><MudChip T="string" Color="Color.Success">Đã xử lý @_reconciliation.ProcessedCount</MudChip><MudChip T="string" Color="Color.Warning">Chờ xác nhận @_reconciliation.PendingConfirmCount</MudChip><MudChip T="string" Color="Color.Error">Chưa có đơn @_reconciliation.NoRequestCount</MudChip><MudChip T="string" Color="Color.Info">Cảnh báo @_reconciliation.WarningCount</MudChip>
            </MudStack>
            <MudText Typo="Typo.caption" Class="mb-3">@_reconciliation.Summary</MudText>
            <MudTable Items="_reconciliation.Items" Dense="true" Hover="true" Striped="true">
                <HeaderContent><MudTh>Phòng ban</MudTh><MudTh>Nhân viên</MudTh><MudTh>Ca</MudTh><MudTh>Giờ vào</MudTh><MudTh>Giờ ra</MudTh><MudTh>OT thực tế</MudTh><MudTh>OT kế hoạch</MudTh><MudTh>Đơn OT</MudTh><MudTh>Tình trạng</MudTh></HeaderContent>
                <RowTemplate>
                    <MudTd>@context.DeptName</MudTd><MudTd>@context.FullName (@context.EmployeeCode)</MudTd><MudTd>@context.ShiftName</MudTd><MudTd>@context.CheckInText</MudTd><MudTd>@context.CheckOutText</MudTd><MudTd>@context.OTHoursActual.ToString("N1")</MudTd><MudTd>@context.OTHoursPlanned.ToString("N1")</MudTd><MudTd>@(context.OTCode ?? "—")</MudTd><MudTd><MudChip T="string" Size="Size.Small" Color="@GetReconColor(context.Status)">@context.StatusDisplay</MudChip></MudTd>
                </RowTemplate>
            </MudTable>
        </MudCardContent>
    </MudCard>
}

@code {
    private DateTime? _selectedDate = DateTime.Today.AddDays(-1);
    private string? _selectedDept;
    private List<DeptOption> _departments = new();
    private OTWorkerStatusDto? _workerStatus;
    private OTSyncResponseDto? _syncResult;
    private OTReconciliationResultDto? _reconciliation;
    private OTWorkerTestRunResponseDto? _testResult;
    private bool _checkingStatus, _isSyncing, _isReconciling, _isTesting;
    private readonly CancellationTokenSource _cts = new();

    protected override async Task OnInitializedAsync() { await LoadDepartments(); await CheckWorkerStatus(); }

    private async Task LoadDepartments()
    {
        var result = await SyncService.GetDepartmentsAsync(_cts.Token);
        if (result.IsSuccess && result.Data != null) _departments = result.Data;
        else Snackbar.Add(result.Message ?? "Không tải được phòng ban.", Severity.Warning);
    }

    private async Task CheckWorkerStatus()
    {
        _checkingStatus = true;
        try { var result = await SyncService.GetWorkerStatusAsync(_cts.Token); if (result.IsSuccess) _workerStatus = result.Data; else Snackbar.Add(result.Message ?? "Không tải được trạng thái worker.", Severity.Warning); }
        finally { _checkingStatus = false; }
    }

    private async Task TriggerSync()
    {
        if (!_selectedDate.HasValue) return;
        _isSyncing = true;
        try { var result = await SyncService.SyncAsync(_selectedDate.Value, _selectedDept, _cts.Token); if (result.IsSuccess) { _syncResult = result.Data; Snackbar.Add($"Đã đồng bộ {result.Data?.SyncedCount ?? 0} bản ghi.", Severity.Success); } else Snackbar.Add(result.Message ?? "Sync thất bại.", Severity.Error); }
        finally { _isSyncing = false; }
    }

    private async Task TriggerWorker()
    {
        _isReconciling = true;
        try { var result = await SyncService.TriggerWorkerAsync(_selectedDept, _cts.Token); if (result.IsSuccess) { _reconciliation = result.Data; Snackbar.Add(result.Data?.Summary ?? "Đối chiếu hoàn thành.", Severity.Success); await CheckWorkerStatus(); } else Snackbar.Add(result.Message ?? "Đối chiếu thất bại.", Severity.Error); }
        finally { _isReconciling = false; }
    }

    private async Task TestWorkerRun()
    {
        if (!_selectedDate.HasValue) return;
        _isTesting = true;
        try { var result = await SyncService.TestWorkerRunAsync(_selectedDate.Value, _cts.Token); if (result.IsSuccess) { _testResult = result.Data; _reconciliation = result.Data?.Reconciliation; Snackbar.Add("Test worker hoàn thành.", Severity.Success); } else Snackbar.Add(result.Message ?? "Test worker thất bại.", Severity.Error); }
        finally { _isTesting = false; }
    }

    private static Color GetWorkerColor(WorkerRunState state) => state switch { WorkerRunState.Running => Color.Success, WorkerRunState.Waiting => Color.Info, WorkerRunState.Error => Color.Error, WorkerRunState.Stopped => Color.Default, _ => Color.Warning };
    private static Color GetReconColor(OTReconciliationStatus status) => status switch { OTReconciliationStatus.Processed => Color.Success, OTReconciliationStatus.PendingConfirm => Color.Warning, OTReconciliationStatus.NoRequest => Color.Error, OTReconciliationStatus.RequestNotApproved => Color.Warning, _ => Color.Info };
    public void Dispose() { _cts.Cancel(); _cts.Dispose(); }
}
