@page "/ot/history"
@attribute [Authorize]
@using FVN_REGISTER.Contract.ViewModels
@using FVN_REGISTER.Contract.ViewModels.OT
@using FVN_REGISTER.Contract.Utils
@using FVN_REGISTER.Shared.Services.OTs
@using FVN_REGISTER.Shared.Utils.Helpers
@using Microsoft.AspNetCore.Authorization
@inherits AppComponentBase
@implements IDisposable

@inject IOTClientService OTService
@inject ISnackbar Snackbar
@inject NavigationManager Nav
@inject IDialogService DialogService

<PageTitle>Lịch sử OT</PageTitle>

<MudStack Row="true" AlignItems="AlignItems.Center"
          Justify="Justify.SpaceBetween" Class="mb-4">
    <div>
        <MudText Typo="Typo.h5">
            <MudIcon Icon="@Icons.Material.Filled.History" Class="mr-2" />
            Lịch sử đăng ký OT
        </MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary">
            Quản lý và theo dõi các đơn OT của bạn
        </MudText>
    </div>
    <MudButton Variant="Variant.Filled" Color="Color.Primary"
               StartIcon="@Icons.Material.Filled.Add"
               OnClick="@(() => Nav.NavigateTo("/ot/create"))">
        Tạo đơn OT
    </MudButton>
</MudStack>

@* ── Filters ── *@
<MudPaper Elevation="1" Class="pa-3 mb-4">
    <MudGrid>
        <MudItem xs="12" sm="4">
            <MudSelect T="string" Label="Trạng thái"
                       @bind-Value="_filterStatus"
                       Variant="Variant.Outlined" Margin="Margin.Dense"
                       Clearable="true">
                <MudSelectItem Value="@((string?)null)">Tất cả</MudSelectItem>
                <MudSelectItem Value="@OTStatus.Pending">Chờ duyệt</MudSelectItem>
                <MudSelectItem Value="@OTStatus.ApprovedLv3">Lv3 đã duyệt</MudSelectItem>
                <MudSelectItem Value="@OTStatus.ApprovedLv5">Lv5 đã duyệt</MudSelectItem>
                <MudSelectItem Value="@OTStatus.ApprovedLv6">Lv6 đã duyệt</MudSelectItem>
                <MudSelectItem Value="@OTStatus.Approved">Đã duyệt hoàn tất</MudSelectItem>
                <MudSelectItem Value="@OTStatus.Rejected">Từ chối</MudSelectItem>
                <MudSelectItem Value="@OTStatus.Cancelled">Đã hủy</MudSelectItem>
            </MudSelect>
        </MudItem>
        <MudItem xs="6" sm="3">
            <MudDatePicker Label="Từ ngày" @bind-Date="_fromDate"
                           Variant="Variant.Outlined" Margin="Margin.Dense"
                           DateFormat="dd/MM/yyyy" Clearable="true" />
        </MudItem>
        <MudItem xs="6" sm="3">
            <MudDatePicker Label="Đến ngày" @bind-Date="_toDate"
                           Variant="Variant.Outlined" Margin="Margin.Dense"
                           DateFormat="dd/MM/yyyy" Clearable="true" />
        </MudItem>
        <MudItem xs="12" sm="2" Class="d-flex align-center">
            <MudButton Variant="Variant.Filled" Color="Color.Primary"
                       FullWidth="true"
                       StartIcon="@Icons.Material.Filled.Search"
                       OnClick="LoadData">
                Tìm kiếm
            </MudButton>
        </MudItem>
    </MudGrid>
</MudPaper>

@* ── Table ── *@
<MudPaper Elevation="2">
    <MudTable T="OTRequestViewModel"
              ServerData="ServerReload"
              @ref="_table"
              Dense="true"
              Hover="true"
              Loading="_isLoading"
              LoadingProgressColor="Color.Primary">

        <HeaderContent>
            <MudTh>
                <MudTableSortLabel T="OTRequestViewModel" SortLabel="OTDate">
                    Ngày OT
                </MudTableSortLabel>
            </MudTh>
            <MudTh>Giờ OT</MudTh>
            <MudTh>Loại OT</MudTh>
            <MudTh>Số NV</MudTh>
            <MudTh>Trạng thái</MudTh>
            <MudTh>Tiến độ duyệt</MudTh>
            <MudTh>Thao tác</MudTh>
        </HeaderContent>

        <RowTemplate>
            @* Ngày OT + ngày tạo *@
            <MudTd DataLabel="Ngày OT">
                <MudText Typo="Typo.body2">
                    <strong>@context.OTDate.ToString("dd/MM/yyyy")</strong>
                </MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary">
                    Tạo: @context.CreatedAt.ToString("HH:mm dd/MM")
                </MudText>
            </MudTd>

            @* Giờ bắt đầu – kết thúc + tổng giờ *@
            <MudTd DataLabel="Giờ OT">
                <MudText Typo="Typo.body2">
                    @* Dùng computed StartTimeText / EndTimeText từ ViewModel *@
                    @context.StartTimeText – @context.EndTimeText
                </MudText>
                <MudChip T="string" Size="Size.Small" Color="Color.Info" Label="true">
                    @context.TotalOTHours.ToString("0.##") h
                </MudChip>
            </MudTd>

            @* Loại OT *@
            <MudTd DataLabel="Loại OT">
                <MudChip T="string" Size="Size.Small"
                         Color="@GetOTTypeColor(context.OTTypeCode)"
                         Label="true">
                    @context.OTTypeName
                </MudChip>
            </MudTd>

            @* Số nhân viên — dùng EmployeeCount (int) thay vì Employees.Count *@
            <MudTd DataLabel="Số NV">
                <MudChip T="string" Size="Size.Small"
                         Color="Color.Default" Label="true">
                    @context.EmployeeCount người
                </MudChip>
            </MudTd>

            @* Trạng thái — dùng StatusText / StatusColor từ ViewModel *@
            <MudTd DataLabel="Trạng thái">
                <MudChip T="string" Size="Size.Small" Label="true"
                         Style="@($"background:{context.StatusColor};color:#fff;")">
                    @context.StatusText
                </MudChip>
            </MudTd>

            @* Tiến độ — dùng OTApprovalProgressBar + ApprovalSteps *@
            <MudTd DataLabel="Tiến độ">
                <OTApprovalProgressBar Steps="@context.ApprovalSteps" />
            </MudTd>

            @* Thao tác *@
            <MudTd>
                <MudStack Row="true" Spacing="0">
                    <MudIconButton Icon="@Icons.Material.Filled.Visibility"
                                   Size="Size.Small" Title="Xem chi tiết"
                                   OnClick="@(() => Nav.NavigateTo(
                                       $"/ot/detail/{context.Id}"))" />
                    @if (context.CanCancel)
                    {
                        <MudIconButton Icon="@Icons.Material.Filled.Cancel"
                                       Color="Color.Error"
                                       Size="Size.Small" Title="Hủy đơn"
                                       OnClick="@(() => CancelOT(context))" />
                    }
                </MudStack>
            </MudTd>
        </RowTemplate>

        <PagerContent>
            <MudTablePager PageSizeOptions="new int[]{10, 20, 50}" />
        </PagerContent>

        <NoRecordsContent>
            <MudText Color="Color.Secondary" Class="pa-4">
                Không có đơn OT nào.
            </MudText>
        </NoRecordsContent>

    </MudTable>
</MudPaper>

@code {
    private MudTable<OTRequestViewModel>? _table;
    private bool _isLoading;
    private string? _filterStatus;
    private DateTime? _fromDate;
    private DateTime? _toDate;
    private readonly CancellationTokenSource _cts = new();

    // ── Server-side paging ──────────────────────────────────────
    private async Task<TableData<OTRequestViewModel>> ServerReload(
        TableState state, CancellationToken ct)
    {
        _isLoading = true;
        try
        {
            var result = await OTService.GetPagedOTRequestsAsync(
                deptCode: null,
                status:   _filterStatus,
                fromDate: _fromDate,
                toDate:   _toDate,
                page:     state.Page + 1,   // MudTable is 0-based
                pageSize: state.PageSize,
                ct:       ct);

            if (result.IsSuccess && result.Data != null)
                return new TableData<OTRequestViewModel>
                {
                    Items      = result.Data.Data,
                    TotalItems = result.Data.TotalCount
                };

            Snackbar.Add(result.Message ?? "Lỗi tải dữ liệu.", Severity.Warning);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "[OT_HISTORY] ServerReload error");
            Snackbar.Add("Lỗi hệ thống khi tải lịch sử OT.", Severity.Error);
        }
        finally
        {
            _isLoading = false;
        }

        return new TableData<OTRequestViewModel>
        {
            Items      = new List<OTRequestViewModel>(),
            TotalItems = 0
        };
    }

    private async Task LoadData() => await _table!.ReloadServerData();

    // ── Cancel ──────────────────────────────────────────────────
    private async Task CancelOT(OTRequestViewModel ot)
    {
        var confirmed = await DialogService.ShowMessageBoxAsync(
            "Xác nhận hủy đơn OT",
            $"Bạn có chắc muốn hủy đơn OT ngày {ot.OTDate:dd/MM/yyyy}?",
            yesText: "Hủy đơn", cancelText: "Không");

        if (confirmed != true) return;

        var response = await OTService.CancelAsync(ot.Id, "Người dùng hủy", _cts.Token);

        if (response.IsSuccess)
        {
            Snackbar.Add("Đã hủy đơn OT.", Severity.Success);
            await _table!.ReloadServerData();
        }
        else
        {
            Snackbar.Add(response.Message ?? "Lỗi hủy đơn.", Severity.Error);
        }
    }

    // ── Helpers ─────────────────────────────────────────────────

    // Màu chip theo loại OT (Normal/Weekend/Holiday/Tet)
    private static Color GetOTTypeColor(string typeCode) => typeCode switch
    {
        "WEEKDAY"  => Color.Default,
        "WEEKEND"  => Color.Warning,
        "HOLIDAY"  => Color.Error,
        "TET"      => Color.Secondary,
        _          => Color.Info
    };

    // ── Lifecycle ───────────────────────────────────────────────
    public void Dispose()
    {
        _cts.Cancel();
        _cts.Dispose();
    }
}