@page "/"
@attribute [Authorize]
@using FVN_REGISTER.Contract.Responses
@using FVN_REGISTER.Shared.Components
@using FVN_REGISTER.Shared.Services.Dashboards
@using FVN_REGISTER.Shared.Services.Users
@using Microsoft.AspNetCore.Authorization
@inherits AppComponentBase
@implements IDisposable

@inject IDashboardClientService DashboardService
@inject ICurrentUserClientService CurrentUserService
@inject ISnackbar Snackbar
@inject NavigationManager Navigation

<PageTitle>Trang chủ</PageTitle>

@if (_isLoading)
{
    <MudContainer MaxWidth="MaxWidth.Large" Class="py-6">
        <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="190px" Style="border-radius:24px" Class="mb-4" />
        <MudGrid Spacing="3">
            @for (var i = 0; i < 4; i++)
            {
                <MudItem xs="6" sm="3"><MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="110px" Style="border-radius:18px" /></MudItem>
            }
        </MudGrid>
    </MudContainer>
}
else if (_model != null)
{
    <MudContainer MaxWidth="MaxWidth.Large" Class="py-5">
        <MudPaper Elevation="0" Class="pa-6 mb-5" Style="border-radius:24px; background:linear-gradient(135deg, rgba(25,118,210,.12), rgba(0,150,136,.08)); border:1px solid rgba(25,118,210,.10)">
            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Spacing="4" Wrap="Wrap.Wrap">
                <div>
                    <MudText Typo="Typo.overline" Color="Color.Primary">FVN REGISTER • WORKSPACE</MudText>
                    <MudText Typo="Typo.h4" Style="font-weight:850">
                        Xin chào, @(CurrentUserService.User?.FullName ?? "Cán bộ FCC")
                    </MudText>
                    <MudText Typo="Typo.body2" Class="mt-1 mud-text-secondary">
                        Đây là trung tâm công việc cá nhân: theo dõi đơn, xử lý phê duyệt và các thông tin cần chú ý.
                    </MudText>
                </div>
                <MudStack Row="true" Spacing="1">
                    <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Campaign"
                               OnClick="@(() => Navigation.NavigateTo("/thong-tin-cong-khai"))">
                        Thông tin
                    </MudButton>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
                               OnClick="@(() => Navigation.NavigateTo("/leave/create"))">
                        Tạo đơn nghỉ
                    </MudButton>
                </MudStack>
            </MudStack>
        </MudPaper>

        <MudText Typo="Typo.h6" Class="mb-3" Style="font-weight:750">Trung tâm công việc</MudText>
        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mb-4">Thông báo và phê duyệt dùng chung một Action Center. Thiết bị cũng được mở ngay trong Workspace.</MudAlert>
        <MudGrid Spacing="3" Class="mb-5">
            <MudItem xs="12" sm="4">
                <MudCard Elevation="1" Style="height:100%; border-radius:18px; cursor:pointer" @onclick="@(() => Navigation.NavigateTo("/work/inbox"))">
                    <MudCardContent Class="pa-5">
                        <MudIcon Icon="@Icons.Material.Filled.TaskAlt" Color="Color.Primary" Size="Size.Large" />
                        <MudText Typo="Typo.h6" Class="mt-3">Phê duyệt</MudText>
                        <MudText Typo="Typo.body2" Class="mud-text-secondary">Tập trung các việc đang chờ xử lý theo quyền của tài khoản.</MudText>
                    </MudCardContent>
                </MudCard>
            </MudItem>
            <MudItem xs="12" sm="4">
                <MudCard Elevation="1" Style="height:100%; border-radius:18px; cursor:pointer" @onclick="@(() => Navigation.NavigateTo("/history/leave"))">
                    <MudCardContent Class="pa-5">
                        <MudIcon Icon="@Icons.Material.Filled.EventAvailable" Color="Color.Success" Size="Size.Large" />
                        <MudText Typo="Typo.h6" Class="mt-3">Nghỉ phép của tôi</MudText>
                        <MudText Typo="Typo.body2" Class="mud-text-secondary">Xem số dư, lịch sử và trạng thái các đơn nghỉ.</MudText>
                    </MudCardContent>
                </MudCard>
            </MudItem>
            <MudItem xs="12" sm="4">
                <MudCard Elevation="1" Style="height:100%; border-radius:18px; cursor:pointer" @onclick="@(() => Navigation.NavigateTo("/history/ot"))">
                    <MudCardContent Class="pa-5">
                        <MudIcon Icon="@Icons.Material.Filled.Schedule" Color="Color.Warning" Size="Size.Large" />
                        <MudText Typo="Typo.h6" Class="mt-3">OT của tôi</MudText>
                        <MudText Typo="Typo.body2" Class="mud-text-secondary">Theo dõi giờ OT và các yêu cầu đã gửi.</MudText>
                    </MudCardContent>
                </MudCard>
            </MudItem>
        </MudGrid>

        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-3">
            <MudText Typo="Typo.h6" Style="font-weight:750">Tổng quan cá nhân</MudText>
            <MudText Typo="Typo.caption" Class="mud-text-secondary">Cập nhật @_loadedAt?.ToString("dd/MM/yyyy HH:mm")</MudText>
        </MudStack>

        <MudPaper Outlined="true" Class="pa-4 mb-4" Style="border-radius:18px">
            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                <div><MudText Typo="Typo.h6">Thiết bị</MudText><MudText Typo="Typo.body2" Class="mud-text-secondary">Schema theo phòng ban và Excel import nằm trong cùng workspace.</MudText></div>
                <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Devices" OnClick="@(() => Navigation.NavigateTo("/equipment/workspace"))">Mở Equipment</MudButton>
            </MudStack>
        </MudPaper>

        <EquipmentDashboardTile />
        <DashboardOverview Data="_model" />
    </MudContainer>
}
else if (!string.IsNullOrWhiteSpace(_errorMessage))
{
    <MudContainer MaxWidth="MaxWidth.Large" Class="py-6">
        <MudAlert Severity="Severity.Error">@_errorMessage</MudAlert>
    </MudContainer>
}
else
{
    <MudContainer MaxWidth="MaxWidth.Large" Class="py-6">
        <MudAlert Severity="Severity.Info">Dashboard chưa có dữ liệu để hiển thị.</MudAlert>
    </MudContainer>
}

@code {
    private DashboardResponse? _model;
    private bool _isLoading = true;
    private string? _errorMessage;
    private DateTime? _loadedAt;
    private readonly CancellationTokenSource _cts = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await CurrentUserService.InitializeAsync();

            if (!CurrentUserService.IsLoggedIn)
            {
                _errorMessage = "Phiên đăng nhập không hợp lệ hoặc đã hết hạn.";
                return;
            }

            var result = await DashboardService.GetDashboardDataAsync(_cts.Token);
            if (result.IsSuccess && result.Data != null)
            {
                _model = result.Data;
                _loadedAt = DateTime.Now;
            }
            else if (result.IsUnauthorized)
            {
                _errorMessage = "Phiên đăng nhập đã hết hạn. Vui lòng đăng nhập lại.";
            }
            else
            {
                _errorMessage = result.Message ?? "Không thể tải Dashboard.";
            }
        }
        catch (OperationCanceledException) when (_cts.IsCancellationRequested)
        {
        }
        catch (Exception ex)
        {
            _errorMessage = $"Không thể tải Dashboard: {ex.Message}";
            Snackbar.Add(_errorMessage, Severity.Error);
        }
        finally
        {
            _isLoading = false;
        }
    }

    public void Dispose()
    {
        _cts.Cancel();
        _cts.Dispose();
    }
}