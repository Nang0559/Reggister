@page "/"
@attribute [Authorize]
@using FVN_REGISTER.Contract.Responses
@using FVN_REGISTER.Shared.Components
@using FVN_REGISTER.Shared.Services.Dashboards
@using FVN_REGISTER.Shared.Services.Users
@using Microsoft.AspNetCore.Authorization
@inherits AppComponentBase
@implements IDisposable

@inject IDashboardClientService DashboardService
@inject ICurrentUserClientService CurrentUserService
@inject ISnackbar Snackbar

@if (_isLoading)
{
    <div style="padding:24px 0"><MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="120px" Class="mb-4" Style="border-radius:16px" /><MudGrid Spacing="3" Class="mb-4"><MudItem xs="4"><MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="80px" Style="border-radius:12px" /></MudItem><MudItem xs="4"><MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="80px" Style="border-radius:12px" /></MudItem><MudItem xs="4"><MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="80px" Style="border-radius:12px" /></MudItem></MudGrid></div>
}
else if (_model != null)
{
    <MudText Typo="Typo.h5" Class="mb-4">Chào mừng, @(CurrentUserService.User?.FullName ?? "Cán bộ FCC")!</MudText>
    <EquipmentDashboardTile />
    <DashboardOverview Data="_model" />
}
else if (!string.IsNullOrWhiteSpace(_errorMessage))
{
    <MudAlert Severity="Severity.Error">@_errorMessage</MudAlert>
}
else
{
    <MudAlert Severity="Severity.Info">
        Dashboard không có dữ liệu để hiển thị.
    </MudAlert>
}

@code {
    private DashboardResponse? _model;
    private bool _isLoading = true;
    private string? _errorMessage;
    private readonly CancellationTokenSource _cts = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await CurrentUserService.InitializeAsync();

            if (!CurrentUserService.IsLoggedIn)
            {
                _errorMessage = "Phiên đăng nhập không hợp lệ hoặc đã hết hạn.";
                return;
            }

            var result = await DashboardService.GetDashboardDataAsync(_cts.Token);

            if (result.IsSuccess && result.Data != null)
            {
                _model = result.Data;
            }
            else if (result.IsUnauthorized)
            {
                _errorMessage = "Phiên đăng nhập đã hết hạn. Vui lòng đăng nhập lại.";
            }
            else
            {
                _errorMessage = result.Message ?? "Không thể tải Dashboard.";
            }
        }
        catch (OperationCanceledException) when (_cts.IsCancellationRequested)
        {
        }
        catch (Exception ex)
        {
            _errorMessage = $"Không thể tải Dashboard: {ex.Message}";
            Snackbar.Add(_errorMessage, Severity.Error);
        }
        finally
        {
            _isLoading = false;
        }
    }

    public void Dispose()
    {
        _cts.Cancel();
        _cts.Dispose();
    }
}
