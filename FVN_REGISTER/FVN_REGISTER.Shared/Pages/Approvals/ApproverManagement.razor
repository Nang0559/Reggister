@page "/admin/approvers"
@attribute [Authorize]
@using FVN_REGISTER.Contract.Dtos.Approvals
@using FVN_REGISTER.Contract.Dtos.Depts
@using FVN_REGISTER.Core.Enums
@using FVN_REGISTER.Shared.Dialogs.Approvals
@using FVN_REGISTER.Shared.Services.Approvals
@using Microsoft.AspNetCore.Authorization
@inherits AppComponentBase

@inject IApproverClientService ApproverService
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>Quản lý Approver - FCC</PageTitle>

<MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-4">
    <MudIcon Icon="@Icons.Material.Filled.VerifiedUser" Color="Color.Primary" Size="Size.Large" />
    <div><MudText Typo="Typo.h5">Quản lý Người Phê Duyệt</MudText><MudText Typo="Typo.caption" Color="Color.Secondary">Cấu hình approver theo bộ phận và cấp duyệt</MudText></div>
    <MudSpacer />
    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.PersonAdd" OnClick="OpenCreateDialog">Thêm Approver</MudButton>
</MudStack>

<MudPaper Elevation="1" Class="pa-3 mb-4">
    <MudGrid>
        <MudItem xs="12" sm="4"><MudSelect T="string" Label="Bộ phận" @bind-Value="_filterDept" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true">
            @foreach (var dept in _departments) { <MudSelectItem Value="@dept.DeptCode">@dept.DeptName</MudSelectItem> }
        </MudSelect></MudItem>
        <MudItem xs="12" sm="3"><MudSelect T="int?" Label="Cấp duyệt" @bind-Value="_filterLevel" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true">
            @for (var level = 1; level <= 5; level++) { var l = level; <MudSelectItem T="int?" Value="@((int?)l)">Cấp @l</MudSelectItem> }
        </MudSelect></MudItem>
        <MudItem xs="12" sm="3"><MudSelect T="RequestModule?" Label="Loại đơn" @bind-Value="_filterType" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true">
            <MudSelectItem T="RequestModule?" Value="@((RequestModule?)RequestModule.Leave)">Nghỉ phép</MudSelectItem>
            <MudSelectItem T="RequestModule?" Value="@((RequestModule?)RequestModule.Overtime)">OT</MudSelectItem>
        </MudSelect></MudItem>
        <MudItem xs="12" sm="2"><MudButton FullWidth="true" Variant="Variant.Outlined" OnClick="ResetFilter">Tất cả</MudButton></MudItem>
    </MudGrid>
</MudPaper>

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" />
}
else
{
    <MudTable Items="FilteredItems" Dense="true" Hover="true" Striped="true">
        <HeaderContent><MudTh>Bộ phận</MudTh><MudTh>Loại đơn</MudTh><MudTh>Cấp</MudTh><MudTh>Approver</MudTh><MudTh>Email</MudTh><MudTh>Trạng thái</MudTh><MudTh></MudTh></HeaderContent>
        <RowTemplate>
            <MudTd>@context.ApproveForDeptName (@context.ApproveForDeptCode)</MudTd>
            <MudTd>@context.RequestType</MudTd>
            <MudTd><MudChip T="string" Size="Size.Small" Color="@GetLevelColor(context.Level)">@(context.RoleName ?? $"Cấp {context.Level}")</MudChip></MudTd>
            <MudTd>@context.ApproverName <MudText Typo="Typo.caption">@context.ApproverCode</MudText></MudTd>
            <MudTd>@context.ApproverEmail</MudTd>
            <MudTd><MudChip T="string" Size="Size.Small" Color="@(context.IsActive ? Color.Success : Color.Default)">@(context.IsActive ? "Hoạt động" : "Tắt")</MudChip></MudTd>
            <MudTd><MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" OnClick="@(() => OpenEditDialog(context))" /><MudIconButton Icon="@(context.IsActive ? Icons.Material.Filled.ToggleOff : Icons.Material.Filled.ToggleOn)" Size="Size.Small" OnClick="@(() => ToggleApprover(context))" /><MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" OnClick="@(() => ConfirmDelete(context))" /></MudTd>
        </RowTemplate>
        <NoRecordsContent><MudText Class="pa-6" Color="Color.Secondary">Không có approver phù hợp.</MudText></NoRecordsContent>
    </MudTable>
}

@code {
    private List<ApproverDto> _items = new();
    private List<DepartmentDto> _departments = new();
    private bool _loading;
    private string? _filterDept;
    private int? _filterLevel;
    private RequestModule? _filterType;

    private IEnumerable<ApproverDto> FilteredItems => _items;

    protected override async Task OnInitializedAsync()
    {
        await LoadDepartments();
        await LoadAsync();
    }

    private async Task LoadDepartments()
    {
        var result = await ApproverService.GetDepartmentsAsync();
        if (result.IsSuccess && result.Data != null) _departments = result.Data;
    }

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            var result = await ApproverService.GetListAsync(_filterDept, _filterLevel, _filterType?.ToString());
            if (result.IsSuccess && result.Data != null) _items = result.Data;
            else Snackbar.Add(result.Message ?? "Lỗi tải approver.", Severity.Error);
        }
        finally { _loading = false; }
    }

    private async Task ResetFilter()
    {
        _filterDept = null; _filterLevel = null; _filterType = null; await LoadAsync();
    }

    private async Task OpenCreateDialog()
    {
        var model = new ApproverDto { IsActive = true, RequestType = RequestModule.Leave, Level = 1 };
        await ShowDialog(model, false);
    }

    private async Task OpenEditDialog(ApproverDto item) => await ShowDialog(item, false);

    private async Task ShowDialog(ApproverDto model, bool lockDept)
    {
        var parameters = new DialogParameters<ApproverEditDialog>
        {
            { x => x.Model, model }, { x => x.Departments, _departments }, { x => x.LockDept, lockDept }
        };
        var dialog = await DialogService.ShowAsync<ApproverEditDialog>("", parameters, new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseOnEscapeKey = true });
        var result = await dialog.Result;
        if (result is { Canceled: false }) await LoadAsync();
    }

    private async Task ToggleApprover(ApproverDto item)
    {
        var result = await ApproverService.ToggleAsync(item.Id);
        Snackbar.Add(result.IsSuccess ? result.Message ?? "Đã cập nhật." : result.Message ?? "Lỗi.", result.IsSuccess ? Severity.Success : Severity.Error);
        if (result.IsSuccess) await LoadAsync();
    }

    private async Task ConfirmDelete(ApproverDto item)
    {
        var confirm = await DialogService.ShowMessageBoxAsync("Xác nhận xóa", $"Xóa approver {item.ApproverName}?", yesText: "Xóa", cancelText: "Hủy");
        if (confirm != true) return;
        var result = await ApproverService.DeleteAsync(item.Id);
        Snackbar.Add(result.IsSuccess ? "Đã xóa approver." : result.Message ?? "Lỗi xóa.", result.IsSuccess ? Severity.Success : Severity.Error);
        if (result.IsSuccess) await LoadAsync();
    }

    private static Color GetLevelColor(int level) => level switch { 1 => Color.Info, 2 => Color.Primary, 3 => Color.Warning, 4 => Color.Error, _ => Color.Default };
}
