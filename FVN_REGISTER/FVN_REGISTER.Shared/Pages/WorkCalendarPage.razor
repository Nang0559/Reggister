@page "/calendar"
@attribute [Authorize]
@using FVN_REGISTER.Contract.Dtos.Calendar
@using FVN_REGISTER.Contract.Dtos.Security
@using FVN_REGISTER.Shared.Services.Security
@using FVN_REGISTER.Shared.Services.Users
@using FVN_REGISTER.Shared.Components.Calendar
@using FVN_REGISTER.Shared.Services.Calendar
@using Microsoft.AspNetCore.Authorization
@inherits AppComponentBase
@inject NavigationManager NavigationManager
@inject IWorkCalendarClientService CalendarService
@inject IDialogService DialogService
@inject ISecurityClientService SecurityService
@inject ICurrentUserClientService CurrentUser

<PageTitle>Lịch làm việc của tôi</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="py-5">
    <MudPaper Elevation="0" Class="pa-6 mb-4"
              Style="border-radius:24px; background:linear-gradient(135deg, rgba(25,118,210,.12), rgba(0,150,136,.08)); border:1px solid rgba(25,118,210,.10)">
        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap" Spacing="3">
            <div>
                <MudText Typo="Typo.overline" Color="Color.Primary">FVN REGISTER • CALENDAR</MudText>
                <MudText Typo="Typo.h4" Style="font-weight:850">@(_selectedEmployeeCode == null ? "Lịch làm việc của tôi" : "Lịch làm việc theo phạm vi quản lý")</MudText>
                <MudText Typo="Typo.body2" Class="mt-1 mud-text-secondary">
                    Tổng quan chấm công, nghỉ phép, OT và công tác theo ngày.
                </MudText>
            </div>
            @if (_managedEmployees.Count > 0)
            {
                <MudSelect T="string" Value="_selectedEmployeeCode" ValueChanged="OnEmployeeChanged"
                           Label="Phạm vi lịch" Variant="Variant.Outlined" Dense="true" Style="min-width:280px">
                    <MudSelectItem Value="@((string?)null)">Cá nhân của tôi</MudSelectItem>
                    @foreach (var employee in _managedEmployees)
                    {
                        <MudSelectItem Value="@employee.EmployeeCode">
                            @employee.EmployeeCode · @employee.EmployeeName
                        </MudSelectItem>
                    }
                </MudSelect>
            }
            <MudButton Variant="Variant.Outlined"
                       StartIcon="@Icons.Material.Filled.Home"
                       OnClick="@(() => NavigationManager.NavigateTo("/"))">
                Trang chủ
            </MudButton>
        </MudStack>
    </MudPaper>

    @if (_alerts.Count > 0)
    {
        <MudPaper Outlined="true" Class="pa-4 mb-4" Style="border-radius:18px">
            <MudStack Spacing="2">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                    <MudIcon Icon="@Icons.Material.Filled.NotificationImportant" Color="Color.Warning" />
                    <MudText Typo="Typo.h6" Style="font-weight:750">Cần xử lý trong tháng</MudText>
                    <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Outlined">
                        @_alerts.Count
                    </MudChip>
                </MudStack>

                @foreach (var alert in _alerts)
                {
                    <MudPaper Outlined="true" Class="pa-3"
                              Style="border-radius:12px; border-left:4px solid var(--mud-palette-warning);">
                        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap" Spacing="2">
                            <div>
                                <MudText Typo="Typo.body2" Style="font-weight:700">
                                    @alert.WorkDate.ToString("dd/MM/yyyy") · @alert.ModuleCode
                                </MudText>
                                <MudText Typo="Typo.body2">@alert.Summary</MudText>
                            </div>
                            @if (alert.RequiresAction && alert.ActionId is not null)
                            {
                                <MudButton Size="Size.Small"
                                           Variant="Variant.Filled"
                                           Color="Color.Warning"
                                           OnClick="@(() => OpenAction(alert.DetailRoute, alert.SourceId))">
                                    Xử lý
                                </MudButton>
                            }
                            else if (!string.IsNullOrWhiteSpace(alert.DetailRoute))
                            {
                                <MudButton Size="Size.Small"
                                           Variant="Variant.Outlined"
                                           OnClick="@(() => OpenRoute(alert.DetailRoute))">
                                    Xem chi tiết
                                </MudButton>
                            }
                        </MudStack>
                    </MudPaper>
                }
            </MudStack>
        </MudPaper>
    }

    <MudPaper Outlined="true" Class="pa-3" Style="border-radius:18px">
        <WorkCalendar @key="_selectedEmployeeCode" EmployeeCode="_selectedEmployeeCode" ModuleContext="ALL"
                      OnEventSelected="HandleEventSelected"
                      OnRegistrationRequested="HandleRegistrationRequested" />
    </MudPaper>
</MudContainer>

@code {
    private readonly List<CalendarAlertItemDto> _alerts = new();
    private readonly List<ManagedEmployeeDto> _managedEmployees = new();
    private string? _selectedEmployeeCode;

    protected override async Task OnInitializedAsync()
    {
        var today = DateTime.Today;
        var from = new DateTime(today.Year, today.Month, 1);
        var to = from.AddMonths(1).AddDays(-1);

        try
        {
            await CurrentUser.InitializeAsync();

            if (CurrentUser.User?.UserId is int currentUserId && currentUserId > 0)
            {
                var managed = await SecurityService.GetMyManagedEmployeesAsync();
                if (managed.IsSuccess && managed.Data != null)
                    _managedEmployees.AddRange(managed.Data);
            }

            await LoadAlertsAsync(from, to);
        }
        catch
        {
            // Calendar itself remains usable when the alert endpoint is temporarily unavailable.
        }
    }

    private async Task LoadAlertsAsync(DateTime from, DateTime to)
    {
        _alerts.Clear();
        var result = string.IsNullOrWhiteSpace(_selectedEmployeeCode)
            ? await CalendarService.GetAlertsAsync(from, to)
            : await CalendarService.GetAlertsForEmployeeAsync(_selectedEmployeeCode!, from, to);

        if (result.IsSuccess && result.Data != null)
            _alerts.AddRange(result.Data);
    }

    private async Task OnEmployeeChanged(string? employeeCode)
    {
        _selectedEmployeeCode = string.IsNullOrWhiteSpace(employeeCode) ? null : employeeCode;
        var today = DateTime.Today;
        var from = new DateTime(today.Year, today.Month, 1);
        var to = from.AddMonths(1).AddDays(-1);
        await LoadAlertsAsync(from, to);
    }

    private async Task HandleRegistrationRequested(DateTime date)
    {
        var result = await CalendarService.GetAvailabilityAsync(date);
        if (!result.IsSuccess || result.Data == null)
        {
            return;
        }

        var parameters = new DialogParameters
        {
            [nameof(CalendarRegistrationDialog.Date)] = date,
            [nameof(CalendarRegistrationDialog.Availability)] = result.Data,
            [nameof(CalendarRegistrationDialog.OnSelected)] =
                EventCallback.Factory.Create<string>(this, module => OpenRegistration(module, date))
        };

        await DialogService.ShowAsync<CalendarRegistrationDialog>(
            "Đăng ký từ lịch",
            parameters,
            new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseOnEscapeKey = true });
    }

    private void OpenRegistration(string moduleCode, DateTime date)
    {
        var route = moduleCode switch
        {
            "LEAVE" => $"/leave/create?date={date:yyyy-MM-dd}",
            "OT" => $"/ot/create?date={date:yyyy-MM-dd}",
            "TRIP" => $"/trip/create?date={date:yyyy-MM-dd}",
            _ => "/calendar"
        };

        NavigationManager.NavigateTo(route);
    }

    private void HandleEventSelected(CalendarItemDto item)
    {
        if (item.RequiresAction && item.ActionId is not null)
        {
            OpenAction(item.DetailRoute, item.SourceId);
            return;
        }

        if (!string.IsNullOrWhiteSpace(item.DetailRoute))
        {
            OpenRoute(item.DetailRoute);
            return;
        }

        if (int.TryParse(item.SourceId, out var requestId))
        {
            NavigationManager.NavigateTo($"/history/{item.ModuleCode.ToLowerInvariant()}?id={requestId}");
        }
    }

    private void OpenAction(string? detailRoute, string sourceId)
    {
        var route = !string.IsNullOrWhiteSpace(detailRoute)
            ? detailRoute
            : $"/execution?reconciliationId={Uri.EscapeDataString(sourceId)}";

        NavigationManager.NavigateTo(route);
    }

    private void OpenRoute(string? route)
    {
        if (!string.IsNullOrWhiteSpace(route))
            NavigationManager.NavigateTo(route);
    }
}
