@page "/admin/hrm-sync-review"
@attribute [Authorize]
@using FVN_REGISTER.Contract.Dtos.HrmSync
@using FVN_REGISTER.Shared.Services.HrmSync
@using FVN_REGISTER.Shared.Services.Language
@using Microsoft.AspNetCore.Authorization
@inherits AppComponentBase

@inject IHrmSyncReviewClientService ReviewService
@inject ISnackbar Snackbar
@inject NavigationManager Navigation
@inject ILanguageService Language

<PageTitle>@Language.T("hrm.review.title")</PageTitle>

<MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-4">
    <MudStack Spacing="0">
        <MudText Typo="Typo.h5">@Language.T("hrm.review.heading")</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary">@Language.T("hrm.review.description")</MudText>
    </MudStack>
    <MudStack Row="true" Spacing="2">
        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Sync" OnClick="@(() => Navigation.NavigateTo("/admin/hrm-sync"))">@Language.T("hrm.review.manageSync")</MudButton>
        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Refresh" OnClick="LoadAsync" Disabled="@_loading">@Language.T("common.refresh")</MudButton>
    </MudStack>
</MudStack>

<MudAlert Severity="Severity.Info" Class="mb-4">@Language.T("hrm.review.pendingCount", _count)</MudAlert>

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" />
}
else if (!_items.Any())
{
    <MudAlert Severity="Severity.Success">@Language.T("hrm.review.empty")</MudAlert>
}
else
{
    <MudTable Items="_items" Dense="true" Hover="true" Striped="true">
        <HeaderContent>
            <MudTh>@Language.T("hrm.review.entity")</MudTh>
            <MudTh>@Language.T("hrm.review.key")</MudTh>
            <MudTh>@Language.T("hrm.review.flagType")</MudTh>
            <MudTh>@Language.T("common.note")</MudTh>
            <MudTh>@Language.T("hrm.review.detectedAt")</MudTh>
            <MudTh></MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd>@context.EntityType</MudTd>
            <MudTd><b>@context.EntityKey</b></MudTd>
            <MudTd><MudChip T="string" Size="Size.Small" Color="Color.Warning">@context.FlagType</MudChip></MudTd>
            <MudTd>@context.Message</MudTd>
            <MudTd>@context.DetectedAt.ToString("dd/MM/yyyy HH:mm")</MudTd>
            <MudTd>
                <MudButton Size="Size.Small" Color="Color.Primary" Variant="Variant.Outlined" OnClick="@(() => ResolveAsync(context))">@Language.T("hrm.review.resolve")</MudButton>
            </MudTd>
        </RowTemplate>
    </MudTable>
}

@code {
    private List<SyncReviewFlagDto> _items = new();
    private int _count;
    private bool _loading;

    protected override async Task OnInitializedAsync()
    {
        await Language.InitializeAsync();
        Language.LanguageChanged += OnLanguageChanged;
        await LoadAsync();
    }

    private void OnLanguageChanged(object? sender, EventArgs e) => InvokeAsync(StateHasChanged);

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            var result = await ReviewService.GetUnresolvedAsync(ct: CancellationToken.None);
            if (!result.IsSuccess || result.Data == null)
            {
                Snackbar.Add(result.Message ?? Language.T("hrm.review.loadFailed"), Severity.Error);
                return;
            }
            _items = result.Data;

            var count = await ReviewService.CountAsync();
            _count = count.IsSuccess ? count.Data : _items.Count;
        }
        finally { _loading = false; }
    }

    private async Task ResolveAsync(SyncReviewFlagDto item)
    {
        var result = await ReviewService.ResolveAsync(item.Id);
        if (!result.IsSuccess)
        {
            Snackbar.Add(result.Message ?? Language.T("hrm.review.resolveFailed"), Severity.Error);
            return;
        }

        _items.Remove(item);
        _count = Math.Max(0, _count - 1);
        Snackbar.Add(Language.T("hrm.review.resolveSuccess"), Severity.Success);
    }

    public void Dispose()
    {
        Language.LanguageChanged -= OnLanguageChanged;
    }
}
