@page "/leave/history"
@attribute [Authorize]
@using FVN_REGISTER.Contract.Dtos
@using FVN_REGISTER.Contract.ViewModels
@using FVN_REGISTER.Contract.Interfaces.Repositores
@using FVN_REGISTER.Contract.Utils
@using FVN_REGISTER.Shared.Handlers
@using FVN_REGISTER.Shared.Services.Leaves
@using FVN_REGISTER.Shared.Services.Users
@using FVN_REGISTER.Shared.Utils.Helpers
@using FVN_REGISTER.Core.Logging
@using Microsoft.AspNetCore.Authorization
@inherits AppComponentBase
@implements IDisposable
@inject ILeaveHistorysClientService LeaveHistoryService
@inject ICurrentUserClientService _currentUser
@inject ISnackbar _snackbar
@inject IDialogService _dialog
@inject NavigationManager _nav

<PageTitle>Lịch sử nghỉ phép</PageTitle>

<style>
    .history-page {
        animation: fadeInUp 0.4s ease;
    }

    @@keyframes fadeInUp {
        from { opacity: 0; transform: translateY(16px); }
        to   { opacity: 1; transform: translateY(0); }
    }

    .stat-card {
        border-radius: 16px !important;
        transition: transform 0.2s, box-shadow 0.2s;
        cursor: default;
    }

    .stat-card:hover {
        transform: translateY(-3px);
        box-shadow: 0 8px 24px rgba(0,0,0,0.12) !important;
    }

    .stat-value {
        font-size: 2rem;
        font-weight: 700;
        line-height: 1;
    }

    .status-chip {
        font-weight: 600;
        font-size: 0.7rem;
        letter-spacing: 0.5px;
    }

    .mud-data-grid .mud-table-row:hover {
        background: rgba(30,136,229,0.05) !important;
    }

    .action-btn {
        transition: transform 0.15s;
    }

    .action-btn:hover {
        transform: scale(1.1);
    }

    .filter-panel {
        border-radius: 12px;
        border: 1px solid rgba(0,0,0,0.08);
    }

    .balance-bar {
        height: 8px;
        border-radius: 4px;
        background: #e8eaf6;
        overflow: hidden;
    }

    .balance-bar-fill {
        height: 100%;
        border-radius: 4px;
        background: linear-gradient(90deg, #1E88E5, #42a5f5);
        transition: width 0.8s ease;
    }
</style>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="py-4 history-page">

    @* ===== HEADER ===== *@
    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-5">
        <MudStack Spacing="0">
            <MudText Typo="Typo.h5" Style="font-weight:700; color:#1E88E5;">
                <MudIcon Icon="@Icons.Material.Filled.History" Class="mr-2" Style="vertical-align:middle;" />
                Lịch sử nghỉ phép
            </MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">
                Theo dõi, quản lý toàn bộ đơn nghỉ của bạn
            </MudText>
        </MudStack>

        <MudStack Row="true" Spacing="2">
            <MudButton Variant="Variant.Outlined"
                       Color="Color.Success"
                       StartIcon="@Icons.Material.Filled.FileDownload"
                       OnClick="ExportExcel"
                       Disabled="_isLoading">
                Export Excel
            </MudButton>
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Add"
                       OnClick="@(() => _nav.NavigateTo("/leave/create"))">
                Tạo đơn mới
            </MudButton>
        </MudStack>
    </MudStack>

    @* ===== STAT CARDS - PHÉP TỒN ===== *@
    @if (_balance != null)
    {
        <MudGrid Class="mb-4">
            <MudItem xs="6" sm="3">
                <MudPaper Class="stat-card pa-4" Elevation="2">
                    <MudStack Spacing="1">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">TỔNG PHÉP NĂM</MudText>
                        <MudText Class="stat-value" Style="color:#1E88E5;">@_balance.Entitled.ToString("N1")</MudText>
                        <MudText Typo="Typo.caption">ngày</MudText>
                    </MudStack>
                </MudPaper>
            </MudItem>
            <MudItem xs="6" sm="3">
                <MudPaper Class="stat-card pa-4" Elevation="2">
                    <MudStack Spacing="1">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">ĐÃ SỬ DỤNG</MudText>
                        <MudText Class="stat-value" Style="color:#FF8F00;">@_balance.Used.ToString("N1")</MudText>
                        <MudText Typo="Typo.caption">ngày</MudText>
                    </MudStack>
                </MudPaper>
            </MudItem>
            <MudItem xs="6" sm="3">
                <MudPaper Class="stat-card pa-4" Elevation="2">
                    <MudStack Spacing="1">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">CÒN LẠI</MudText>
                        <MudText Class="stat-value" Style="color:#43A047;">@_balance.Remaining.ToString("N1")</MudText>
                        <MudText Typo="Typo.caption">ngày</MudText>
                    </MudStack>
                </MudPaper>
            </MudItem>
            <MudItem xs="6" sm="3">
                <MudPaper Class="stat-card pa-4" Elevation="2">
                    <MudStack Spacing="1">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">ĐANG CHỜ DUYỆT</MudText>
                        <MudText Class="stat-value" Style="color:#E53935;">@_pendingCount</MudText>
                        <MudText Typo="Typo.caption">đơn</MudText>
                    </MudStack>
                    <div class="balance-bar mt-2">
                        <div class="balance-bar-fill"
                             style="width: @((_balance.Entitled > 0 ? ((double)_balance.Used / (double)_balance.Entitled * 100) : 0).ToString("F0"))%;
                                    background: linear-gradient(90deg, #43A047, #81C784);">
                        </div>
                    </div>
                </MudPaper>
            </MudItem>
        </MudGrid>
    }

    @* ===== FILTER PANEL ===== *@
    <MudPaper Class="filter-panel pa-4 mb-4" Elevation="0">
        <MudGrid>
            <MudItem xs="12" sm="3">
                <MudSelect T="int" Label="Năm" @bind-Value="_filterYear"
                           Variant="Variant.Outlined" Margin="Margin.Dense"
                           AdornmentIcon="@Icons.Material.Filled.CalendarMonth"
                           Adornment="Adornment.Start">
                    @foreach (var y in _years)
                    {
                        <MudSelectItem Value="@y">@y</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="3">
                <MudSelect T="string" Label="Trạng thái" @bind-Value="_filterStatus"
                           Variant="Variant.Outlined" Margin="Margin.Dense"
                           AdornmentIcon="@Icons.Material.Filled.FilterList"
                           Adornment="Adornment.Start">
                    <MudSelectItem Value="@("")">Tất cả</MudSelectItem>
                    <MudSelectItem Value="@LeaveStatus.Pending">Chờ duyệt</MudSelectItem>
                    <MudSelectItem Value="@LeaveStatus.ApprovedLv1">Cấp 1 duyệt</MudSelectItem>
                    <MudSelectItem Value="@LeaveStatus.ApprovedLv2">Cấp 2 duyệt</MudSelectItem>
                    <MudSelectItem Value="@LeaveStatus.Approved">Đã duyệt</MudSelectItem>
                    <MudSelectItem Value="@LeaveStatus.Rejected">Từ chối</MudSelectItem>
                    <MudSelectItem Value="@LeaveStatus.Cancel">Đã hủy</MudSelectItem>
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="3">
                <MudDatePicker Label="Từ ngày" @bind-Date="_filterFrom"
                               Variant="Variant.Outlined" Margin="Margin.Dense"
                               DateFormat="dd/MM/yyyy" Clearable="true"
                               AdornmentIcon="@Icons.Material.Filled.DateRange" />
            </MudItem>
            <MudItem xs="12" sm="3">
                <MudDatePicker Label="Đến ngày" @bind-Date="_filterTo"
                               Variant="Variant.Outlined" Margin="Margin.Dense"
                               DateFormat="dd/MM/yyyy" Clearable="true"
                               AdornmentIcon="@Icons.Material.Filled.DateRange" />
            </MudItem>
        </MudGrid>

        <MudStack Row="true" Justify="Justify.FlexEnd" Class="mt-3" Spacing="2">
            <MudButton Variant="Variant.Text" Color="Color.Default"
                       StartIcon="@Icons.Material.Filled.Clear"
                       OnClick="ClearFilter">
                Xóa bộ lọc
            </MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Search"
                       OnClick="LoadData">
                Tìm kiếm
            </MudButton>
        </MudStack>
    </MudPaper>

    @* ===== DATA GRID ===== *@
    <MudPaper Elevation="2" Style="border-radius:12px; overflow:hidden;">
        <MudDataGrid T="LeaveDaysViewModel"
                     Items="@_filteredData"
                     Loading="@_isLoading"
                     Filterable="false"
                     SortMode="SortMode.Multiple"
                     Groupable="false"
                     ShowColumnOptions="false"
                     RowsPerPage="15"
                     Dense="true"
                     Striped="true"
                     Hover="true"
                     FixedHeader="true"
                     Height="520px">

            <ToolBarContent>
                <MudText Typo="Typo.subtitle1" Style="font-weight:600;">
                    Danh sách đơn nghỉ
                    <MudChip T="string" Size="Size.Small" Color="Color.Primary" Class="ml-2">
                        @_filteredData.Count đơn
                    </MudChip>
                </MudText>
                <MudSpacer />
                <MudTextField T="string" Value="_searchText"
                              Placeholder="Tìm kiếm nhanh..."
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Search"
                              IconSize="Size.Small"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Style="max-width:260px;"
                              Immediate="true"
                              DebounceInterval="300"
                              ValueChanged="OnSearchChanged" />
            </ToolBarContent>

            <Columns>
                <PropertyColumn Property="x => x.Id" Title="#" Sortable="true"
                                InitialDirection="SortDirection.Descending">
                    <CellTemplate>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">#@context.Item.Id</MudText>
                    </CellTemplate>
                </PropertyColumn>

                <PropertyColumn Property="x => x.RegisterDate" Title="Ngày gửi" Sortable="true">
                    <CellTemplate>
                        <MudText Typo="Typo.body2">@context.Item.RegisterDate.ToString("dd/MM/yyyy")</MudText>
                    </CellTemplate>
                </PropertyColumn>

                <PropertyColumn Property="x => x.StartDate" Title="Nghỉ từ" Sortable="true">
                    <CellTemplate>
                        <MudText Typo="Typo.body2" Style="font-weight:500;">
                            @context.Item.StartDate.ToString("dd/MM/yyyy")
                        </MudText>
                    </CellTemplate>
                </PropertyColumn>

                <PropertyColumn Property="x => x.EndDate" Title="Đến ngày" Sortable="true">
                    <CellTemplate>
                        <MudText Typo="Typo.body2">@context.Item.EndDate.ToString("dd/MM/yyyy")</MudText>
                    </CellTemplate>
                </PropertyColumn>

                <PropertyColumn Property="x => x.TotalDay" Title="Số ngày" Sortable="true">
                    <CellTemplate>
                        <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Filled">
                            @context.Item.TotalDay.ToString("N1") ngày
                        </MudChip>
                    </CellTemplate>
                </PropertyColumn>

                <PropertyColumn Property="x => x.LeaveTypeName" Title="Loại nghỉ" Sortable="true">
                    <CellTemplate>
                        <MudText Typo="Typo.body2">@(context.Item.LeaveTypeName ?? "—")</MudText>
                    </CellTemplate>
                </PropertyColumn>

                <PropertyColumn Property="x => x.LeaveReason" Title="Lý do">
                    <CellTemplate>
                        <MudText Typo="Typo.body2"
                                 Style="max-width:200px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;"
                                 Title="@context.Item.LeaveReason">
                            @(context.Item.LeaveReason?.Length > 40
                                ? context.Item.LeaveReason[..40] + "..."
                                : context.Item.LeaveReason ?? "—")
                        </MudText>
                    </CellTemplate>
                </PropertyColumn>

                <PropertyColumn Property="x => x.RequestStatus" Title="Trạng thái" Sortable="true">
                    <CellTemplate>
                        @{
                            var (color, icon) = GetStatusStyle(context.Item.RequestStatus);
                        }
                        <MudChip T="string" Size="Size.Small"
                                 Color="@color"
                                 Variant="Variant.Filled"
                                 Icon="@icon"
                                 Class="status-chip">
                            @LeaveStatus.GetDisplayName(context.Item.RequestStatus)
                        </MudChip>
                    </CellTemplate>
                </PropertyColumn>

                <TemplateColumn T="LeaveDaysViewModel" Title="Người duyệt">
                    <CellTemplate>
                        @{
                            var approver = GetCurrentApprover(context.Item);
                        }
                        @if (!string.IsNullOrEmpty(approver))
                        {
                            <MudTooltip Text="@approver">
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Default">
                                    <MudIcon Icon="@Icons.Material.Filled.Person" Size="Size.Small" Class="mr-1" />
                                    @(approver.Length > 18 ? approver[..18] + "..." : approver)
                                </MudChip>
                            </MudTooltip>
                        }
                        else
                        {
                            <MudText Typo="Typo.caption" Color="Color.Secondary">—</MudText>
                        }
                    </CellTemplate>
                </TemplateColumn>

                <TemplateColumn T="LeaveDaysViewModel" Title="Thao tác" Sortable="false">
                    <CellTemplate>
                        <MudStack Row="true" Spacing="1">
                            <MudTooltip Text="Xem chi tiết">
                                <MudIconButton Icon="@Icons.Material.Filled.RemoveRedEye"
                                               Color="Color.Info" Size="Size.Small"
                                               Class="action-btn"
                                               OnClick="@(() => OpenDetailDialog(context.Item))" />
                            </MudTooltip>

                            @if (CanCancel(context.Item.RequestStatus))
                            {
                                <MudTooltip Text="Hủy đơn">
                                    <MudIconButton Icon="@Icons.Material.Filled.Cancel"
                                                   Color="Color.Error" Size="Size.Small"
                                                   Class="action-btn"
                                                   OnClick="@(() => ConfirmCancel(context.Item))" />
                                </MudTooltip>
                            }
                        </MudStack>
                    </CellTemplate>
                </TemplateColumn>
            </Columns>

            <PagerContent>
                <MudDataGridPager T="LeaveDaysViewModel" PageSizeOptions="new int[]{10,15,25,50}" />
            </PagerContent>

            <NoRecordsContent>
                <MudStack AlignItems="AlignItems.Center" Class="pa-8">
                    // Correct Usage
                    <MudIcon Icon="@Icons.Material.Outlined.Inbox" />
                             Style="font-size:4rem; color:#bdbdbd;" />
                    <MudText Typo="Typo.h6" Color="Color.Secondary">Không có đơn nghỉ nào</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">
                        Thử thay đổi bộ lọc hoặc
                        <MudLink Href="/leave/create" Color="Color.Primary">tạo đơn mới</MudLink>
                    </MudText>
                </MudStack>
            </NoRecordsContent>

            <LoadingContent>
                <MudStack AlignItems="AlignItems.Center" Class="pa-8">
                    <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-2">
                        Đang tải dữ liệu...
                    </MudText>
                </MudStack>
            </LoadingContent>
        </MudDataGrid>
    </MudPaper>
</MudContainer>

@* ===== DIALOG CHI TIẾT ===== *@
@if (_selectedLeave != null)
{
    <MudDialog @bind-IsVisible="_showDetail" Options="_dialogOptions">
        <TitleContent>
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                <MudIcon Icon="@Icons.Material.Filled.Assignment" Color="Color.Primary" />
                <MudText Typo="Typo.h6">Chi tiết đơn #@_selectedLeave.Id</MudText>
                @{
                    var (c, i) = GetStatusStyle(_selectedLeave.RequestStatus);
                }
                <MudChip T="string" Color="@c" Size="Size.Small" Icon="@i" Class="status-chip ml-2">
                    @LeaveStatus.GetDisplayName(_selectedLeave.RequestStatus)
                </MudChip>
            </MudStack>
        </TitleContent>
        <DialogContent>
            <MudGrid>
                <MudItem xs="12" sm="6">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">NGÀY GỬI</MudText>
                    <MudText Typo="Typo.body1">@_selectedLeave.RegisterDate.ToString("dd/MM/yyyy")</MudText>
                </MudItem>
                <MudItem xs="6" sm="3">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">TỪ NGÀY</MudText>
                    <MudText Typo="Typo.body1" Style="font-weight:600; color:#1E88E5;">
                        @_selectedLeave.StartDate.ToString("dd/MM/yyyy")
                    </MudText>
                </MudItem>
                <MudItem xs="6" sm="3">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">ĐẾN NGÀY</MudText>
                    <MudText Typo="Typo.body1" Style="font-weight:600; color:#1E88E5;">
                        @_selectedLeave.EndDate.ToString("dd/MM/yyyy")
                    </MudText>
                </MudItem>
                <MudItem xs="6">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">SỐ NGÀY NGHỈ</MudText>
                    <MudText Typo="Typo.body1" Style="font-weight:700;">
                        @_selectedLeave.TotalDay.ToString("N1") ngày
                    </MudText>
                </MudItem>
                <MudItem xs="6">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">LOẠI NGHỈ</MudText>
                    <MudText Typo="Typo.body1">@(_selectedLeave.LeaveTypeName ?? "—")</MudText>
                </MudItem>
                <MudItem xs="12">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">LÝ DO NGHỈ</MudText>
                    <MudPaper Elevation="0" Class="pa-3 mt-1"
                              Style="background:#f5f5f5; border-radius:8px;">
                        <MudText Typo="Typo.body2">@(_selectedLeave.LeaveReason ?? "—")</MudText>
                    </MudPaper>
                </MudItem>
            </MudGrid>

            <MudDivider Class="my-4" />

            <MudText Typo="Typo.subtitle2" Class="mb-3" Style="font-weight:700;">
                <MudIcon Icon="@Icons.Material.Filled.Timeline" Size="Size.Small" Class="mr-1" />
                Trạng thái phê duyệt
            </MudText>

            <MudTimeline TimelineAlign="TimelineAlign.Start">
                <MudTimelineItem Color="@GetLevelColor(_selectedLeave.Level1IsApprove)"
                                 Size="Size.Small"
                                 Dot="true">
                    <ItemContent>
                        <MudStack Spacing="0">
                            <MudText Typo="Typo.body2" Style="font-weight:600;">
                                Cấp 1 – @(_selectedLeave.Level1ApproveName ?? _selectedLeave.Level1ApproveEmail ?? "Chưa xác định")
                            </MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                @GetLevelStatusText(_selectedLeave.Level1IsApprove)
                            </MudText>
                            @if (!string.IsNullOrEmpty(_selectedLeave.Level1ApproveEmail))
                            {
                                <MudText Typo="Typo.caption" Color="Color.Secondary">
                                    @_selectedLeave.Level1ApproveEmail
                                </MudText>
                            }
                        </MudStack>
                    </ItemContent>
                </MudTimelineItem>

                @if (!string.IsNullOrEmpty(_selectedLeave.Level2ApproveEmail))
                {
                    <MudTimelineItem Color="@GetLevelColor(_selectedLeave.Level2IsApprove)"
                                     Size="Size.Small">
                        <ItemContent>
                            <MudStack Spacing="0">
                                <MudText Typo="Typo.body2" Style="font-weight:600;">
                                    Cấp 2 – @(_selectedLeave.Level2ApproveName ?? _selectedLeave.Level2ApproveEmail)
                                </MudText>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">
                                    @GetLevelStatusText(_selectedLeave.Level2IsApprove)
                                </MudText>
                            </MudStack>
                        </ItemContent>
                    </MudTimelineItem>
                }

                @if (!string.IsNullOrEmpty(_selectedLeave.Level3ApproveEmail))
                {
                    <MudTimelineItem Color="@GetLevelColor(_selectedLeave.Level3IsApprove)"
                                     Size="Size.Small">
                        <ItemContent>
                            <MudStack Spacing="0">
                                <MudText Typo="Typo.body2" Style="font-weight:600;">
                                    Cấp 3 – @(_selectedLeave.Level3ApproveName ?? _selectedLeave.Level3ApproveEmail)
                                </MudText>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">
                                    @GetLevelStatusText(_selectedLeave.Level3IsApprove)
                                </MudText>
                            </MudStack>
                        </ItemContent>
                    </MudTimelineItem>
                }
            </MudTimeline>

            @if (_detailDays != null && _detailDays.Any())
            {
                <MudDivider Class="my-3" />
                <MudText Typo="Typo.subtitle2" Class="mb-2" Style="font-weight:700;">
                    <MudIcon Icon="@Icons.Material.Filled.DateRange" Size="Size.Small" Class="mr-1" />
                    Chi tiết từng ngày
                </MudText>
                <MudSimpleTable Dense="true" Hover="true" Style="border-radius:8px; overflow:hidden;">
                    <thead>
                        <tr>
                            <th>Ngày</th>
                            <th>Loại</th>
                            <th>Buổi</th>
                            <th>Số ngày</th>
                            <th>Tính phép</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var d in _detailDays)
                        {
                            <tr>
                                <td>@d.LeaveDate.ToString("dd/MM/yyyy")</td>
                                <td>@(d.LeaveTypeName ?? d.LeaveTypeCode)</td>
                                <td>
                                    @if (d.IsHalfDay)
                                    {
                                        <MudChip T="string" Size="Size.Small" Color="Color.Warning">
                                            @(d.HalfDayOption == "Morning" ? "Sáng" : "Chiều")
                                        </MudChip>
                                    }
                                    else
                                    {
                                        <MudText Typo="Typo.body2">Cả ngày</MudText>
                                    }
                                </td>
                                <td>@d.DayValue.ToString("N1")</td>
                                <td>
                                    <MudIcon Icon="@(d.TinhPhep == 1
                                        ? Icons.Material.Filled.CheckCircle
                                        : Icons.Material.Filled.Cancel)"
                                             Color="@(d.TinhPhep == 1 ? Color.Success : Color.Error)"
                                             Size="Size.Small" />
                                </td>
                            </tr>
                        }
                    </tbody>
                </MudSimpleTable>
            }
        </DialogContent>
        <DialogActions>
            @if (CanCancel(_selectedLeave.RequestStatus))
            {
                <MudButton Color="Color.Error"
                           Variant="Variant.Outlined"
                           StartIcon="@Icons.Material.Filled.Cancel"
                           OnClick="@(() => { _showDetail = false; ConfirmCancel(_selectedLeave); })">
                    Hủy đơn này
                </MudButton>
            }
            <MudSpacer />
            <MudButton Color="Color.Primary" Variant="Variant.Filled"
                       OnClick="@(() => _showDetail = false)">
                Đóng
            </MudButton>
        </DialogActions>
    </MudDialog>
}

@code {
    // ===== STATE =====
    private List<LeaveDaysViewModel> _allData = new();
    private List<LeaveDaysViewModel> _filteredData = new();
    private bool _isLoading = true;
    private CancellationTokenSource _cts = new();

    // Filter
    private int _filterYear = DateTime.Now.Year;
    private string _filterStatus = "";
    private DateTime? _filterFrom;
    private DateTime? _filterTo;
    private string _searchText = "";
    private List<int> _years = new();

    // Balance
    private LeaveBalanceDto? _balance;
    private int _pendingCount;

    // Detail dialog
    private bool _showDetail;
    private LeaveDaysViewModel? _selectedLeave;
    private List<LeaveDetailViewModel>? _detailDays;
    private DialogOptions _dialogOptions = new()
    {
        MaxWidth = MaxWidth.Medium,
        FullWidth = true,
        CloseOnEscapeKey = true,
        CloseButton = true
    };

    // ===== LIFECYCLE =====
    protected override async Task OnInitializedAsync()
    {
        _years = Enumerable.Range(DateTime.Now.Year - 3, 5).Reverse().ToList();
        await Task.WhenAll(LoadData(), LoadBalance());
    }

    // ===== DATA LOADING (Đã chuyển sang dùng Service) =====
    private async Task LoadData()
    {
        try
        {
            _isLoading = true;
            StateHasChanged();

            // ✅ SỬA: Gọi qua LeaveHistoryService thay cho _http.GetAsync trực tiếp
            var result = await LeaveHistoryService.GetHistoryAsync(_filterYear, _filterStatus, _cts.Token);

            if (result.IsSuccess && result.Data != null)
            {
                _allData = result.Data;
                ApplyFilter();
            }
            else
            {
                _allData = new();
                _filteredData = new();
                _snackbar.Add(result.Message ?? "Không thể tải dữ liệu dữ liệu lịch sử.", Severity.Warning);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "[LeaveHistory] LoadData failed");
            _snackbar.Add("Lỗi kết nối hệ thống.", Severity.Error);
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }

