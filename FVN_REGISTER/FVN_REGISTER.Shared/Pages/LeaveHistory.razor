        }
    }

    // ===== FILTER =====
    private void ApplyFilter()
    {
        var q = _allData.AsEnumerable();

        // Không cần filter trạng thái tại RAM nữa nếu API Backend đã filter theo status truyền vào, 
        // nhưng giữ lại phòng trường hợp filter bổ trợ tại Client.
        if (!string.IsNullOrEmpty(_filterStatus))
            q = q.Where(x => x.RequestStatus == _filterStatus);

        if (_filterFrom.HasValue)
            q = q.Where(x => x.StartDate >= _filterFrom.Value);

        if (_filterTo.HasValue)
            q = q.Where(x => x.EndDate <= _filterTo.Value);

        if (!string.IsNullOrWhiteSpace(_searchText))
        {
            var s = _searchText.ToLower();
            q = q.Where(x =>
                (x.LeaveReason?.ToLower().Contains(s) ?? false) ||
                (x.LeaveTypeName?.ToLower().Contains(s) ?? false) ||
                (x.Level1ApproveName?.ToLower().Contains(s) ?? false));
        }

        _filteredData = q.OrderByDescending(x => x.RegisterDate).ToList();
        _pendingCount = _allData.Count(x => x.RequestStatus == LeaveStatus.Pending);
    }

    private void ClearFilter()
    {
        _filterStatus = "";
        _filterFrom = null;
        _filterTo = null;
        _searchText = "";
        ApplyFilter();
    }

    private void OnSearchChanged(string value)
    {
        _searchText = value;
        ApplyFilter();
    }

