    // ===== HELPERS =====
    private (Color, string) GetStatusStyle(string status)
    {
        return status switch
        {
            LeaveStatus.Pending => (Color.Warning, Icons.Material.Filled.HourglassEmpty),
            LeaveStatus.Approved => (Color.Success, Icons.Material.Filled.CheckCircle),
            LeaveStatus.Rejected => (Color.Error, Icons.Material.Filled.Cancel),
            LeaveStatus.Cancel => (Color.Default, Icons.Material.Filled.Block),
            _ => (Color.Info, Icons.Material.Filled.Info)
        };
    }

    private Color GetLevelColor(bool? isApprove)
    {
        return isApprove switch
        {
            true => Color.Success,
            false => Color.Error,
            _ => Color.Default
        };
    }

    private string GetLevelStatusText(bool? isApprove)
    {
        return isApprove switch
        {
            true => "Đã duyệt",
            false => "Từ chối",
            _ => "Đang chờ"
        };
    }

    private string GetCurrentApprover(LeaveDaysViewModel item)
    {
        if (item.RequestStatus == LeaveStatus.Pending) return item.Level1ApproveName ?? item.Level1ApproveEmail ?? "";
        if (item.RequestStatus == LeaveStatus.ApprovedLv1) return item.Level2ApproveName ?? item.Level2ApproveEmail ?? "";
        if (item.RequestStatus == LeaveStatus.ApprovedLv2) return item.Level3ApproveName ?? item.Level3ApproveEmail ?? "";
        return "";
    }

    private bool CanCancel(string status)
    {
        return status == LeaveStatus.Pending || status == LeaveStatus.ApprovedLv1;
    }

