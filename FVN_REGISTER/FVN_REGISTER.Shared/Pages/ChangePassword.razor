@page "/change-password"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using FVN_REGISTER.Shared.Services.Users
@using FVN_REGISTER.Shared.Services.Language
@inherits AppComponentBase

@inject IAuthClientService AuthService
@inject ISnackbar Snackbar
@inject NavigationManager Navigation
@inject ILanguageService Language

<MudContainer MaxWidth="MaxWidth.Small" Class="mt-8">
    <MudPaper Elevation="4" Class="pa-6">
        <MudText Typo="Typo.h5" Align="Align.Center" Class="mb-4">@Language.T("password.title")</MudText>

        <MudForm @ref="_form">
            <MudTextField T="string" Label="@Language.T("password.current")" Variant="Variant.Outlined"
                          InputType="InputType.Password" @bind-Value="_currentPassword" Required="true" />

            <MudTextField T="string" Label="@Language.T("password.new")" Variant="Variant.Outlined" Class="mt-4"
                          InputType="InputType.Password" @bind-Value="_newPassword" Required="true" />

            <MudTextField T="string" Label="@Language.T("password.confirm")" Variant="Variant.Outlined" Class="mt-4"
                          InputType="InputType.Password" @bind-Value="_confirmPassword" Required="true" />

            <div class="d-flex align-center justify-space-between mt-6">
                <MudButton Variant="Variant.Text" Color="Color.Default" OnClick="Cancel">@Language.T("common.cancel")</MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Submit"
                           Disabled="_processing">
                    @( _processing ? Language.T("common.processing") : Language.T("password.update"))
                </MudButton>
            </div>
        </MudForm>
    </MudPaper>
</MudContainer>

@code {
    private MudForm? _form;
    private string _currentPassword = string.Empty;
    private string _newPassword = string.Empty;
    private string _confirmPassword = string.Empty;
    private bool _processing;
    private readonly CancellationTokenSource _cts = new();

    protected override async Task OnInitializedAsync()
    {
        await Language.InitializeAsync();
        Language.LanguageChanged += OnLanguageChanged;
    }

    private void OnLanguageChanged(object? sender, EventArgs e) => InvokeAsync(StateHasChanged);

    private async Task Submit()
    {
        if (_form != null)
        {
            await _form.ValidateAsync();
            if (!_form.IsValid) return;
        }

        if (_newPassword != _confirmPassword)
        {
            Snackbar.Add(Language.T("password.confirmMismatch"), Severity.Error);
            return;
        }

        _processing = true;
        try
        {
            var result = await AuthService.ChangePassword(
                _currentPassword,
                _newPassword,
                _cts.Token);

            if (result.IsSuccess)
            {
                Snackbar.Add(Language.T("password.success"), Severity.Success);
                Navigation.NavigateTo("/login", forceLoad: true);
            }
            else
            {
                // API remains Vietnamese by design; preserve the server message as the authoritative backend response.
                Snackbar.Add(result.Message ?? Language.T("password.failed"), Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "[AUTH] ChangePassword page error");
            Snackbar.Add(Language.T("password.systemError"), Severity.Error);
        }
        finally
        {
            _processing = false;
        }
    }

    private void Cancel() => Navigation.NavigateTo("/");

    public void Dispose()
    {
        Language.LanguageChanged -= OnLanguageChanged;
        _cts.Cancel();
        _cts.Dispose();
    }
}
