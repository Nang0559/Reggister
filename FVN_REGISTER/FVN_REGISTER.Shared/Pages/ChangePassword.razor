@page "/change-password"
@using FVN_REGISTER.Contract.Responses
@inject HttpClient _http
@inject ISnackbar _snackbar
@inject NavigationManager _nav

<MudContainer MaxWidth="MaxWidth.Small" Class="mt-8">
    <MudPaper Elevation="4" Class="pa-6">
        <MudText Typo="Typo.h5" Align="Align.Center" Class="mb-4">Đổi mật khẩu</MudText>

        <MudForm @ref="form">
            <MudTextField T="string" Label="Mật khẩu hiện tại" Variant="Variant.Outlined"
                          InputType="InputType.Password" @bind-Value="_model.CurrentPassword" Required="true" />

            <MudTextField T="string" Label="Mật khẩu mới" Variant="Variant.Outlined" Class="mt-4"
                          InputType="InputType.Password" @bind-Value="_model.NewPassword" Required="true" />

            <MudTextField T="string" Label="Xác nhận mật khẩu mới" Variant="Variant.Outlined" Class="mt-4"
                          InputType="InputType.Password" @bind-Value="_model.NewPassword2" Required="true" />

            <div class="d-flex align-center justify-space-between mt-6">
                <MudButton Variant="Variant.Text" Color="Color.Default" OnClick="Cancel">Hủy bỏ</MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Submit"
                           Disabled="_processing">
                    @(_processing ? "Đang xử lý..." : "Cập nhật")
                </MudButton>
            </div>
        </MudForm>
    </MudPaper>
</MudContainer>

@code {
    private ChangePasswordViewModel _model = new();
    private bool _processing = false;
    private MudForm form = null!;

    private async Task Submit()
    {
        await form.ValidateAsync();
        if (!form.IsValid) return;

        if (_model.NewPassword != _model.NewPassword2)
        {
            _snackbar.Add("Mật khẩu mới và xác nhận không khớp!", Severity.Error);
            return;
        }

        _processing = true;
        var response = await _http.PostAsJsonAsync("api/profile/change-password", _model);
        var result = await response.Content.ReadFromJsonAsync<ApiResponse<object>>();

        if (result?.IsSuccess == true)
        {
            _snackbar.Add("Đổi mật khẩu thành công. Vui lòng đăng nhập lại!", Severity.Success);
            _nav.NavigateTo("/login");
        }
        else
        {
            _snackbar.Add(result?.Message ?? "Lỗi hệ thống", Severity.Error);
        }
        _processing = false;
    }

    private void Cancel() => _nav.NavigateTo("/");
}