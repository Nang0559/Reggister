@page "/leave/create"
@attribute [Authorize]
@namespace FVN_REGISTER.Shared.Pages
@using FVN_REGISTER.Contract.Dtos.MasterData
@using FVN_REGISTER.Contract.Dtos.Leaves
@using FVN_REGISTER.Shared.Components.Leaves
@using FVN_REGISTER.Shared.Services.Leaves
@using Microsoft.AspNetCore.Authorization
@inherits AppComponentBase
@implements IAsyncDisposable

@inject ILeaveCreateClientService LeaveService
@inject ILeaveTypeClientService LeaveTypeService
@inject ICurrentUserClientService CurrentUserService
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject IJSRuntime JS
@inject NavigationManager Nav

<PageTitle>Đăng ký nghỉ phép</PageTitle>

@if (_isLoading)
{
    <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-4" />
}
else if (_model == null)
{
    <MudAlert Severity="Severity.Warning" Class="mt-4">Không thể tải dữ liệu. Vui lòng thử lại.</MudAlert>
}
else
{
    <MudGrid Spacing="2">
        <MudItem xs="12" lg="5">
            <MudPaper Class="pa-2 mb-2 d-flex align-center justify-space-between" Elevation="0">
                <MudSelect T="int" Value="_selectedYear" ValueChanged="OnYearChanged" Dense="true" Margin="Margin.Dense" Label="Năm" Style="max-width:150px;">
                    @foreach (var year in _model.FiscalYears)
                    {
                        <MudSelectItem Value="@year.Year">@year.YearName</MudSelectItem>
                    }
                </MudSelect>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" StartIcon="@Icons.Material.Filled.Add" OnClick="@(() => OpenAddDialog(null, null))">
                    Đăng ký nghỉ
                </MudButton>
            </MudPaper>

            <MudPaper Class="pa-3 d-none d-lg-block" Elevation="1" Style="max-height:620px; overflow-y:auto;">
                <LeaveListSection Items="@LeaveEventsFiltered" OnView="OpenDetailDialog" />
            </MudPaper>
        </MudItem>

        <MudItem xs="12" lg="7">
            <MudPaper Class="pa-3" Elevation="1" Style="min-height:500px;">
                <MudText Typo="Typo.subtitle1" Class="mb-2">
                    <MudIcon Icon="@Icons.Material.Filled.CalendarMonth" Size="Size.Small" Class="mr-1" />
                    Lịch nghỉ
                </MudText>

                <MudStack Row="true" Class="mb-2" Spacing="2">
                    <MudChip T="string" Size="Size.Small" Color="Color.Warning">Nghỉ công ty</MudChip>
                    <MudChip T="string" Size="Size.Small" Color="Color.Warning">Chờ duyệt</MudChip>
                    <MudChip T="string" Size="Size.Small" Color="Color.Success">Đã duyệt</MudChip>
                    <MudChip T="string" Size="Size.Small" Color="Color.Error">Từ chối</MudChip>
                </MudStack>

                <div @ref="_calendarRef" id="leave-calendar" style="min-height:450px; touch-action:manipulation; user-select:none; -webkit-user-select:none;"></div>
            </MudPaper>
        </MudItem>

        <MudItem xs="12" Class="d-lg-none">
            <MudPaper Class="pa-3" Elevation="1">
                <LeaveListSection Items="@LeaveEventsFiltered" OnView="OpenDetailDialog" />
            </MudPaper>
        </MudItem>
    </MudGrid>
}
