@page "/leave/create"
@attribute [Authorize]
@namespace FVN_REGISTER.Shared.Pages
@using FVN_REGISTER.Contract.Dtos.MasterData
@using FVN_REGISTER.Contract.Dtos.Leaves
@using FVN_REGISTER.Contract.Dtos.Calendar
@using FVN_REGISTER.Shared.Components.Leaves
@using FVN_REGISTER.Shared.Components.Calendar
@using Microsoft.AspNetCore.Authorization
@inherits AppComponentBase

<PageTitle>@Language.T("leave.create.title")</PageTitle>

@if (_isLoading)
{
    <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-4" />
}
else if (_model == null)
{
    <MudAlert Severity="Severity.Warning" Class="mt-4">@Language.T("leave.create.loadFailed")</MudAlert>
}
else
{
    <MudGrid Spacing="2">
        <MudItem xs="12" lg="5">
            <MudPaper Class="pa-2 mb-2 d-flex align-center justify-space-between" Elevation="0">
                <MudText Typo="Typo.subtitle1">
                    <MudIcon Icon="@Icons.Material.Filled.EventAvailable" Size="Size.Small" Class="mr-1" />
                    @Language.T("leave.create.title")
                </MudText>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.Add"
                           OnClick="@(() => OpenAddDialog(null, null))">
                    @Language.T("leave.create.action")
                </MudButton>
            </MudPaper>

            <MudPaper Class="pa-3 d-none d-lg-block" Elevation="1" Style="max-height:620px; overflow-y:auto;">
                <LeaveListSection Items="@LeaveEventsFiltered" OnView="OpenDetailDialog" />
            </MudPaper>
        </MudItem>

        <MudItem xs="12" lg="7">
            <MudPaper Class="pa-2" Elevation="1">
                <MudText Typo="Typo.subtitle1" Class="px-2 pt-2">
                    <MudIcon Icon="@Icons.Material.Filled.CalendarMonth" Size="Size.Small" Class="mr-1" />
                    @Language.T("calendar.sharedTitle")
                </MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="px-2">
                    @Language.T("calendar.sharedDescription")
                </MudText>
                <WorkCalendar ModuleContext="LEAVE"
                              OnDateSelected="OnCalendarDateSelected"
                              OnEventSelected="OnCalendarEventSelected" />
            </MudPaper>
        </MudItem>

        <MudItem xs="12" Class="d-lg-none">
            <MudPaper Class="pa-3" Elevation="1">
                <LeaveListSection Items="@LeaveEventsFiltered" OnView="OpenDetailDialog" />
            </MudPaper>
        </MudItem>
    </MudGrid>
}
