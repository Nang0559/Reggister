@* FVN_REGISTER.Shared/Components/NotificationBadge.razor *@
@using FVN_REGISTER.Contract.Dtos
@using FVN_REGISTER.Shared.Utils
@using Microsoft.AspNetCore.SignalR.Client
@using FVN_REGISTER.Shared.Services.Users
@using Microsoft.AspNetCore.Components.Authorization
@inject ITokenStorage TokenStorage
@inject AuthenticationStateProvider AuthStateProvider
@implements IAsyncDisposable
@inject ICurrentUserClientService CurrentUser
@inject NavigationManager Nav
@inject ISnackbar Snackbar
@inject IConfiguration Configuration

<MudBadge Content="@_unreadCount" Overlap="true" Color="Color.Error"
          Visible="@(_unreadCount > 0)" Max="99">
    <MudIconButton Icon="@Icons.Material.Filled.Notifications"
                   Color="Color.Inherit"
                   OnClick="TogglePanel" />
</MudBadge>

@if (_showPanel)
{
    <MudPaper Elevation="8"
              Style="position:absolute; top:56px; right:8px; width:340px;
                         z-index:9999; max-height:480px; overflow-y:auto;"
              Class="pa-0">
        <MudList T="NotificationDto" Dense="true">
            <MudListItem>
                <MudStack Row="true" Justify="Justify.SpaceBetween"
                          AlignItems="AlignItems.Center">
                    <MudText Typo="Typo.subtitle2">Thông báo</MudText>
                    @if (_unreadCount > 0)
                    {
                        <MudButton Size="Size.Small" Variant="Variant.Text"
                                   OnClick="MarkAllRead">Đọc tất cả</MudButton>
                    }
                </MudStack>
            </MudListItem>
            <MudDivider />

            @if (!_isConnected)
            {
                <MudListItem>
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                            Đang kết nối...
                        </MudText>
                    </MudStack>
                </MudListItem>
            }
            else if (_items.Count == 0)
            {
                <MudListItem>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">
                        Không có thông báo mới
                    </MudText>
                </MudListItem>
            }
            else
            {
                @foreach (var item in _items)
                {
                    <MudListItem OnClick="@(() => ClickItem(item))"
                                 Class="@(item.IsRead ? "" : "mud-background-gray")">
                        <MudStack Spacing="0">
                            <MudText Typo="Typo.body2" Style="font-weight:500">
                                @item.Title
                            </MudText>
                            @if (!string.IsNullOrEmpty(item.Body))
                            {
                                <MudText Typo="Typo.caption" Color="Color.Secondary">
                                    @item.Body
                                </MudText>
                            }
                            <MudText Typo="Typo.caption" Color="Color.Tertiary">
                                @item.CreatedAt.ToString("HH:mm dd/MM")
                            </MudText>
                        </MudStack>
                    </MudListItem>
                    <MudDivider />
                }
            }
        </MudList>
    </MudPaper>
}

@code {
    [Parameter] public string DeviceId { get; set; } = string.Empty;

    private HubConnection? _hub;
    private int _unreadCount;
    private bool _showPanel;
    private bool _isConnected;
    private bool _isDisposed;
    private List<NotificationDto> _items = new();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _hub != null || _isDisposed) return;

        var token = await WaitForTokenAsync();
        if (string.IsNullOrEmpty(token))
        {
            Console.WriteLine("[NotificationBadge] No token, skip.");
            return;
        }

        await InitHubAsync(token);
    }

    private async Task<string?> WaitForTokenAsync(int maxRetries = 5)
    {
        for (int i = 0; i < maxRetries; i++)
        {
            // ✅ Ưu tiên 1: RAM token từ CustomAuthStateProvider (luôn có sau login)
            if (AuthStateProvider is CustomAuthStateProvider cp &&
                !string.IsNullOrEmpty(cp.CurrentToken))
            {
                Console.WriteLine($"[NotificationBadge] Token from AuthStateProvider (attempt {i + 1})");
                return cp.CurrentToken;
            }

            // ✅ Ưu tiên 2: Storage (localStorage hoặc SecureStorage)
            try
            {
                var token = await TokenStorage.GetTokenAsync();
                if (!string.IsNullOrEmpty(token))
                {
                    Console.WriteLine($"[NotificationBadge] Token from Storage (attempt {i + 1})");
                    return token;
                }
            }
            catch
            {
                // JS chưa sẵn sàng (SSR) — bỏ qua, thử lại
            }

            Console.WriteLine($"[NotificationBadge] No token yet, retry {i + 1}/{maxRetries}");
            await Task.Delay(600);
        }

        return null;
    }

    private async Task InitHubAsync(string token)
    {
        try
        {
            // ✅ Debug: confirm token có giá trị trước khi connect
            Console.WriteLine($"[NotificationBadge] InitHub token length={token.Length} | preview={token[..Math.Min(30, token.Length)]}...");

            var apiBase = (Configuration["ApiSettings:BaseUrl"] ?? "https://localhost:7135/").TrimEnd('/');
            var deviceId = string.IsNullOrEmpty(DeviceId) ? $"web-{Guid.NewGuid():N}" : DeviceId;
            var hubUrl = $"{apiBase}/hubs/notification?deviceId={deviceId}";

            Console.WriteLine($"[NotificationBadge] Connecting to: {hubUrl}");

            _hub = new HubConnectionBuilder()
                .WithUrl(hubUrl, opts =>
                {
                    opts.AccessTokenProvider = () => Task.FromResult<string?>(token);
                    opts.HttpMessageHandlerFactory = handler =>
                    {
                        if (handler is HttpClientHandler h)
                            h.ServerCertificateCustomValidationCallback =
                                HttpClientHandler.DangerousAcceptAnyServerCertificateValidator;
                        return handler;
                    };
                })
                .WithAutomaticReconnect(new[]
                {
                    TimeSpan.FromSeconds(0),
                    TimeSpan.FromSeconds(5),
                    TimeSpan.FromSeconds(10),
                    TimeSpan.FromSeconds(30)
                })
                .Build();

            // ✅ "BadgeUpdated" — nhất quán với NotificationService + Hub
            _hub.On<int>("BadgeUpdated", count =>
            {
                if (_isDisposed) return;
                _unreadCount = count;
                InvokeAsync(StateHasChanged);
            });

            // ✅ "ReceiveNotification" — nhận NotificationPushDto, tự reload list
            _hub.On<NotificationPushDto>("ReceiveNotification", payload =>
            {
                if (_isDisposed) return;
                _unreadCount = payload.UnreadCount;

                // Thêm thông báo mới lên đầu list nếu chưa có
                if (payload.Latest != null &&
                    !_items.Any(x => x.Id == payload.Latest.Id))
                {
                    _items.Insert(0, payload.Latest);
                }

                Snackbar.Add(payload.Latest?.Title ?? "Có thông báo mới",
                    Severity.Info, cfg => cfg.VisibleStateDuration = 4000);

                InvokeAsync(StateHasChanged);
            });

            _hub.On<string>("ForceLogout", message =>
            {
                if (_isDisposed) return;
                Snackbar.Add(message, Severity.Warning);
                InvokeAsync(() => Nav.NavigateTo("/login", forceLoad: true));
            });

            _hub.Reconnecting += _ =>
            {
                if (_isDisposed) return Task.CompletedTask;
                _isConnected = false;
                return InvokeAsync(StateHasChanged);
            };

            _hub.Reconnected += _ =>
            {
                if (_isDisposed) return Task.CompletedTask;
                _isConnected = true;
                return InvokeAsync(StateHasChanged);
            };

            _hub.Closed += _ =>
            {
                if (_isDisposed) return Task.CompletedTask;
                _isConnected = false;
                return InvokeAsync(StateHasChanged);
            };

            await _hub.StartAsync();
            _isConnected = true;
            await InvokeAsync(StateHasChanged);

            // Load danh sách lần đầu
            await LoadNotificationsAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[NotificationBadge] FAILED: {ex.Message}");
            _isConnected = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task LoadNotificationsAsync()
    {
        if (_isDisposed || _hub?.State != HubConnectionState.Connected) return;
        try
        {
            Console.WriteLine($"[NotificationBadge] Calling GetNotifications... HubState={_hub.State}");

            var result = await _hub.InvokeAsync<IEnumerable<NotificationDto>>("GetNotifications");

            Console.WriteLine($"[NotificationBadge] GetNotifications returned: {(result == null ? "NULL" : result.Count() + " items")}");

            _items = result?.ToList() ?? new();
            _unreadCount = _items.Count(i => !i.IsRead);

            Console.WriteLine($"[NotificationBadge] _items={_items.Count} _unreadCount={_unreadCount}");

            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[NotificationBadge] LoadNotifications EXCEPTION: {ex.GetType().Name}: {ex.Message}");
        }
    }

    private async Task TogglePanel()
    {
        _showPanel = !_showPanel;
        if (_showPanel && _isConnected && _items.Count == 0)
            await LoadNotificationsAsync();
    }

    private async Task ClickItem(NotificationDto item)
    {
        if (_hub?.State != HubConnectionState.Connected) return;
        try
        {
            if (!item.IsRead)
            {
                await _hub.InvokeAsync("MarkRead", item.Id);
                // Cập nhật local — dùng property assign thay vì 'with' vì NotificationDto là class
                item.IsRead = true;
                _unreadCount = Math.Max(0, _unreadCount - 1);
            }

            if (!string.IsNullOrEmpty(item.ActionUrl))
                Nav.NavigateTo(item.ActionUrl);

            _showPanel = false;
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[NotificationBadge] ClickItem failed: {ex.Message}");
        }
    }

    private async Task MarkAllRead()
    {
        if (_hub?.State != HubConnectionState.Connected) return;
        try
        {
            await _hub.InvokeAsync("MarkAllRead");
            // Dùng foreach thay vì 'with' vì NotificationDto là class không phải record
            foreach (var i in _items) i.IsRead = true;
            _unreadCount = 0;
            _showPanel = false;
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[NotificationBadge] MarkAllRead failed: {ex.Message}");
        }
    }

    public async ValueTask DisposeAsync()
    {
        _isDisposed = true;
        if (_hub != null)
        {
            try { await _hub.StopAsync(); await _hub.DisposeAsync(); }
            catch { }
        }
    }
}
