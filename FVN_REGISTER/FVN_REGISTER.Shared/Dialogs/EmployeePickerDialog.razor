@using FVN_REGISTER.Contract.ViewModels.OT

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@Icons.Material.Filled.People" Class="mr-2" />
            Chọn nhân viên OT
            <MudChip T="string" Size="Size.Small" Color="Color.Info"
                     Label="true" Class="ml-2">@Employees.Count người</MudChip>
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudTextField T="string"
                      @bind-Value="_searchText"
                      Label="Tìm tên hoặc mã nhân viên"
                      Adornment="Adornment.Start"
                      AdornmentIcon="@Icons.Material.Filled.Search"
                      Variant="Variant.Outlined"
                      Margin="Margin.Dense"
                      Class="mb-3"
                      Immediate="true" />

        <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-2">
            <MudCheckBox T="bool" Value="@IsAllSelected"
                         ValueChanged="ToggleAll" Label="Chọn tất cả" />
            <MudText Typo="Typo.caption" Color="Color.Secondary">
                (@_selected.Count / @Filtered.Count đã chọn)
            </MudText>
        </MudStack>

        <MudDivider Class="mb-2" />

        <div style="max-height:400px; overflow-y:auto;">
            @if (!Filtered.Any())
            {
                <MudAlert Severity="Severity.Info" Dense="true">
                    Không tìm thấy nhân viên nào.
                </MudAlert>
            }
            else
            {
                @foreach (var emp in Filtered)
                {
                    var alreadyAdded = AlreadySelected.Contains(emp.EmployeeCode);
                    var isCurrent = emp.EmployeeCode == CurrentUserCode;

                    <MudPaper Elevation="0" Class="pa-2 mb-1"
                              Style="border:1px solid var(--mud-palette-divider); border-radius:6px;">
                        <MudStack Row="true" AlignItems="AlignItems.Center"
                                  Justify="Justify.SpaceBetween">
                            <MudStack Row="true" AlignItems="AlignItems.Center">
                                <MudCheckBox T="bool"
                                             Value="@(_selected.Contains(emp.EmployeeCode))"
                                             ValueChanged="@(v => Toggle(emp.EmployeeCode, v))"
                                             Disabled="@(isCurrent || alreadyAdded)" />
                                <MudAvatar Color="Color.Primary" Size="Size.Small">
                                    @(emp.EmployeeName?.FirstOrDefault() ?? '?')
                                </MudAvatar>
                                <div>
                                    <MudText Typo="Typo.body2">
                                        <strong>@emp.EmployeeName</strong>
                                        @if (isCurrent)
                                        {
                                            <MudChip T="string" Size="Size.Small"
                                                     Color="Color.Info" Label="true" Class="ml-1">Bạn</MudChip>
                                        }
                                    </MudText>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                                        @emp.EmployeeCode
                                        @if (emp.CvCode == "0003")
                                        {
                                            <MudChip T="string" Size="Size.Small"
                                                     Color="Color.Warning" Label="true" Class="ml-1">CN</MudChip>
                                        }
                                    </MudText>
                                </div>
                            </MudStack>
                            @if (alreadyAdded && !isCurrent)
                            {
                                <MudChip T="string" Size="Size.Small"
                                         Color="Color.Success" Label="true">Đã thêm</MudChip>
                            }
                        </MudStack>
                    </MudPaper>
                }
            }
        </div>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Hủy</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                   OnClick="Confirm"
                   Disabled="@(!_selected.Any())">
            Thêm @_selected.Count nhân viên
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public List<OTEmployeeModel> Employees { get; set; } = new();
    [Parameter] public HashSet<string> AlreadySelected { get; set; } = new();
    [Parameter] public string CurrentUserCode { get; set; } = "";

    private string _searchText = "";
    private HashSet<string> _selected = new();

    private List<OTEmployeeModel> Filtered => string.IsNullOrWhiteSpace(_searchText)
        ? Employees
        : Employees.Where(e =>
            (e.EmployeeName?.Contains(_searchText, StringComparison.OrdinalIgnoreCase) ?? false) ||
            (e.EmployeeCode?.Contains(_searchText, StringComparison.OrdinalIgnoreCase) ?? false))
          .ToList();

    private bool IsAllSelected =>
        Filtered.Any() &&
        Filtered.Where(e => e.EmployeeCode != CurrentUserCode &&
                            !AlreadySelected.Contains(e.EmployeeCode))
                .All(e => _selected.Contains(e.EmployeeCode));

    private void Toggle(string code, bool val)
    {
        if (val) _selected.Add(code);
        else _selected.Remove(code);
    }

    private void ToggleAll(bool val)
    {
        if (val)
            foreach (var e in Filtered.Where(e =>
                e.EmployeeCode != CurrentUserCode &&
                !AlreadySelected.Contains(e.EmployeeCode)))
                _selected.Add(e.EmployeeCode);
        else
            _selected.Clear();
    }

    private void Confirm() => MudDialog.Close(DialogResult.Ok(_selected));
    private void Cancel() => MudDialog.Cancel();
}