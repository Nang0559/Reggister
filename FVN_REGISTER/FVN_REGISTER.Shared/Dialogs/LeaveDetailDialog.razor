@* File: LeaveDetailDialog.razor *@
@using FVN_REGISTER.Contract.ViewModels
@using FVN_REGISTER.Contract.Utils
@using FVN_REGISTER.Shared.Services.Leaves
@inject ILeaveCreateClientService LeaveService
@inject ISnackbar Snackbar

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@Icons.Material.Filled.Info" Class="mr-2" />
            Chi tiết đơn nghỉ
        </MudText>
    </TitleContent>

    <DialogContent>
        @if (Item?.ExtendedProps == null)
        {
            <MudText>Không có dữ liệu</MudText>
            return;
        }

        @* Thông tin cơ bản *@
        <MudSimpleTable Dense="true" Class="mb-3">
            <tbody>
                <tr>
                    <td><MudText Typo="Typo.caption" Color="Color.Secondary">Ngày đăng ký</MudText></td>
                    <td><MudText Typo="Typo.body2">@FormatDate(Item.ExtendedProps.registerdate)</MudText></td>
                </tr>
                <tr>
                    <td><MudText Typo="Typo.caption" Color="Color.Secondary">Thời gian</MudText></td>
                    <td>
                        <MudText Typo="Typo.body2">
                            @FormatDate(Item.Start) → @FormatDate(Item.End)
                        </MudText>
                    </td>
                </tr>
                <tr>
                    <td><MudText Typo="Typo.caption" Color="Color.Secondary">Số ngày</MudText></td>
                    <td>
                        <MudText Typo="Typo.body2">
                            @Item.ExtendedProps.totalDay ngày
                            @if (Item.ExtendedProps.totalDay != Item.ExtendedProps.daylev)
                            {
                                <span class="ml-1 mud-text-secondary">(tính phép: @Item.ExtendedProps.daylev)</span>
                            }
                        </MudText>
                    </td>
                </tr>
                <tr>
                    <td><MudText Typo="Typo.caption" Color="Color.Secondary">Lý do</MudText></td>
                    <td><MudText Typo="Typo.body2">@Item.ExtendedProps.description</MudText></td>
                </tr>
                <tr>
                    <td><MudText Typo="Typo.caption" Color="Color.Secondary">Trạng thái</MudText></td>
                    <td>
                        @{
                            var (color, statusText) = Item.Status switch
                            {
                                "Approved" => (Color.Success, "Đã duyệt"),
                                "Rejected" => (Color.Error, "Từ chối"),
                                "ApprovedLv1" => (Color.Info, "Cấp 1 đã duyệt"),
                                "ApprovedLv2" => (Color.Info, "Cấp 2 đã duyệt"),
                                _ => (Color.Warning, "Chờ duyệt")
                            };
                        }
                        <MudChip T="string" Color="@color" Size="Size.Small" Text="@statusText" />
                    </td>
                </tr>
            </tbody>
        </MudSimpleTable>

        @* Timeline phê duyệt *@
        <MudText Typo="Typo.subtitle2" Class="mb-2">Quy trình phê duyệt</MudText>

        <MudTimeline TimelinePosition="TimelinePosition.Start" Class="mb-2">

            @* Cấp 1 *@
            @{
                bool lv1Done = Item.ExtendedProps.level1ApprovedDate.HasValue;
                var lv1Color = lv1Done ? Color.Success : Color.Default;
            }
            <MudTimelineItem Color="@lv1Color" Size="Size.Small">
                <ItemContent>
                    <MudPaper Class="pa-2" Elevation="0" Outlined="true">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Cấp duyệt 1</MudText>
                        <MudText Typo="Typo.body2">
                            @(string.IsNullOrEmpty(Item.ExtendedProps.level1ApprovedBy)
                                                        ? Item.ExtendedProps.Level1ApproveEmail
                                                        : Item.ExtendedProps.level1ApprovedBy)
                        </MudText>
                        @if (lv1Done)
                        {
                            <MudText Typo="Typo.caption" Color="Color.Success">
                                ✓ @FormatDate(Item.ExtendedProps.level1ApprovedDate)
                            </MudText>
                        }
                        else
                        {
                            <MudText Typo="Typo.caption" Color="Color.Warning">Đang chờ</MudText>
                        }
                        @if (!string.IsNullOrEmpty(Item.ExtendedProps.level1Comment))
                        {
                            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-1">
                                "@Item.ExtendedProps.level1Comment"
                            </MudText>
                        }
                    </MudPaper>
                </ItemContent>
            </MudTimelineItem>

            @* Cấp 2 *@
            @{
                bool lv2Done = Item.ExtendedProps.level2ApprovedDate.HasValue;
                var lv2Color = lv2Done ? Color.Success : Color.Default;
            }
            @if (!string.IsNullOrEmpty(Item.ExtendedProps.Level2ApproveEmail))
            {
                <MudTimelineItem Color="@lv2Color" Size="Size.Small">
                    <ItemContent>
                        <MudPaper Class="pa-2" Elevation="0" Outlined="true">
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Cấp duyệt 2</MudText>
                            <MudText Typo="Typo.body2">
                                @(string.IsNullOrEmpty(Item.ExtendedProps.level2ApprovedBy)
                                                            ? Item.ExtendedProps.Level2ApproveEmail
                                                            : Item.ExtendedProps.level2ApprovedBy)
                        </MudText>
                        @if (lv2Done)
                            {
                                <MudText Typo="Typo.caption" Color="Color.Success">
                                    ✓ @FormatDate(Item.ExtendedProps.level2ApprovedDate)
                                </MudText>
                            }
                            else
                            {
                                <MudText Typo="Typo.caption" Color="Color.Warning">Đang chờ</MudText>
                            }
                        </MudPaper>
                    </ItemContent>
                </MudTimelineItem>
            }

            @* Cấp 3 *@
            @{
                bool lv3Done = Item.ExtendedProps.level3ApprovedDate.HasValue;
                var lv3Color = lv3Done ? Color.Success : Color.Default;
            }
            @if (!string.IsNullOrEmpty(Item.ExtendedProps.Level3ApproveEmail))
            {
                <MudTimelineItem Color="@lv3Color" Size="Size.Small">
                    <ItemContent>
                        <MudPaper Class="pa-2" Elevation="0" Outlined="true">
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Cấp duyệt 3 (GM)</MudText>
                            <MudText Typo="Typo.body2">
                                @(string.IsNullOrEmpty(Item.ExtendedProps.level3ApprovedBy)
                                                            ? Item.ExtendedProps.Level3ApproveEmail
                                                            : Item.ExtendedProps.level3ApprovedBy)
                        </MudText>
                        @if (lv3Done)
                            {
                                <MudText Typo="Typo.caption" Color="Color.Success">
                                    ✓ @FormatDate(Item.ExtendedProps.level3ApprovedDate)
                                </MudText>
                            }
                            else
                            {
                                <MudText Typo="Typo.caption" Color="Color.Warning">Đang chờ</MudText>
                            }
                        </MudPaper>
                    </ItemContent>
                </MudTimelineItem>
            }
        </MudTimeline>

        @* Hủy đơn - chỉ khi Pending *@
        @if (Item.Status == "Pending" || Item.Status == "ApprovedLv1")
        {
            <MudDivider Class="my-2" />
            <MudExpansionPanels Elevation="0">
                <MudExpansionPanel Text="Yêu cầu hủy đơn" Icon="@Icons.Material.Filled.Cancel">
                    <MudTextField @bind-Value="_cancelReason" Label="Lý do hủy *"
                                  Lines="2" Variant="Variant.Outlined" Margin="Margin.Dense" />
                    <MudButton OnClick="ConfirmCancel" Color="Color.Error" Variant="Variant.Outlined"
                               Class="mt-2" Disabled="@_isCancelling" Size="Size.Small">
                        @(_isCancelling ? "Đang xử lý..." : "Xác nhận hủy đơn")
                    </MudButton>
                </MudExpansionPanel>
            </MudExpansionPanels>
        }

    </DialogContent>

    <DialogActions>
        <MudButton OnClick="Close" Variant="Variant.Text">Đóng</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public HolidayViewModel Item { get; set; } = default!;
    [Parameter] public EventCallback OnCancelled { get; set; }

    private string _cancelReason = "";
    private bool _isCancelling;

    private async Task ConfirmCancel()
    {
        if (string.IsNullOrWhiteSpace(_cancelReason))
        {
            Snackbar.Add("Vui lòng nhập lý do hủy", Severity.Warning);
            return;
        }

        if (!int.TryParse(Item.Id, out var leaveId))
        {
            Snackbar.Add("ID đơn không hợp lệ", Severity.Error);
            return;
        }

        _isCancelling = true;
        var result = await LeaveService.CancelLeaveAsync(leaveId, _cancelReason);

        if (result.IsSuccess)
        {
            await OnCancelled.InvokeAsync();
            MudDialog.Close(DialogResult.Ok(true));
        }
        else
        {
            Snackbar.Add(result.Message ?? "Hủy đơn thất bại", Severity.Error);
        }
        _isCancelling = false;
    }

    private void Close() => MudDialog.Cancel();

    private static string FormatDate(object? date) => date switch
    {
        DateTime dt => dt.ToString("dd/MM/yyyy"),
        DateOnly d => d.ToString("dd/MM/yyyy"),
        string s when DateTime.TryParse(s, out var dt) => dt.ToString("dd/MM/yyyy"),
        _ => ""
    };
}
