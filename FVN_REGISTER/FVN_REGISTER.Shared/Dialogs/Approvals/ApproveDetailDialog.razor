@using FVN_REGISTER.Contract.Dtos.Approvals
@using FVN_REGISTER.Shared.Components.OT
@using FVN_REGISTER.Shared.Services.Approvals

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">Chi tiết đơn — @Item.EmployeeName</MudText>
    </TitleContent>
    <DialogContent>
        <MudSimpleTable Dense="true" Class="mb-3">
            <tbody>
                <tr><td><b>Mã NV</b></td><td>@Item.EmployeeCode</td></tr>
                <tr><td><b>Loại đơn</b></td><td>@Item.KindDisplay</td></tr>
                <tr><td><b>Thời gian</b></td><td>@(Item.FromDate?.ToString("dd/MM/yyyy") ?? "—") → @(Item.ToDate?.ToString("dd/MM/yyyy") ?? "—")</td></tr>
                <tr><td><b>Số lượng</b></td><td>@Item.TotalUnits.ToString("N1") @Item.UnitDisplay</td></tr>
                <tr><td><b>Phòng ban</b></td><td>@Item.DeptName</td></tr>
                <tr><td><b>Cấp đang chờ</b></td><td>@Item.CurrentApprovalLevel</td></tr>
                <tr><td><b>Người duyệt</b></td><td>@(Item.CurrentApproverName ?? "—")</td></tr>
            </tbody>
        </MudSimpleTable>

        <MudText Typo="Typo.subtitle2" Class="mb-2">Tiến trình phê duyệt</MudText>
        <OTApprovalProgressBar Steps="@Item.ApprovalSteps" />

        <MudTextField @bind-Value="_comment" Label="Ý kiến / Lý do từ chối"
                      Lines="2" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mt-3" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => MudDialog.Cancel())" Variant="Variant.Text">Đóng</MudButton>
        <MudButton Color="Color.Error" Variant="Variant.Outlined" Disabled="@(string.IsNullOrWhiteSpace(_comment) || _isBusy)" OnClick="Reject">Từ chối</MudButton>
        <MudButton Color="Color.Success" Variant="Variant.Filled" Disabled="_isBusy" OnClick="Approve">@(_isBusy ? "Đang xử lý..." : "Phê duyệt")</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public PendingApprovalItemDto Item { get; set; } = default!;
    [Parameter] public int Level { get; set; }
    [Parameter] public EventCallback OnApproved { get; set; }
    [Parameter] public EventCallback OnRejected { get; set; }
    [Inject] IApprovalListClientService ApproveService { get; set; } = default!;
    [Inject] ISnackbar Snackbar { get; set; } = default!;

    private string _comment = string.Empty;
    private bool _isBusy;

    private async Task Approve()
    {
        _isBusy = true;
        var result = await ApproveService.ApproveAsync(new List<int> { Item.RequestId }, Item.Kind, Level > 0 ? Level : Item.CurrentApprovalLevel, _comment);
        if (result.IsSuccess)
        {
            Snackbar.Add("Đã phê duyệt!", Severity.Success);
            await OnApproved.InvokeAsync();
            MudDialog.Close(DialogResult.Ok(true));
        }
        else Snackbar.Add(result.Message ?? "Lỗi", Severity.Error);
        _isBusy = false;
    }

    private async Task Reject()
    {
        _isBusy = true;
        var result = await ApproveService.RejectAsync(new List<int> { Item.RequestId }, Item.Kind, Level > 0 ? Level : Item.CurrentApprovalLevel, _comment);
        if (result.IsSuccess)
        {
            Snackbar.Add("Đã từ chối!", Severity.Info);
            await OnRejected.InvokeAsync();
            MudDialog.Close(DialogResult.Ok(true));
        }
        else Snackbar.Add(result.Message ?? "Lỗi", Severity.Error);
        _isBusy = false;
    }
}
