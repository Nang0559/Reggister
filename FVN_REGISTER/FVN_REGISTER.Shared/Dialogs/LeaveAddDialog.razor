@* File: LeaveAddDialog.razor *@
@using FVN_REGISTER.Contract.Models
@using FVN_REGISTER.Contract.ViewModels
@using FVN_REGISTER.Shared.Services.Leaves
@inject ILeaveCreateClientService LeaveService
@inject ISnackbar Snackbar

<style>
    .native-select {
        width: 100%;
        border: none;
        border-bottom: 1px solid rgba(0,0,0,0.42);
        outline: none;
        background: transparent;
        font-size: 0.875rem;
        font-family: inherit;
        color: inherit;
        cursor: pointer;
        padding: 6px 0 4px 0;
        border-radius: 0;
    }

        .native-select:focus {
            border-bottom: 2px solid var(--mud-palette-primary);
        }

        .native-select option {
            background: white;
            color: #212121;
        }

    .field-label {
        font-size: 0.75rem;
        color: rgba(0,0,0,0.6);
        margin-bottom: 2px;
        display: block;
    }

    .field-wrap {
        padding: 4px 0;
        width: 100%;
    }
</style>

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@Icons.Material.Filled.EditCalendar" Class="mr-2" />
            Đăng ký nghỉ phép
        </MudText>
    </TitleContent>

    <DialogContent>
        <MudForm @ref="_form" @bind-IsValid="_formValid">

            @* Hàng 1: Năm, Từ ngày, Đến ngày *@
            <MudGrid Spacing="2">
                <MudItem xs="12" sm="4">
                    @* ✅ Năm làm việc — native select *@
                    <div class="field-wrap">
                        <span class="field-label">Năm làm việc *</span>
                        <select class="native-select"
                                @onchange="@((ChangeEventArgs e) =>
                                                                    _request.WorkYear = int.TryParse(e.Value?.ToString(), out var y) ? y : DateTime.Now.Year)">
                            @foreach (var yr in Model.WorkYears)
                            {
                                var yVal = yr.WorkYear ?? DateTime.Now.Year;
                                @if (yVal == _request.WorkYear)
                                {
                                    <option value="@yVal" selected>@yVal</option>
                                }
                                else
                                {
                                    <option value="@yVal">@yVal</option>
                                }
                            }
                        </select>
                    </div>
                </MudItem>

                @* Từ ngày *@
                <MudItem xs="12" sm="4">
                    <MudDatePicker Date="_startDate"
                                   DateChanged="OnStartDateChanged"
                                   Label="Từ ngày *"
                                   Variant="Variant.Outlined" Margin="Margin.Dense"
                                   IsDateDisabledFunc="IsHolidayOrWeekend" />
                </MudItem>

                @* Đến ngày *@
                <MudItem xs="12" sm="4">
                    <MudDatePicker Date="_endDate"
                                   DateChanged="OnEndDateChanged"
                                   Label="Đến ngày *"
                                   Variant="Variant.Outlined" Margin="Margin.Dense"
                                   IsDateDisabledFunc="IsHolidayOrWeekend" />
                </MudItem>
            </MudGrid>

            @* Bảng chi tiết từng ngày *@
            @if (_details.Any())
            {
                <MudPaper Class="mt-3" Elevation="0" Outlined="true">
                    <MudSimpleTable Dense="true" Striped="true" Style="max-height: 280px; overflow-y: auto;">
                        <thead>
                            <tr>
                                <th>Ngày nghỉ</th>
                                <th>Loại phép</th>
                                <th style="width:90px">Nghỉ nửa ngày</th>
                                <th style="width:80px">Tính phép</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var d in _details)
                            {
                                <tr @key="d.LeaveDate">
                                    <td>
                                        <MudText Typo="Typo.body2">
                                            @d.LeaveDate.ToString("dd/MM/yyyy (ddd)")
                                        </MudText>
                                    </td>
                                    <td>
                                        @* ✅ native select — tránh MudListItem crash *@
                                        <select class="native-select"
                                                @onchange="@((ChangeEventArgs e) =>
                                                OnLeaveTypeChanged(d, e.Value?.ToString() ?? ""))">
                                    @foreach (var lt in Model.LeaveTypes)
                                            {
                                                @if (lt.LeaveTypeCode == d.LeaveTypeCode)
                                                {
                                                    <option value="@lt.LeaveTypeCode" selected>@lt.LeaveTypeName</option>
                                                }
                                                else
                                                {
                                                    <option value="@lt.LeaveTypeCode">@lt.LeaveTypeName</option>
                                                }
                                            }
                                        </select>
                                    </td>
                                    <td style="text-align:center;">
                                        @* ✅ native checkbox *@
                                        <input type="checkbox"
                                               checked="@d.IsHalfDay"
                                               @onchange="@((ChangeEventArgs e) =>
                                               OnHalfDayChanged(d, e.Value is bool b ? b : bool.Parse(e.Value?.ToString() ?? "false")))" />
                            </td>
                            <td>
                                @{
                                            var leaveType = Model.LeaveTypes
                                            .FirstOrDefault(x => x.LeaveTypeCode == d.LeaveTypeCode);
                                            bool tinhPhep = leaveType?.TinhPhep == true;
                                        }
                                        @if (tinhPhep)
                                        {
                                            <MudChip T="string" Color="Color.Success" Size="Size.Small" Text="Có" />
                                        }
                                        else
                                        {
                                            <MudChip T="string" Color="Color.Default" Size="Size.Small" Text="Không" />
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </MudSimpleTable>
                </MudPaper>
            }

            @* Tổng ngày *@
            <MudGrid Spacing="2" Class="mt-2">
                <MudItem xs="6">
                    <MudTextField Value="@_totalDay" Label="Tổng số ngày"
                                  Variant="Variant.Outlined" Margin="Margin.Dense"
                                  ReadOnly="true" Adornment="Adornment.End" AdornmentText="ngày" />
                </MudItem>
                <MudItem xs="6">
                    <MudTextField Value="@_totalLeaveDay" Label="Ngày tính phép"
                                  Variant="Variant.Outlined" Margin="Margin.Dense"
                                  ReadOnly="true" Adornment="Adornment.End" AdornmentText="ngày"
                                  AdornmentColor="Color.Warning" />
                </MudItem>
            </MudGrid>

            @* Lý do *@
            <MudTextField @bind-Value="_request.LeaveReason" Label="Lý do nghỉ *"
                          Lines="2" Variant="Variant.Outlined" Margin="Margin.Dense"
                          Class="mt-2" Required="true" RequiredError="Vui lòng nhập lý do" />

            @* Người duyệt — ✅ toàn bộ dùng native select *@
            <MudGrid Spacing="2" Class="mt-2">
                @if (Model.LVA1.Any())
                {
                    <MudItem xs="12" sm="4">
                        <div class="field-wrap">
                            <span class="field-label">1. @Model.LVA1.First().LevelName</span>
                            <select class="native-select"
                                    @onchange="@((ChangeEventArgs e) =>
                                    _request.Level1ApproveEmail = e.Value?.ToString() ?? "")">
                            <option value="">-- Chọn --</option>
                            @foreach (var a in Model.LVA1)
                                {
                                    var selected = a.ApproveLevelEmail == _request.Level1ApproveEmail;
                                    @if (selected)
                                    {
                                        <option value="@a.ApproveLevelEmail" selected>
                                            @a.ApproveLevelName (@(string.IsNullOrEmpty(a.DeptCode) ? "ALL" : a.DeptCode))
                                        </option>
                                    }
                                    else
                                    {
                                        <option value="@a.ApproveLevelEmail">
                                            @a.ApproveLevelName (@(string.IsNullOrEmpty(a.DeptCode) ? "ALL" : a.DeptCode))
                                        </option>
                                    }
                                }
                            </select>
                        </div>
                    </MudItem>
                }

                @if (Model.LVA2.Any())
                {
                    <MudItem xs="12" sm="4">
                        <div class="field-wrap">
                            <span class="field-label">2. @Model.LVA2.First().LevelName</span>
                            <select class="native-select"
                                    @onchange="@((ChangeEventArgs e) =>
                                    _request.Level2ApproveEmail = e.Value?.ToString() ?? "")">
                            <option value="">-- Chọn --</option>
                            @foreach (var a in Model.LVA2)
                                {
                                    var selected = a.ApproveLevelEmail == _request.Level2ApproveEmail;
                                    @if (selected)
                                    {
                                        <option value="@a.ApproveLevelEmail" selected>
                                            @a.ApproveLevelName (@(string.IsNullOrEmpty(a.DeptCode) ? "ALL" : a.DeptCode))
                                        </option>
                                    }
                                    else
                                    {
                                        <option value="@a.ApproveLevelEmail">
                                            @a.ApproveLevelName (@(string.IsNullOrEmpty(a.DeptCode) ? "ALL" : a.DeptCode))
                                        </option>
                                    }
                                }
                            </select>
                        </div>
                    </MudItem>
                }

                @if (Model.LVA3.Any())
                {
                    <MudItem xs="12" sm="4">
                        <div class="field-wrap">
                            <span class="field-label">3. @Model.LVA3.First().LevelName</span>
                            <select class="native-select"
                                    @onchange="@((ChangeEventArgs e) =>
                                    _request.Level3ApproveEmail = e.Value?.ToString() ?? "")">
                            <option value="">-- Chọn --</option>
                            @foreach (var a in Model.LVA3)
                                {
                                    var selected = a.ApproveLevelEmail == _request.Level3ApproveEmail;
                                    @if (selected)
                                    {
                                        <option value="@a.ApproveLevelEmail" selected>
                                            @a.ApproveLevelName (@(string.IsNullOrEmpty(a.DeptCode) ? "ALL" : a.DeptCode))
                                        </option>
                                    }
                                    else
                                    {
                                        <option value="@a.ApproveLevelEmail">
                                            @a.ApproveLevelName (@(string.IsNullOrEmpty(a.DeptCode) ? "ALL" : a.DeptCode))
                                        </option>
                                    }
                                }
                            </select>
                        </div>
                    </MudItem>
                }
            </MudGrid>

        </MudForm>
    </DialogContent>

    <DialogActions>
        <MudButton OnClick="Cancel" Variant="Variant.Text">Đóng</MudButton>
        <MudButton OnClick="Submit" Color="Color.Primary" Variant="Variant.Filled"
                   Disabled="@_isSaving">
            @if (_isSaving)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-1" />
                <span>Đang lưu...</span>
            }
            else
            {
                <MudIcon Icon="@Icons.Material.Filled.Send" Size="Size.Small" Class="mr-1" />
                <span>Gửi đơn</span>
            }
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public CombinedHolidaysViewModel Model { get; set; } = default!;
    [Parameter] public string? DefaultStart { get; set; }
    [Parameter] public string? DefaultEnd { get; set; }
    [Parameter] public int SelectedYear { get; set; } = DateTime.Now.Year;
    [Parameter] public EventCallback OnSaved { get; set; }

    private MudForm _form = default!;
    private bool _formValid;
    private bool _isSaving;

    private DateTime? _startDate;
    private DateTime? _endDate;
    private List<CreateLeaveDetailModel> _details = new();
    private decimal _totalDay;
    private decimal _totalLeaveDay;

    private CreateLeaveRequestModel _request = new();

    // ─── Lifecycle ───────────────────────────────────────
    protected override void OnInitialized()
    {
        _request.WorkYear = SelectedYear;

        if (!string.IsNullOrEmpty(DefaultStart) && DateTime.TryParse(DefaultStart, out var s))
            _startDate = s;

        if (!string.IsNullOrEmpty(DefaultEnd) && DateTime.TryParse(DefaultEnd, out var e))
            _endDate = e;
        else
            _endDate = _startDate;

        var defaultType = Model.LeaveTypes.FirstOrDefault(x => x.LeaveTypeCode == "0021")
                          ?? Model.LeaveTypes.FirstOrDefault();

        if (_startDate.HasValue)
            BuildDetails(defaultType?.LeaveTypeCode ?? "");
    }

    // ─── Date Changed ────────────────────────────────────
    private void OnStartDateChanged(DateTime? date)
    {
        _startDate = date;
        RebuildDetails();
    }

    private void OnEndDateChanged(DateTime? date)
    {
        _endDate = date;
        RebuildDetails();
    }

    private void RebuildDetails()
    {
        var defaultType = Model.LeaveTypes.FirstOrDefault(x => x.LeaveTypeCode == "0021")
                          ?? Model.LeaveTypes.FirstOrDefault();
        BuildDetails(defaultType?.LeaveTypeCode ?? "");
    }

    // ─── Build Details ───────────────────────────────────
    private void BuildDetails(string defaultLeaveTypeCode)
    {
        _details.Clear();
        if (!_startDate.HasValue || !_endDate.HasValue) return;
        if (_startDate > _endDate) return;

        for (var d = _startDate.Value.Date; d <= _endDate.Value.Date; d = d.AddDays(1))
        {
            if (d.DayOfWeek == DayOfWeek.Saturday || d.DayOfWeek == DayOfWeek.Sunday)
                continue;

            if (Model.CompanyHolidays.Any(x => x.Start == d.ToString("yyyy-MM-dd")))
                continue;

            var lt = Model.LeaveTypes.FirstOrDefault(x => x.LeaveTypeCode == defaultLeaveTypeCode);

            _details.Add(new CreateLeaveDetailModel
            {
                LeaveDate = d,
                LeaveTypeCode = defaultLeaveTypeCode,
                LeaveTypeName = lt?.LeaveTypeName ?? "",
                IsHalfDay = false,
                HalfDayOption = null,
                DayValue = 1m,
                TinhPhep = lt?.TinhPhep == true ? 1 : 0
            });
        }

        RecalcTotals();
    }

    // ─── Event Handlers ──────────────────────────────────
    private void OnLeaveTypeChanged(CreateLeaveDetailModel detail, string newCode)
    {
        if (detail == null || string.IsNullOrEmpty(newCode)) return;

        var lt = Model.LeaveTypes.FirstOrDefault(x => x.LeaveTypeCode == newCode);
        detail.LeaveTypeCode = newCode;
        detail.LeaveTypeName = lt?.LeaveTypeName ?? "";
        detail.TinhPhep = lt?.TinhPhep == true ? 1 : 0;

        RecalcTotals();
        InvokeAsync(StateHasChanged);
    }

    private void OnHalfDayChanged(CreateLeaveDetailModel detail, bool isHalfDay)
    {
        if (detail == null) return;

        detail.IsHalfDay = isHalfDay;
        detail.DayValue = isHalfDay ? 0.5m : 1m;
        detail.HalfDayOption = isHalfDay ? "Morning" : null;

        RecalcTotals();
        InvokeAsync(StateHasChanged);
    }

    // ─── Totals ──────────────────────────────────────────
    private void RecalcTotals()
    {
        _totalDay = _details.Sum(x => x.DayValue);

        _totalLeaveDay = _details
            .Where(x =>
            {
                var lt = Model.LeaveTypes.FirstOrDefault(t => t.LeaveTypeCode == x.LeaveTypeCode);
                return lt?.TinhPhep == true;
            })
            .Sum(x => x.DayValue);
    }

    // ─── Validation ──────────────────────────────────────
    private bool IsHolidayOrWeekend(DateTime date)
    {
        if (date.DayOfWeek == DayOfWeek.Saturday || date.DayOfWeek == DayOfWeek.Sunday)
            return true;
        return Model.CompanyHolidays.Any(x => x.Start == date.ToString("yyyy-MM-dd"));
    }

    // ─── Submit ──────────────────────────────────────────
    private async Task Submit()
    {
        await _form.Validate();
        if (!_formValid) return;

        if (!_details.Any())
        {
            Snackbar.Add("Vui lòng chọn ít nhất một ngày nghỉ", Severity.Warning);
            return;
        }

        _isSaving = true;

        _request.StartDate = _startDate!.Value;
        _request.EndDate = _endDate!.Value;
        _request.Details = _details;
        _request.TotalDay = _totalDay;
        _request.TotalLeaveDay = _totalLeaveDay;
        // ✅ Tạm thêm để kiểm tra data gửi đi
        Snackbar.Add($"L1={_request.Level1ApproveEmail ?? "NULL"} | L2={_request.Level2ApproveEmail ?? "NULL"}", Severity.Info, c => c.VisibleStateDuration = 8000);

        var result = await LeaveService.CreateLeaveAsync(_request);

        if (result.IsSuccess)
        {
            Snackbar.Add("Gửi đơn thành công", Severity.Success);
            await OnSaved.InvokeAsync();
            MudDialog.Close(DialogResult.Ok(true));
        }
        else
        {
            Snackbar.Add(result.Message ?? "Gửi đơn thất bại", Severity.Error);
        }

        _isSaving = false;
    }

    // ─── Cancel ──────────────────────────────────────────
    private void Cancel() => MudDialog.Cancel();
}
