@using FVN_REGISTER.Contract.Dtos.Usermanagers

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@Icons.Material.Filled.Edit" Class="mr-2" />
            Sửa quyền tài khoản
        </MudText>
    </TitleContent>

    <DialogContent>
        <MudSelect T="int" @bind-Value="Request.PermissionCode"
                   Label="Quyền (*)"
                   Variant="Variant.Outlined"
                   Margin="Margin.Dense">
            <MudSelectItem Value="2">Administrator</MudSelectItem>
            <MudSelectItem Value="4">Approver</MudSelectItem>
            <MudSelectItem Value="5">User</MudSelectItem>
        </MudSelect>
        <MudTextField @bind-Value="Request.DeptCode"
                      Label="Mã phòng ban"
                      Variant="Variant.Outlined"
                      Margin="Margin.Dense"
                      Class="mt-3" />
    </DialogContent>

    <DialogActions>
        <MudButton OnClick="Cancel" Variant="Variant.Text">Hủy</MudButton>
        <MudButton OnClick="Submit"
                   Variant="Variant.Filled"
                   Color="Color.Primary">
            Lưu thay đổi
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public UpdateUserRequest Request { get; set; } = new();

    private void Submit() => MudDialog.Close(DialogResult.Ok(Request));
    private void Cancel() => MudDialog.Cancel();
}
