@* RequestDetailDialog.razor *@
@using FVN_REGISTER.Contract.Dtos.Approvals

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">
            Chi tiết #@Detail?.Id –
            @(Detail?.Kind == "leave" ? "Nghỉ phép" : "OT")
        </MudText>
    </TitleContent>
    <DialogContent>
        @if (Detail != null)
        {
            <MudGrid>
                <MudItem xs="6">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">NHÂN VIÊN</MudText>
                    <MudText>@Detail.EmployeeName (@Detail.EmployeeCode)</MudText>
                </MudItem>
                <MudItem xs="6">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">TRẠNG THÁI</MudText>
                    <MudText>@Detail.RequestStatus</MudText>
                </MudItem>
                @if (Detail.Kind == "leave")
                {
                    <MudItem xs="6">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">TỪ NGÀY</MudText>
                        <MudText>@Detail.StartDate?.ToString("dd/MM/yyyy")</MudText>
                    </MudItem>
                    <MudItem xs="6">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">ĐẾN NGÀY</MudText>
                        <MudText>@Detail.EndDate?.ToString("dd/MM/yyyy")</MudText>
                    </MudItem>
                }
                else
                {
                    <MudItem xs="6">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">NGÀY OT</MudText>
                        <MudText>@Detail.OTDate?.ToString("dd/MM/yyyy")</MudText>
                    </MudItem>
                    <MudItem xs="6">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">TỔNG GIỜ OT</MudText>
                        <MudText>@Detail.TotalOTHours?.ToString("N1") h</MudText>
                    </MudItem>
                }
                <MudItem xs="12">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">LÝ DO</MudText>
                    <MudText>@(Detail.Reason ?? "—")</MudText>
                </MudItem>
            </MudGrid>

            <MudDivider Class="my-3" />

            <MudText Typo="Typo.subtitle2" Class="mb-2">Tiến trình phê duyệt</MudText>
            <MudTimeline TimelineAlign="TimelineAlign.Start">
                @foreach (var lv in Detail.ApprovalLevels)
                {
                    <MudTimelineItem
                        Color="@(lv.IsApprove == true ? Color.Success
                                : lv.IsApprove == false ? Color.Error
                                : Color.Default)"
                        Size="Size.Small">
                        <ItemContent>
                            <MudText Typo="Typo.body2">
                                <strong>@lv.LevelLabel</strong> – @lv.ApproverName
                            </MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                @lv.StatusText
                                @if (lv.ApproveTime.HasValue)
                                {
                                    @($" lúc {lv.ApproveTime:HH:mm dd/MM/yyyy}")
                                }
                            </MudText>
                            @if (!string.IsNullOrEmpty(lv.Comment))
                            {
                                <MudText Typo="Typo.caption" Color="Color.Secondary">
                                    "@lv.Comment"
                                </MudText>
                            }
                        </ItemContent>
                    </MudTimelineItem>
                }
            </MudTimeline>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Close">Đóng</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public ApprovalItemDetailDto? Detail { get; set; }

    private void Close() => MudDialog.Close();
}