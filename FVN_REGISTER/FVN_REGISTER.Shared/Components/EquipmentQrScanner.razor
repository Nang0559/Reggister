@inject IJSRuntime JS

<MudPaper Class="pa-3">
    <video @ref="_video" autoplay playsinline muted style="width:100%;max-width:520px;border-radius:12px"></video>
    <MudStack Row="true" Class="mt-2">
        <MudButton Variant="Variant.Filled" OnClick="StartAsync" Disabled="_running">Bật camera quét QR</MudButton>
        <MudButton Variant="Variant.Outlined" OnClick="StopAsync" Disabled="!_running">Dừng</MudButton>
    </MudStack>
</MudPaper>

@code {
    [Parameter] public EventCallback<string> OnDetected { get; set; }
    private ElementReference _video; private IJSObjectReference? _module; private bool _running;
    protected override async Task OnAfterRenderAsync(bool firstRender) { if (firstRender) _module = await JS.InvokeAsync<IJSObjectReference>("import", "./_content/FVN_REGISTER.Shared/js/equipment-qr.js"); }
    private async Task StartAsync() { if (_module == null) return; _running = true; StateHasChanged(); var value = await _module.InvokeAsync<string?>("startQrScanner", _video); if (!string.IsNullOrWhiteSpace(value)) await OnDetected.InvokeAsync(value); _running = false; StateHasChanged(); }
    private async Task StopAsync() { if (_module != null) await _module.InvokeVoidAsync("stopQrScanner", _video); _running = false; }
    public async ValueTask DisposeAsync() { if (_module != null) { try { await _module.InvokeVoidAsync("stopQrScanner", _video); await _module.DisposeAsync(); } catch { } } }
}
