@using FVN_REGISTER.Contract.Dtos
@using FVN_REGISTER.Contract.Dtos.Leaves
@using FVN_REGISTER.Shared.Services.Users

@inject ICurrentUserClientService CurrentUser
@inject NavigationManager Nav

@* Thêm đoạn style css thuần để xử lý hover mượt mà và không gây re-render *@
<style>
    .action-card {
        border: 0.5px solid #e2e8f0;
        border-radius: 12px;
        cursor: pointer;
        text-align: left;
        height: 100%;
        min-height: 76px;
        background: #ffffff;
        padding: 12px 16px;
        transition: box-shadow 0.2s ease, transform 0.2s ease;
    }

        .action-card:hover {
            box-shadow: 0 10px 15px -3px rgba(0,0,0,0.04);
            transform: translateY(-2px);
        }
</style>

<div class="user-dashboard" style="width: 100%; padding: 0 24px; margin: 0 auto;">

    @* ===== GREETING HEADER ===== *@
    <MudPaper Elevation="0" Class="mb-5"
              Style="background: linear-gradient(135deg, #1E88E5 0%, #1565C0 100%);
                     border-radius: 16px; padding: 28px 32px; color: white;">
        <MudGrid Spacing="0" AlignItems="AlignItems.Center">
            <MudItem xs="12" sm="8" md="9">
                <MudText Style="font-size: 14px; opacity: 0.8; margin-bottom: 6px;">
                    @GetGreeting(),
                </MudText>
                <MudText Style="font-size: 26px; font-weight: 600; line-height: 1.2;">
                    @(CurrentUser.User?.FullName ?? "Nhân viên FCC")
                </MudText>
                <MudStack Row="true" AlignItems="AlignItems.Center" Class="mt-2" Spacing="3">
                    <MudText Style="font-size: 13px; opacity: 0.8;">
                        <MudIcon Icon="@Icons.Material.Filled.Business"
                                 Style="font-size: 14px; vertical-align: middle; margin-right: 4px;" />
                        @(CurrentUser.User?.DeptCode ?? "---")
                    </MudText>
                    <MudText Style="font-size: 13px; opacity: 0.8;">
                        <MudIcon Icon="@Icons.Material.Filled.Badge"
                                 Style="font-size: 14px; vertical-align: middle; margin-right: 4px;" />
                        @(CurrentUser.User?.EmployeeCode ?? "---")
                    </MudText>
                </MudStack>
            </MudItem>
            <MudItem xs="12" sm="4" md="3" Class="d-flex justify-end">
                <MudAvatar Style="height: 64px; width: 64px; font-size: 1.6rem;
                                  background: rgba(255,255,255,0.2); color: white;">
                    @(CurrentUser.User?.FullName?.Substring(0, 1).ToUpper() ?? "U")
                </MudAvatar>
            </MudItem>
        </MudGrid>
    </MudPaper>

    @* ===== SỐ DƯ PHÉP ===== *@
    @if (Balance != null)
    {
        <MudGrid Spacing="3" Class="mb-5">
            <MudItem xs="12" sm="4">
                <MudPaper Elevation="0" Class="pa-4"
                          Style="border: 0.5px solid #e2e8f0; border-radius: 12px;
                                     border-top: 3.5px solid #1E88E5; background: #ffffff;">
                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block mb-1" Style="font-weight: 600;">
                        TỔNG PHÉP NĂM
                    </MudText>
                    <MudText Style="font-size: 28px; font-weight: 700; color: #1E88E5;">
                        @Balance.Entitled.ToString("N1")
                    </MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">ngày</MudText>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" sm="4">
                <MudPaper Elevation="0" Class="pa-4"
                          Style="border: 0.5px solid #e2e8f0; border-radius: 12px;
                                     border-top: 3.5px solid #F57C00; background: #ffffff;">
                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block mb-1" Style="font-weight: 600;">
                        ĐÃ SỬ DỤNG
                    </MudText>
                    <MudText Style="font-size: 28px; font-weight: 700; color: #F57C00;">
                        @Balance.Used.ToString("N1")
                    </MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">ngày</MudText>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" sm="4">
                <MudPaper Elevation="0" Class="pa-4"
                          Style="border: 0.5px solid #e2e8f0; border-radius: 12px;
                                     border-top: 3.5px solid #2E7D32; background: #ffffff;">
                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block mb-1" Style="font-weight: 600;">
                        CÒN LẠI
                    </MudText>
                    <MudText Style="font-size: 28px; font-weight: 700; color: #2E7D32;">
                        @Balance.Remaining.ToString("N1")
                    </MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">ngày</MudText>
                </MudPaper>
            </MudItem>
        </MudGrid>
    }

    @* ===== THAO TÁC NHANH ===== *@
    <MudText Typo="Typo.overline" Color="Color.Secondary" Class="mb-3 d-block"
             Style="letter-spacing: 0.1em; font-weight: 600;">
        THAO TÁC NHANH
    </MudText>

    <MudGrid Spacing="3" Class="mb-6">
        @foreach (var widget in _quickActions)
        {
            var currentWidget = widget;

            <MudItem xs="12" sm="6" md="3">
                @* GIẢI PHÁP TRIỆT ĐỂ: Bọc bằng thẻ <a> thuần, bỏ hoàn toàn OnClick của MudBlazor.
                   Thêm text-decoration: none để chữ không bị gạch chân, color: inherit để giữ nguyên màu palette.
                *@
                <a href="@currentWidget.Href" style="text-decoration: none; color: inherit; display: block; height: 100%;">

                    <MudPaper Elevation="0"
                              Class="action-card d-flex flex-row align-center"
                              Style="@($"border-left: 4px solid {currentWidget.AccentColor}; height: 100%;")">

                        @* Khối bọc Icon căn giữa trái *@
                        <div class="pr-4 d-flex align-center" style="flex-shrink: 0; pointer-events: none;">
                            <MudIcon Icon="@currentWidget.Icon"
                                     Style="@($"font-size: 32px; color: {currentWidget.AccentColor};")" />
                        </div>

                        @* Khối Text căn trái *@
                        <div style="text-align: left; flex-grow: 1; pointer-events: none;">
                            <MudText Style="font-size: 14px; font-weight: 600; line-height: 1.35;
                                                color: var(--mud-palette-text-primary);">
                                @currentWidget.Label
                            </MudText>
                            @if (!string.IsNullOrEmpty(currentWidget.SubLabel))
                            {
                                <MudText Typo="Typo.caption" Color="Color.Secondary"
                                         Style="font-size: 11px; margin-top: 2px; display: block; opacity: 0.8;">
                                    @currentWidget.SubLabel
                                </MudText>
                            }
                        </div>
                    </MudPaper>

                </a>
            </MudItem>
        }
    </MudGrid>

    @* ===== ĐƠN GẦN ĐÂY ===== *@
    <MudText Typo="Typo.overline" Color="Color.Secondary" Class="mb-3 d-block"
             Style="letter-spacing: 0.1em; font-weight: 600;">
        ĐƠN GẦN ĐÂY
    </MudText>

    @if (RecentRequests == null)
    {
        <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="140px"
                     Style="border-radius: 12px;" />
    }
    else if (!RecentRequests.Any())
    {
        <MudPaper Elevation="0" Class="pa-6 d-flex flex-column align-center"
                  Style="border: 1.5px dashed #bdbdbd; border-radius: 12px;">
            <MudIcon Icon="@Icons.Material.Outlined.Inbox"
                     Style="font-size: 48px; color: #bdbdbd;" />
            <MudText Color="Color.Secondary" Class="mt-2 mb-3">
                Bạn chưa có đơn nào. Hãy tạo đơn mới!
            </MudText>
            <MudButton Variant="Variant.Filled" Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Add"
                       OnClick="@(() => Nav.NavigateTo("/leave/create"))">
                Tạo đơn nghỉ phép
            </MudButton>
        </MudPaper>
    }
    else
    {
        <MudPaper Elevation="0"
                  Style="border: 0.5px solid #e0e0e0; border-radius: 12px; overflow: hidden; background: #ffffff;">
            @foreach (var (req, index) in RecentRequests.Select((r, i) => (r, i)))
            {
                <MudStack Row="true" AlignItems="AlignItems.Center"
                          Justify="Justify.SpaceBetween"
                          Class="pa-3 px-4"
                          Style="@($"cursor: pointer; transition: background 0.12s; {(index < RecentRequests.Count - 1 ? "border-bottom: 0.5px solid #f5f5f5;" : "")}")"
                          OnClick="@(() => Nav.NavigateTo("/leave/history"))">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
                        <MudIcon Icon="@Icons.Material.Filled.EventNote"
                                 Style="@($"font-size: 20px; color: {GetStatusColor(req.Status)};")" />
                        <div>
                            <MudText Style="font-size: 13px; font-weight: 600;">
                                @req.FromDate.ToString("dd/MM/yyyy") → @req.ToDate.ToString("dd/MM/yyyy")
                            </MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                @(req.ApproverName != null ? $"Người duyệt: {req.ApproverName}" : "Đang xử lý")
                            </MudText>
                        </div>
                    </MudStack>

                    <MudChip T="string"
                             Size="Size.Small"
                             Style="@GetStatusStyle(req.Status)"
                             Label="true"
                             Text="@LeaveStatus.GetDisplayName(req.Status)" />
                </MudStack>
            }

            <div style="border-top: 0.5px solid #f0f0f0; padding: 8px; text-align: center;">
                <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small"
                           EndIcon="@Icons.Material.Filled.ArrowForward"
                           OnClick="@(() => Nav.NavigateTo("/leave/history"))">
                    Xem tất cả lịch sử
                </MudButton>
            </div>
        </MudPaper>
    }

</div>

@code {
    [Parameter] public LeaveBalanceDto? Balance { get; set; }
    [Parameter] public List<RecentLeaveRequestDto>? RecentRequests { get; set; }

    private class QuickActionWidget
    {
        public string Label { get; set; } = "";
        public string? SubLabel { get; set; }
        public string Icon { get; set; } = "";
        public string Href { get; set; } = "";
        public string AccentColor { get; set; } = "#1E88E5";
    }

    private List<QuickActionWidget> _quickActions = new()
    {
        new() { Label = "Đăng ký nghỉ phép", SubLabel = "Phép năm, nghỉ ốm...", Icon = Icons.Material.Filled.EventAvailable, Href = "/leave/create", AccentColor = "#1E88E5" },
        new() { Label = "Đăng ký làm thêm", SubLabel = "OT ngoài giờ", Icon = Icons.Material.Filled.AccessTime, Href = "/ot/create", AccentColor = "#2E7D32" },
        new() { Label = "Đăng ký công tác", SubLabel = "Đi tỉnh, xuất sai địa điểm", Icon = Icons.Material.Filled.FlightTakeoff, Href = "/business-trip/create", AccentColor = "#F57C00" },
        new() { Label = "Điều chỉnh công", SubLabel = "Quên chấm công", Icon = Icons.Material.Filled.EditCalendar, Href = "/attendance-adjust/create", AccentColor = "#7B1FA2" },
        new() { Label = "Lịch sử của tôi", SubLabel = "Tất cả đơn đã gửi", Icon = Icons.Material.Filled.History, Href = "/leave/history", AccentColor = "#00838F" },
        new() { Label = "Hồ sơ cá nhân", SubLabel = "Email, ảnh đại diện", Icon = Icons.Material.Filled.ManageAccounts, Href = "/profile", AccentColor = "#546E7A" }
    };

    private string GetGreeting()
    {
        var hour = DateTime.Now.Hour;
        return hour < 12 ? "Chào buổi sáng" : hour < 18 ? "Chào buổi chiều" : "Chào buổi tối";
    }

    private string GetStatusColor(string status) => status switch
    {
        "Approved" => "#2E7D32",
        "Rejected" => "#C62828",
        "ApprovedLv1" => "#1565C0",
        "ApprovedLv2" => "#00695C",
        _ => "#E65100"
    };

    private string GetStatusStyle(string status) => status switch
    {
        "Approved" => "background:#E8F5E9; color:#2E7D32; border:none;",
        "Rejected" => "background:#FFEBEE; color:#C62828; border:none;",
        "Pending" => "background:#FFF3E0; color:#E65100; border:none;",
        "ApprovedLv1" => "background:#E3F2FD; color:#1565C0; border:none;",
        "ApprovedLv2" => "background:#E0F7FA; color:#00695C; border:none;",
        _ => "background:#F5F5F5; color:#616161; border:none;"
    };
}