<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\FVN_REGISTER.Core\FVN_REGISTER.Core.csproj" />
  </ItemGroup>

  <!-- Shared contract DTOs live in FVN_REGISTER.Contract; this project is the canonical Contract assembly consumed by Application/Infrastructure. -->
  <ItemGroup>
    <Compile Include="..\FVN_REGISTER.Contract\Dtos\**\*.cs"
             LinkBase="Dtos" />
    <Compile Include="..\FVN_REGISTER.Contract\Requests\**\*.cs"
             LinkBase="Requests" />
    <Compile Include="..\FVN_REGISTER.Contract\Responses\**\*.cs"
             LinkBase="Responses" />
    <Compile Include="..\FVN_REGISTER.Contract\Utils\**\*.cs"
             LinkBase="Utils" />
  </ItemGroup>
</Project>
